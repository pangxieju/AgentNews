    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261115.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.158.0"
  }
