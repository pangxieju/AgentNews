{
  "name": "@agentnews/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
