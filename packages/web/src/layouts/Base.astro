---
import { loadLatestScores } from '../lib/data';
const data = loadLatestScores();
const rows = data?.rows ?? [];
const hasData = rows.length > 0;
const date = data?.date ?? '暂无数据';
const {
  pageTitle = 'AI Agent 排行榜',
  description = `AI Agent 排行榜：${rows.length} 个 agent 的开源/闭源双榜，按 star、安装量、活跃度跨生态归一化排名。数据截至 ${date}。`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://agentnews.example.com').href;
const path = Astro.url.pathname;

const NAV = [
  { href: '/', label: '双榜' },
  { href: '/top/open/all/month/', label: '榜单' },
  { href: '/rising/', label: '新秀' },
  { href: '/activity/', label: '动态' },
  { href: '/security/', label: '安全' },
  { href: '/archive/', label: '归档' },
  { href: '/changelog/', label: '变更' },
  { href: '/about/', label: '口径' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} · AgentNews</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${pageTitle} · AgentNews`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('an-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <script is:inline>
      // 图标降级：静态页面（未 hydrate）也要生效，所以在 head 注册捕获阶段监听。
      // 顺序：主图标 → 备选 favicon → 移除 img（露出首字母色块），不留碎图。
      document.addEventListener(
        'error',
        function (e) {
          var el = e.target;
          if (!el || el.tagName !== 'IMG') return;
          var fb = el.getAttribute('data-fallback');
          if (fb) {
            el.setAttribute('data-fallback', '');
            el.src = fb;
            return;
          }
          if (el.closest('.agent-icon')) el.remove();
        },
        true,
      );
    </script>
    <style is:global>
      /* ── GitHub Primer 风格设计令牌 ───────────────────────────── */
      :root {
        color-scheme: light;
        --gh-canvas: #ffffff;
        --gh-canvas-subtle: #f6f8fa;
        --gh-canvas-inset: #f6f8fa;
        --gh-border: #d0d7de;
        --gh-border-muted: #d8dee4;
        --gh-fg: #1f2328;
        --gh-fg-muted: #656d76;
        --gh-fg-subtle: #6e7781;
        --gh-accent: #0969da;
        --gh-accent-subtle: #ddf4ff;
        --gh-success: #1a7f37;
        --gh-success-subtle: #dafbe1;
        --gh-attention: #9a6700;
        --gh-attention-subtle: #fff8c5;
        --gh-danger: #cf222e;
        --gh-danger-subtle: #ffebe9;
        --gh-neutral-subtle: rgba(175, 184, 193, 0.2);
        --gh-btn-bg: #f6f8fa;
        --gh-btn-hover: #eef1f4;
        --gh-header-bg: #f6f8fa;
        --gh-shadow: 0 1px 0 rgba(31, 35, 40, 0.04);
        --gh-underline: #fd8c73;
        --gh-primary: #1f883d;
        --gh-primary-hover: #1a7f37;
        --gh-primary-border: rgba(31, 35, 40, 0.15);
        --gh-scroll-thumb: rgba(31, 35, 40, 0.2);

        /* 兼容旧变量名 */
        --bg: var(--gh-canvas);
        --card: var(--gh-canvas);
        --border: var(--gh-border);
        --text: var(--gh-fg);
        --muted: var(--gh-fg-muted);
        --accent: var(--gh-accent);
        --green: var(--gh-success);
        --red: var(--gh-danger);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --gh-canvas: #0d1117;
          --gh-canvas-subtle: #161b22;
          --gh-canvas-inset: #010409;
          --gh-border: #30363d;
          --gh-border-muted: #21262d;
          --gh-fg: #e6edf3;
          --gh-fg-muted: #8b949e;
          --gh-fg-subtle: #6e7681;
          --gh-accent: #58a6ff;
          --gh-accent-subtle: #121d2f;
          --gh-success: #3fb950;
          --gh-success-subtle: #12261e;
          --gh-attention: #d29922;
          --gh-attention-subtle: #272115;
          --gh-danger: #f85149;
          --gh-danger-subtle: #25171c;
          --gh-neutral-subtle: rgba(110, 118, 129, 0.4);
          --gh-btn-bg: #21262d;
          --gh-btn-hover: #30363d;
          --gh-header-bg: #010409;
          --gh-shadow: 0 1px 0 rgba(1, 4, 9, 0.4);
          --gh-underline: #f78166;
          --gh-primary: #238636;
          --gh-primary-hover: #2ea043;
          --gh-primary-border: rgba(240, 246, 252, 0.1);
          --gh-scroll-thumb: rgba(110, 118, 129, 0.4);
        }
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --gh-canvas: #0d1117;
        --gh-canvas-subtle: #161b22;
        --gh-canvas-inset: #010409;
        --gh-border: #30363d;
        --gh-border-muted: #21262d;
        --gh-fg: #e6edf3;
        --gh-fg-muted: #8b949e;
        --gh-fg-subtle: #6e7681;
        --gh-accent: #58a6ff;
        --gh-accent-subtle: #121d2f;
        --gh-success: #3fb950;
        --gh-success-subtle: #12261e;
        --gh-attention: #d29922;
        --gh-attention-subtle: #272115;
        --gh-danger: #f85149;
        --gh-danger-subtle: #25171c;
        --gh-neutral-subtle: rgba(110, 118, 129, 0.4);
        --gh-btn-bg: #21262d;
        --gh-btn-hover: #30363d;
        --gh-header-bg: #010409;
        --gh-shadow: 0 1px 0 rgba(1, 4, 9, 0.4);
        --gh-underline: #f78166;
        --gh-primary: #238636;
        --gh-primary-hover: #2ea043;
        --gh-primary-border: rgba(240, 246, 252, 0.1);
        --gh-scroll-thumb: rgba(110, 118, 129, 0.4);
      }

      /* ── 基础 ─────────────────────────────────────────────── */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        background: var(--gh-canvas);
        color: var(--gh-fg);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial,
          'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-size: 14px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--gh-accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      code, .mono { font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace; }
      code { padding: 0.2em 0.4em; font-size: 85%; background: var(--gh-neutral-subtle); border-radius: 6px; }
      h1 { font-size: 24px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }
      h2 { font-size: 16px; font-weight: 600; }
      h3 { font-size: 14px; font-weight: 600; }
      p { margin: 0; }
      .muted { color: var(--gh-fg-muted); }
      .subtle { color: var(--gh-fg-subtle); }
      .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
      .stack > * + * { margin-top: 16px; }
      .row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .spread { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 8px; top: 8px; z-index: 100; background: var(--gh-canvas); padding: 8px; border-radius: 6px; }

      /* ── 顶部导航（GitHub header） ─────────────────────────── */
      .gh-header {
        background: var(--gh-header-bg);
        border-bottom: 1px solid var(--gh-border);
        box-shadow: var(--gh-shadow);
        position: sticky;
        top: 0;
        z-index: 30;
      }
      .gh-header-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        min-height: 62px;
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .gh-brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--gh-fg);
        font-size: 15px;
        font-weight: 600;
        flex: none;
      }
      .gh-brand:hover { text-decoration: none; opacity: 0.85; }
      .gh-brand svg { flex: none; }
      .gh-nav {
        display: flex;
        align-items: stretch;
        gap: 2px;
        flex: 1;
        min-width: 0;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .gh-nav::-webkit-scrollbar { display: none; }
      .gh-nav a {
        display: inline-flex;
        align-items: center;
        padding: 0 12px;
        color: var(--gh-fg-muted);
        font-size: 14px;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        white-space: nowrap;
        transition: color 0.12s, border-color 0.12s;
      }
      .gh-nav a:hover { color: var(--gh-fg); text-decoration: none; border-bottom-color: var(--gh-border); }
      .gh-nav a[aria-current='page'] {
        color: var(--gh-fg);
        font-weight: 600;
        border-bottom-color: var(--gh-underline);
      }
      .gh-theme-btn {
        flex: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: 1px solid var(--gh-border);
        background: var(--gh-btn-bg);
        color: var(--gh-fg-muted);
        cursor: pointer;
      }
      .gh-theme-btn:hover { background: var(--gh-btn-hover); color: var(--gh-fg); }
      .gh-theme-btn .icon-sun { display: none; }
      .gh-theme-btn .icon-moon { display: block; }
      :root[data-theme='dark'] .gh-theme-btn .icon-sun { display: block; }
      :root[data-theme='dark'] .gh-theme-btn .icon-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .gh-theme-btn .icon-sun { display: block; }
        :root:not([data-theme='light']) .gh-theme-btn .icon-moon { display: none; }
      }

      /* ── 页面骨架 ─────────────────────────────────────────── */
      main { padding: 24px 0 48px; }
      .page-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
      .page-head h1 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .crumbs { display: flex; align-items: center; gap: 6px; font-size: 14px; color: var(--gh-fg-muted); margin-bottom: 8px; }
      .crumbs a { color: var(--gh-accent); }
      .section { margin-top: 32px; }
      .section-title { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
      .section-title h2 { font-size: 16px; }

      /* ── Box / Card（GitHub 容器） ─────────────────────────── */
      .box {
        background: var(--gh-canvas);
        border: 1px solid var(--gh-border);
        border-radius: 6px;
        overflow: hidden;
      }
      .box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 16px;
        background: var(--gh-canvas-subtle);
        border-bottom: 1px solid var(--gh-border);
        font-size: 14px;
        font-weight: 600;
      }
      .box-body { padding: 16px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-top: 16px; }
      .card {
        background: var(--gh-canvas);
        border: 1px solid var(--gh-border);
        border-radius: 6px;
        padding: 16px;
      }
      .card h2 { font-size: 14px; color: var(--gh-fg-muted); font-weight: 500; }
      .card .num { font-size: 28px; font-weight: 600; line-height: 1.2; color: var(--gh-fg); margin-top: 4px; }
      .card .detail { font-size: 12px; color: var(--gh-fg-muted); margin-top: 4px; }

      /* ── 表格 ─────────────────────────────────────────────── */
      .table-wrap { width: 100%; overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { text-align: left; padding: 8px 12px; vertical-align: middle; }
      th {
        background: var(--gh-canvas-subtle);
        color: var(--gh-fg-muted);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        border-top: 1px solid var(--gh-border);
        border-bottom: 1px solid var(--gh-border);
      }
      td { border-bottom: 1px solid var(--gh-border-muted); }
      tr:last-child td { border-bottom: 0; }
      tbody tr:hover td { background: var(--gh-canvas-subtle); }
      th:first-child, td:first-child { padding-left: 16px; }
      th:last-child, td:last-child { padding-right: 16px; }
      td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
      .pos { color: var(--gh-fg-muted); width: 3rem; font-variant-numeric: tabular-nums; }
      .up { color: var(--gh-success); }
      .down { color: var(--gh-danger); }

      /* ── 徽标 / 标签（GitHub Label） ───────────────────────── */
      .badge {
        display: inline-flex;
        align-items: center;
        height: 20px;
        padding: 0 7px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 500;
        line-height: 18px;
        border: 1px solid transparent;
        white-space: nowrap;
        vertical-align: middle;
      }
      .b-open { color: var(--gh-success); background: var(--gh-success-subtle); border-color: color-mix(in srgb, var(--gh-success) 30%, transparent); }
      .b-semi { color: var(--gh-attention); background: var(--gh-attention-subtle); border-color: color-mix(in srgb, var(--gh-attention) 30%, transparent); }
      .b-closed { color: var(--gh-danger); background: var(--gh-danger-subtle); border-color: color-mix(in srgb, var(--gh-danger) 30%, transparent); }
      .counter {
        display: inline-block;
        min-width: 20px;
        padding: 0 6px;
        font-size: 12px;
        font-weight: 500;
        line-height: 18px;
        text-align: center;
        color: var(--gh-fg);
        background: var(--gh-neutral-subtle);
        border-radius: 999px;
      }

      /* ── 按钮 ─────────────────────────────────────────────── */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 16px;
        font-size: 14px;
        font-weight: 500;
        line-height: 20px;
        border-radius: 6px;
        border: 1px solid var(--gh-border);
        background: var(--gh-btn-bg);
        color: var(--gh-fg);
        cursor: pointer;
        white-space: nowrap;
      }
      .btn:hover { background: var(--gh-btn-hover); text-decoration: none; }
      .btn-primary {
        background: var(--gh-primary);
        border-color: var(--gh-primary-border);
        color: #fff;
      }
      .btn-primary:hover { background: var(--gh-primary-hover); }
      .btn-sm { padding: 3px 12px; font-size: 12px; }

      /* ── 下划线标签页 / 分段控件 ───────────────────────────── */
      .tabs {
        display: flex;
        gap: 4px;
        overflow-x: auto;
        scrollbar-width: none;
        border-bottom: 1px solid var(--gh-border);
        margin-bottom: 16px;
      }
      .tabs::-webkit-scrollbar { display: none; }
      .tab {
        padding: 8px 12px;
        margin-bottom: -1px;
        border-bottom: 2px solid transparent;
        color: var(--gh-fg-muted);
        font-size: 14px;
        white-space: nowrap;
      }
      .tab:hover { color: var(--gh-fg); text-decoration: none; border-bottom-color: var(--gh-border); }
      .tab[aria-current='page'] { color: var(--gh-fg); font-weight: 600; border-bottom-color: var(--gh-underline); }
      .segmented {
        display: inline-flex;
        border: 1px solid var(--gh-border);
        border-radius: 6px;
        overflow: hidden;
        background: var(--gh-canvas);
      }
      .segmented a {
        padding: 5px 12px;
        font-size: 12px;
        color: var(--gh-fg);
        border-right: 1px solid var(--gh-border);
      }
      .segmented a:last-child { border-right: 0; }
      .segmented a:hover { background: var(--gh-btn-hover); text-decoration: none; }
      .segmented a[aria-current='page'] {
        background: var(--gh-accent-subtle);
        color: var(--gh-accent);
        font-weight: 600;
      }

      /* ── 提示条（GitHub flash） ────────────────────────────── */
      .warn {
        background: var(--gh-attention-subtle);
        border: 1px solid color-mix(in srgb, var(--gh-attention) 40%, transparent);
        color: var(--gh-fg);
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 14px;
      }
      .warn strong { color: var(--gh-attention); }
      /* 中性提示：说明性内容用这个，别用黄色告警（看起来像出错） */
      .notice {
        background: var(--gh-canvas-subtle);
        border: 1px solid var(--gh-border);
        color: var(--gh-fg-muted);
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 13px;
      }
      .notice strong { color: var(--gh-fg); }

      /* ── Agent 图标 ───────────────────────────────────────── */
      .agent-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: var(--icon-size, 32px);
        height: var(--icon-size, 32px);
        border-radius: 6px;
        border: 1px solid var(--gh-border);
        background: hsl(var(--icon-hue, 210) 60% 90%);
        color: hsl(var(--icon-hue, 210) 55% 30%);
        font-size: calc(var(--icon-size, 32px) * 0.42);
        font-weight: 700;
        line-height: 1;
        overflow: hidden;
        text-transform: uppercase;
        user-select: none;
      }
      .agent-icon-letter { position: relative; z-index: 1; }
      .agent-icon img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: var(--gh-canvas);
        z-index: 2;
      }
      :root[data-theme='dark'] .agent-icon {
        background: hsl(var(--icon-hue, 210) 32% 24%);
        color: hsl(var(--icon-hue, 210) 70% 76%);
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .agent-icon {
          background: hsl(var(--icon-hue, 210) 32% 24%);
          color: hsl(var(--icon-hue, 210) 70% 76%);
        }
      }
      .agent-cell { display: flex; align-items: center; gap: 10px; min-width: 0; }
      .agent-cell .name { font-weight: 600; color: var(--gh-fg); }
      .agent-cell .name:hover { color: var(--gh-accent); }
      .agent-cell .tags { display: inline-flex; gap: 4px; flex-wrap: wrap; align-items: center; }

      /* ── 榜单交互（RankBoard island） ─────────────────────── */
      .rank-toolbar {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 16px;
      }
      .rank-toolbar-count { font-size: 12px; margin-left: auto; }
      .rank-hint {
        font-size: 13px;
        color: var(--gh-fg-muted);
        margin-bottom: 16px;
        padding: 8px 12px;
        border-left: 3px solid var(--gh-border);
        background: var(--gh-canvas-subtle);
        border-radius: 0 6px 6px 0;
      }
      .rank-empty { margin-bottom: 16px; }

      /* ── 首页选型入口 ─────────────────────────────────────── */
      .picker-search {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border: 1px solid var(--gh-border);
        border-radius: 6px;
        background: var(--gh-canvas);
      }
      .picker-search:focus-within {
        border-color: var(--gh-accent);
        box-shadow: 0 0 0 3px var(--gh-accent-subtle);
      }
      .picker-search svg { color: var(--gh-fg-muted); flex: none; }
      .picker-input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: none;
        color: var(--gh-fg);
        font-size: 14px;
        line-height: 20px;
        outline: none;
        font-family: inherit;
      }
      .picker-input::-webkit-search-cancel-button { display: none; }
      .picker-clear {
        border: 0;
        background: none;
        color: var(--gh-fg-muted);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
        padding: 0 4px;
      }
      .picker-clear:hover { color: var(--gh-fg); }
      .picker-filters {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
      }
      .chips { display: flex; flex-wrap: wrap; gap: 6px; }
      .chip {
        padding: 2px 10px;
        border-radius: 999px;
        border: 1px solid var(--gh-border);
        background: var(--gh-canvas);
        color: var(--gh-fg);
        font-size: 12px;
        line-height: 20px;
        font-family: inherit;
        cursor: pointer;
      }
      .chip:hover { background: var(--gh-btn-hover); }
      .chip[aria-pressed='true'] {
        background: var(--gh-accent-subtle);
        border-color: var(--gh-accent);
        color: var(--gh-accent);
        font-weight: 600;
      }
      .picker-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        margin: 12px 0 8px;
        font-size: 12px;
      }
      .picker-list { list-style: none; border-top: 1px solid var(--gh-border-muted); }
      .picker-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 4px;
        color: var(--gh-fg);
        border-bottom: 1px solid var(--gh-border-muted);
      }
      .picker-list li:last-child .picker-item { border-bottom: 0; }
      .picker-item:hover { background: var(--gh-canvas-subtle); text-decoration: none; }
      .picker-item-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
      .picker-item-main .name { font-weight: 600; }
      .picker-item-meta {
        font-size: 12px;
        color: var(--gh-fg-muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .picker-item-score {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        min-width: 3rem;
        text-align: right;
      }
      .picker-empty { padding: 12px 4px; font-size: 13px; }
      .link-btn {
        border: 0;
        background: none;
        color: var(--gh-accent);
        cursor: pointer;
        padding: 0 2px;
        font: inherit;
      }
      .link-btn:hover { text-decoration: underline; }
      th.sortable { padding: 0; }
      th.sortable button {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: 100%;
        justify-content: flex-end;
        padding: 8px 12px;
        font: inherit;
        font-size: 12px;
        font-weight: 600;
        color: inherit;
        background: none;
        border: 0;
        cursor: pointer;
      }
      th.sortable button:hover { color: var(--gh-fg); }
      .sort-caret { font-size: 8px; line-height: 1; opacity: 0.75; min-width: 8px; }
      .rank-row { cursor: pointer; }
      .rank-row:hover td { background: var(--gh-canvas-subtle); }

      /* 移动端卡片列表：窄屏用卡片替代 9 列表格 */
      .rank-cards { display: none; list-style: none; }
      .rank-card { border-bottom: 1px solid var(--gh-border-muted); }
      .rank-card:last-child { border-bottom: 0; }
      .rank-card-main {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 16px;
        color: inherit;
        text-decoration: none;
      }
      .rank-card-main:hover { text-decoration: none; background: var(--gh-canvas-subtle); }
      .rank-card-name { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
      .rank-card-name .name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rank-card-score { font-variant-numeric: tabular-nums; font-weight: 600; font-size: 15px; }
      .rank-card-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        padding: 0 16px 10px 58px;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
        color: var(--gh-fg);
      }
      .rank-card-stats em {
        font-style: normal;
        color: var(--gh-fg-muted);
        margin-right: 4px;
      }

      /* ── 图表（服务端渲染，PC/移动端同一套） ─────────────── */
      .bar-chart { list-style: none; display: grid; gap: 10px; }
      .bar-row {
        display: grid;
        grid-template-columns: minmax(0, 8em) 1fr 3.6em;
        align-items: center;
        gap: 12px;
        font-size: 13px;
      }
      .bar-label {
        color: var(--gh-fg);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .bar-label a { color: inherit; }
      .bar-track {
        height: 8px;
        border-radius: 999px;
        background: var(--gh-neutral-subtle);
        overflow: hidden;
      }
      .bar-fill {
        display: block;
        height: 100%;
        border-radius: 999px;
        background: var(--gh-accent);
        transition: width 0.3s ease;
      }
      .bar-fill.tone-default,
      .bar-fill.tone-accent { background: var(--gh-accent); }
      .bar-fill.tone-success { background: var(--gh-success); }
      .bar-fill.tone-attention { background: var(--gh-attention); }
      .bar-fill.tone-danger { background: var(--gh-danger); }
      .bar-value {
        text-align: right;
        color: var(--gh-fg-muted);
        font-variant-numeric: tabular-nums;
      }

      .line-chart { margin: 0; }
      .lc-grid-wrap {
        display: grid;
        grid-template-columns: 3.4em 1fr;
        height: var(--lc-height, 200px);
      }
      .lc-yaxis { position: relative; font-size: 11px; color: var(--gh-fg-muted); }
      .lc-yaxis span {
        position: absolute;
        right: 8px;
        transform: translateY(-50%);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      .lc-canvas {
        position: relative;
        border-left: 1px solid var(--gh-border-muted);
        border-bottom: 1px solid var(--gh-border-muted);
      }
      .lc-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
      .lc-grid { stroke: var(--gh-border-muted); stroke-width: 1; stroke-dasharray: 2 4; }
      .lc-line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
      .lc-line.tone-default,
      .lc-line.tone-accent { stroke: var(--gh-accent); }
      .lc-line.tone-success { stroke: var(--gh-success); }
      .lc-line.tone-attention { stroke: var(--gh-attention); }
      .lc-line.tone-danger { stroke: var(--gh-danger); }
      .lc-area { stroke: none; opacity: 0.12; }
      .lc-area.tone-default,
      .lc-area.tone-accent { fill: var(--gh-accent); }
      .lc-area.tone-success { fill: var(--gh-success); }
      .lc-area.tone-attention { fill: var(--gh-attention); }
      .lc-area.tone-danger { fill: var(--gh-danger); }
      .lc-dots { position: absolute; inset: 0; }
      .lc-dot {
        position: absolute;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background: var(--gh-accent);
        box-shadow: 0 0 0 2px var(--gh-canvas);
      }
      .lc-dot.tone-success { background: var(--gh-success); }
      .lc-dot.tone-attention { background: var(--gh-attention); }
      .lc-dot.tone-danger { background: var(--gh-danger); }
      .lc-xaxis { position: relative; height: 16px; margin: 6px 0 0 3.4em; font-size: 11px; color: var(--gh-fg-muted); }
      .lc-xaxis span {
        position: absolute;
        transform: translateX(-50%);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .lc-xaxis span.is-first { transform: none; }
      .lc-xaxis span.is-last { transform: translateX(-100%); }
      .lc-legend {
        list-style: none;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin: 10px 0 0 3.4em;
        font-size: 12px;
        color: var(--gh-fg-muted);
      }
      .lc-legend li { display: inline-flex; align-items: center; gap: 6px; }
      .pkg { overflow-wrap: anywhere; word-break: break-word; }
      .swatch { width: 10px; height: 10px; border-radius: 2px; display: inline-block; background: var(--gh-accent); }
      .swatch.tone-success { background: var(--gh-success); }
      .swatch.tone-attention { background: var(--gh-attention); }
      .swatch.tone-danger { background: var(--gh-danger); }
      .chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }

      /* ── 页脚 ─────────────────────────────────────────────── */
      .gh-footer {
        border-top: 1px solid var(--gh-border);
        padding: 24px 0 40px;
        font-size: 12px;
        color: var(--gh-fg-muted);
      }
      .gh-footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }
      .gh-footer a { color: var(--gh-fg-muted); }
      .gh-footer a:hover { color: var(--gh-accent); }
      .gh-footer nav { display: flex; gap: 16px; flex-wrap: wrap; }

      @media (max-width: 768px) {
        .container, .gh-header-inner, .gh-footer-inner { padding-left: 16px; padding-right: 16px; }
        h1 { font-size: 20px; }
        th, td { padding: 8px 10px; }
        .gh-brand span { display: none; }
        /* 窄屏：表格换成卡片，避免横向滚动找列 */
        .rank-table { display: none; }
        .rank-cards { display: block; }
        .rank-toolbar { gap: 10px; }
        .rank-toolbar-count { margin-left: 0; width: 100%; }
        .tabs { margin-bottom: 12px; }
        .card .num { font-size: 24px; }
        /* 窄屏隐藏低优先级列，避免表格横向滚动 */
        .hide-sm { display: none; }
        /* 包名等长字符串在窄屏断行，别把表格撑宽 */
        .pkg { max-width: 8.5em; }
        /* 小卡片两列排布，避免移动端一屏只有一张卡 */
        .grid.grid-tight { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
        .grid.grid-tight .card { padding: 12px; }
        .grid.grid-tight .card .num { font-size: 20px; }
        .bar-row { grid-template-columns: minmax(0, 5.6em) 1fr 3em; gap: 8px; font-size: 12px; }
        .lc-grid-wrap { height: 170px; }
        .lc-xaxis span { font-size: 10px; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header class="gh-header">
      <div class="gh-header-inner">
        <a class="gh-brand" href="/" aria-label="AgentNews 首页">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="0.75" y="0.75" width="22.5" height="22.5" rx="5.25" fill="currentColor" opacity="0.14" />
            <path d="M7 8l3.4 3.4L7 14.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M12.6 15.2H17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span>AgentNews</span>
        </a>
        <nav class="gh-nav" aria-label="主导航">
          {NAV.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <button class="gh-theme-btn" id="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题">
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M9.6 1.1a6.9 6.9 0 1 0 5.3 10.5A7.4 7.4 0 0 1 9.6 1.1Z" />
          </svg>
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 11.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7ZM8 0a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 0Zm0 13.5a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 13.5ZM2.3 2.3a.75.75 0 0 1 1.06 0l.7.71a.75.75 0 0 1-1.06 1.06l-.7-.7a.75.75 0 0 1 0-1.07Zm9.64 9.64a.75.75 0 0 1 1.06 0l.7.7a.75.75 0 1 1-1.06 1.07l-.7-.71a.75.75 0 0 1 0-1.06ZM0 8a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1A.75.75 0 0 1 0 8Zm13.5 0a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1a.75.75 0 0 1-.75-.75ZM3 11.94a.75.75 0 0 1 0 1.06l-.7.7a.75.75 0 1 1-1.07-1.06l.71-.7a.75.75 0 0 1 1.06 0Zm9.64-9.64a.75.75 0 0 1 0 1.06l-.7.7A.75.75 0 0 1 10.88 3l.7-.7a.75.75 0 0 1 1.06 0Z" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <div class="container">
        {hasData ? (
          <slot />
        ) : (
          <div class="page-head">
            <h1>数据积累中</h1>
            <p class="muted">首次运行后 24 小时内自动生成快照。当前无评分数据。</p>
          </div>
        )}
      </div>
    </main>

    <footer class="gh-footer">
      <div class="gh-footer-inner">
        <span>© {new Date().getFullYear()} AgentNews · 数据更新于 <strong>{date}</strong> · 综合分是观点，非客观事实</span>
        <nav aria-label="页脚导航">
          <a href="/about/">方法与口径</a>
          <a href="/changelog/">变更记录</a>
          <a href="/archive/">数据归档</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('an-theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
