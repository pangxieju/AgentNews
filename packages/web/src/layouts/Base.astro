---
import { loadLatestScores } from '../lib/data';
const data = loadLatestScores();
const rows = data?.rows ?? [];
const hasData = rows.length > 0;
const date = data?.date ?? '暂无数据';
const {
  pageTitle = 'AI Agent 排行榜',
  description = `AI Agent 排行榜：${rows.length} 个 agent 的开源/闭源双榜，按 star、安装量、活跃度跨生态归一化排名。数据截至 ${date}。`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://agentnews.example.com').href;
const path = Astro.url.pathname;

const NAV = [
  { href: '/', label: '双榜' },
  { href: '/top/open/all/month/', label: '榜单' },
  { href: '/rising/', label: '新秀' },
  { href: '/activity/', label: '动态' },
  { href: '/security/', label: '安全' },
  { href: '/archive/', label: '归档' },
  { href: '/changelog/', label: '变更' },
  { href: '/about/', label: '口径' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
const openCount = rows.filter((r) => r.oss_bucket !== 'closed').length;
const closedCount = rows.length - openCount;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} · AgentNews</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${pageTitle} · AgentNews`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('an-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <script is:inline>
      // 图标降级：静态页（未 hydrate）也要生效，在 head 用捕获阶段监听
      document.addEventListener(
        'error',
        function (e) {
          var el = e.target;
          if (!el || el.tagName !== 'IMG') return;
          var fb = el.getAttribute('data-fallback');
          if (fb) {
            el.setAttribute('data-fallback', '');
            el.src = fb;
            return;
          }
          if (el.closest('.agent-icon')) el.remove();
        },
        true,
      );
    </script>
    <style is:global>
      /* ═══════════════════════════════════════════════════════
         AgentNews — Data Editorial
         纸感底色 / 焦橙信号色 / 直角发丝线 / 衬线序号 / 等宽数字
         ═══════════════════════════════════════════════════════ */
      :root {
        color-scheme: light;
        --paper: #f6f3ec;
        --paper-2: #fffdf8;
        --paper-3: #ede7db;
        --ink: #17130f;
        --ink-2: #4d453b;
        --ink-3: #8a7e6e;
        --line: #ddd4c4;
        --line-2: #c8bba5;
        --accent: #c2470d;
        --accent-ink: #fffaf4;
        --accent-2: #0d6b5f;
        --ok: #2f7d4f;
        --warn: #96660f;
        --bad: #b3261e;
        --hl: rgba(194, 71, 13, 0.07);

        --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial,
          'PingFang SC', 'Microsoft YaHei', sans-serif;
        --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia,
          'Times New Roman', serif;
        --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;

        /* 兼容旧变量名（页面里还有 var(--gh-*) 的写法） */
        --gh-canvas: var(--paper-2);
        --gh-canvas-subtle: var(--paper-3);
        --gh-canvas-inset: var(--paper);
        --gh-border: var(--line);
        --gh-border-muted: var(--line);
        --gh-fg: var(--ink);
        --gh-fg-muted: var(--ink-2);
        --gh-fg-subtle: var(--ink-3);
        --gh-accent: var(--accent);
        --gh-accent-subtle: var(--hl);
        --gh-success: var(--ok);
        --gh-success-subtle: rgba(47, 125, 79, 0.1);
        --gh-attention: var(--warn);
        --gh-attention-subtle: rgba(150, 102, 15, 0.1);
        --gh-danger: var(--bad);
        --gh-danger-subtle: rgba(179, 38, 30, 0.1);
        --gh-neutral-subtle: var(--paper-3);
        --gh-btn-bg: transparent;
        --gh-btn-hover: var(--paper-3);
        --gh-primary: var(--accent);
        --gh-primary-hover: #a53a09;
        --gh-primary-border: var(--accent);
        --gh-underline: var(--accent);
        --gh-scroll-thumb: var(--line-2);
        --bg: var(--paper);
        --card: var(--paper-2);
        --border: var(--line);
        --text: var(--ink);
        --muted: var(--ink-2);
        --accent-legacy: var(--accent);
        --green: var(--ok);
        --red: var(--bad);
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --paper: #100f0d;
        --paper-2: #171512;
        --paper-3: #1f1c18;
        --ink: #f4efe6;
        --ink-2: #b3a99b;
        --ink-3: #7d7466;
        --line: #2b2722;
        --line-2: #3a342c;
        --accent: #ff8f5a;
        --accent-ink: #1a120c;
        --accent-2: #63c9b4;
        --ok: #6fcf97;
        --warn: #e2b04a;
        --bad: #ff7a6b;
        --hl: rgba(255, 143, 90, 0.12);
        --gh-primary-hover: #ffa273;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --paper: #100f0d;
          --paper-2: #171512;
          --paper-3: #1f1c18;
          --ink: #f4efe6;
          --ink-2: #b3a99b;
          --ink-3: #7d7466;
          --line: #2b2722;
          --line-2: #3a342c;
          --accent: #ff8f5a;
          --accent-ink: #1a120c;
          --accent-2: #63c9b4;
          --ok: #6fcf97;
          --warn: #e2b04a;
          --bad: #ff7a6b;
          --hl: rgba(255, 143, 90, 0.12);
          --gh-primary-hover: #ffa273;
        }
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a { color: var(--ink); text-decoration: none; }
      a:hover { color: var(--accent); }
      code, .mono {
        font-family: var(--mono);
        font-variant-numeric: tabular-nums;
      }
      code {
        font-size: 0.86em;
        padding: 0.15em 0.35em;
        border: 1px solid var(--line);
        background: var(--paper-2);
        color: var(--ink-2);
      }

      /* ── 排版基元 ─────────────────────────────────────────── */
      h1, h2, h3 { font-family: var(--sans); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
      h1 { font-size: clamp(30px, 5.2vw, 44px); }
      h2 { font-size: 17px; letter-spacing: -0.01em; }
      h3 { font-size: 15px; }
      p { margin: 0; }
      .container { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
      .stack > * + * { margin-top: 20px; }
      .row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .spread { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .muted { color: var(--ink-2); }
      .subtle { color: var(--ink-3); }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 8px; top: 8px; z-index: 100; background: var(--paper-2); padding: 8px; border: 1px solid var(--line); }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--accent);
      }
      .eyebrow::before {
        content: '';
        width: 14px;
        height: 1px;
        background: var(--accent);
      }
      .lede { font-size: 15.5px; line-height: 1.7; color: var(--ink-2); max-width: 68ch; }
      .display { font-family: var(--sans); font-size: clamp(32px, 6vw, 58px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.05; }
      .display em { font-style: normal; color: var(--accent); }

      /* ── 报头 masthead ────────────────────────────────────── */
      .masthead {
        position: sticky;
        top: 0;
        z-index: 40;
        border-bottom: 1px solid var(--line-2);
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: saturate(140%) blur(12px);
        -webkit-backdrop-filter: saturate(140%) blur(12px);
      }
      .masthead-top {
        max-width: 1180px;
        margin: 0 auto;
        padding: 14px 32px 10px;
        display: flex;
        align-items: baseline;
        gap: 14px;
      }
      .wordmark {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        font-family: var(--serif);
        font-size: 22px;
        letter-spacing: -0.02em;
        color: var(--ink);
      }
      .wordmark:hover { color: var(--ink); text-decoration: none; }
      .wordmark .mark { color: var(--accent); font-size: 18px; line-height: 1; }
      .wordmark-tag {
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-3);
        border-left: 1px solid var(--line-2);
        padding-left: 12px;
      }
      .masthead-meta { margin-left: auto; display: flex; align-items: center; gap: 14px; }
      .snap {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
        white-space: nowrap;
      }
      .snap b { color: var(--ink-2); font-weight: 500; }
      .theme-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--line-2);
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
        border-radius: 0;
      }
      .theme-btn:hover { color: var(--ink); border-color: var(--ink-3); }
      .theme-btn .icon-sun { display: none; }
      .theme-btn .icon-moon { display: block; }
      :root[data-theme='dark'] .theme-btn .icon-sun { display: block; }
      :root[data-theme='dark'] .theme-btn .icon-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .theme-btn .icon-sun { display: block; }
        :root:not([data-theme='light']) .theme-btn .icon-moon { display: none; }
      }

      .masthead-nav {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 32px;
        display: flex;
        gap: 0;
        overflow-x: auto;
        scrollbar-width: none;
      }
      .masthead-nav::-webkit-scrollbar { display: none; }
      .masthead-nav a {
        display: inline-flex;
        align-items: baseline;
        gap: 6px;
        padding: 8px 14px 9px;
        border-bottom: 2px solid transparent;
        color: var(--ink-2);
        font-size: 13px;
        white-space: nowrap;
      }
      .masthead-nav a:first-child { padding-left: 0; }
      .masthead-nav a i {
        font-family: var(--mono);
        font-style: normal;
        font-size: 9px;
        color: var(--ink-3);
        letter-spacing: 0.08em;
      }
      .masthead-nav a:hover { color: var(--ink); text-decoration: none; border-bottom-color: var(--line-2); }
      .masthead-nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
      .masthead-nav a[aria-current='page'] i { color: var(--accent); }

      /* ── 页面骨架 ─────────────────────────────────────────── */
      main { padding: 40px 0 80px; }
      .page-head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
      .page-head h1 { margin-top: 2px; }
      .page-head .lede { max-width: 70ch; }
      .crumbs {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .crumbs a { color: var(--ink-3); }
      .crumbs a:hover { color: var(--accent); }
      .section { margin-top: 56px; }
      .section-title {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
        padding-bottom: 10px;
        margin-bottom: 18px;
        border-bottom: 1px solid var(--line-2);
      }
      .section-title h2 {
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ink);
      }
      .section-title .muted { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.06em; }

      /* ── 面板 / 卡片 ──────────────────────────────────────── */
      .box {
        background: var(--paper-2);
        border: 1px solid var(--line);
        border-radius: 0;
        overflow: hidden;
      }
      .box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 16px;
        border-bottom: 1px solid var(--line);
        background: transparent;
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-2);
      }
      .box-header .counter { letter-spacing: 0.04em; }
      .box-body { padding: 20px; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: 24px; }
      .grid.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      @media (max-width: 980px) { .grid.grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      .grid > * { background: var(--paper-2); }
      .grid.grid-tight { margin-top: 0; }
      .card {
        background: var(--paper-2);
        border: 0;
        padding: 20px;
      }
      .card h2 {
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .card .num {
        font-family: var(--mono);
        font-size: 30px;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--ink);
        margin-top: 8px;
      }
      .card .detail { font-size: 12px; line-height: 1.6; color: var(--ink-3); margin-top: 6px; }

      /* 独立卡片（非网格内）需要有边框 */
      .card:not(.grid > *) { border: 1px solid var(--line); }

      /* ── 表格（账簿式） ───────────────────────────────────── */
      .table-wrap { width: 100%; overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
      th, td { text-align: left; padding: 11px 12px; vertical-align: middle; }
      th {
        background: transparent;
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        white-space: nowrap;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      td { border-bottom: 1px solid var(--line); }
      tbody tr:hover td { background: var(--paper-3); }
      th:first-child, td:first-child { padding-left: 16px; }
      th:last-child, td:last-child { padding-right: 16px; }
      td.num, th.num { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
      strong { font-weight: 600; }
      .pos {
        width: 3rem;
        font-family: var(--serif);
        font-size: 16px;
        color: var(--ink-3);
        font-variant-numeric: tabular-nums;
      }
      tbody tr:nth-child(-n + 3) .pos { color: var(--accent); }
      .up { color: var(--ok); }
      .down { color: var(--bad); }

      /* ── 标签 / 计数 ──────────────────────────────────────── */
      .badge {
        display: inline-flex;
        align-items: center;
        height: 18px;
        padding: 0 6px;
        border: 1px solid currentColor;
        border-radius: 0;
        font-family: var(--mono);
        font-size: 9.5px;
        font-weight: 500;
        letter-spacing: 0.08em;
        line-height: 16px;
        white-space: nowrap;
        vertical-align: middle;
        opacity: 0.9;
      }
      .b-open { color: var(--ok); }
      .b-semi { color: var(--warn); }
      .b-closed { color: var(--bad); }
      .counter {
        display: inline-block;
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 500;
        color: var(--ink-3);
        letter-spacing: 0.04em;
      }

      /* ── 按钮 ─────────────────────────────────────────────── */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border: 1px solid var(--ink);
        border-radius: 0;
        background: transparent;
        color: var(--ink);
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        line-height: 1.4;
        cursor: pointer;
        white-space: nowrap;
      }
      .btn:hover { background: var(--ink); color: var(--paper); text-decoration: none; border-color: var(--ink); }
      .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
      .btn-primary:hover { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); opacity: 0.88; }
      .btn-sm { padding: 4px 10px; font-size: 9.5px; }

      /* ── 筛选 tabs / 分段 ─────────────────────────────────── */
      .tabs {
        display: flex;
        gap: 18px;
        overflow-x: auto;
        scrollbar-width: none;
        border-bottom: 1px solid var(--line-2);
        margin-bottom: 22px;
      }
      .tabs::-webkit-scrollbar { display: none; }
      .tab {
        padding: 9px 0;
        margin-bottom: -1px;
        border-bottom: 2px solid transparent;
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .tab:hover { color: var(--ink); text-decoration: none; }
      .tab[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
      .segmented {
        display: inline-flex;
        border: 1px solid var(--line-2);
        border-radius: 0;
        overflow: hidden;
      }
      .segmented a {
        padding: 5px 11px;
        border-right: 1px solid var(--line-2);
        color: var(--ink-2);
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .segmented a:last-child { border-right: 0; }
      .segmented a:hover { background: var(--paper-3); color: var(--ink); text-decoration: none; }
      .segmented a[aria-current='page'] { background: var(--ink); color: var(--paper); }

      /* ── 提示 ─────────────────────────────────────────────── */
      .warn {
        border-left: 2px solid var(--warn);
        background: color-mix(in srgb, var(--warn) 7%, transparent);
        color: var(--ink);
        padding: 12px 16px;
        border-radius: 0;
        font-size: 13.5px;
      }
      .warn strong { color: var(--warn); }
      .notice {
        border-left: 2px solid var(--line-2);
        background: var(--paper-2);
        color: var(--ink-2);
        padding: 12px 16px;
        border-radius: 0;
        font-size: 13px;
      }
      .notice strong { color: var(--ink); }

      /* ── Agent 图标 ───────────────────────────────────────── */
      .agent-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: var(--icon-size, 32px);
        height: var(--icon-size, 32px);
        border-radius: 1px;
        border: 1px solid var(--line);
        background: var(--paper-3);
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: calc(var(--icon-size, 32px) * 0.36);
        font-weight: 600;
        line-height: 1;
        overflow: hidden;
        text-transform: uppercase;
        user-select: none;
      }
      .agent-icon-letter { position: relative; z-index: 1; }
      .agent-icon img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: var(--paper-2);
        z-index: 2;
      }
      .agent-cell { display: flex; align-items: center; gap: 11px; min-width: 0; }
      .agent-cell .name { font-weight: 600; color: var(--ink); }
      .agent-cell .name:hover { color: var(--accent); }
      .agent-cell .tags { display: inline-flex; gap: 5px; flex-wrap: wrap; align-items: center; }

      /* ── 榜单控件 ─────────────────────────────────────────── */
      .rank-toolbar {
        display: flex;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
        padding: 12px 0;
        border-top: 1px solid var(--line-2);
        border-bottom: 1px solid var(--line);
        margin-bottom: 0;
      }
      .rank-toolbar .row { gap: 8px; }
      .rank-toolbar-count {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        color: var(--ink-3);
        margin-left: auto;
      }
      .rank-hint {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.04em;
        color: var(--ink-3);
        padding: 10px 0;
        border-bottom: 1px solid var(--line);
      }
      .rank-empty { margin: 16px 0; }
      th.sortable { padding: 0; }
      th.sortable button {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        width: 100%;
        justify-content: flex-end;
        padding: 11px 12px;
        font: inherit;
        font-size: 9.5px;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: inherit;
        background: none;
        border: 0;
        cursor: pointer;
      }
      th.sortable button:hover { color: var(--ink); }
      th.sortable[aria-sort='descending'] button,
      th.sortable[aria-sort='ascending'] button { color: var(--accent); }
      .sort-caret { font-size: 7px; line-height: 1; min-width: 7px; }
      .rank-row { cursor: pointer; }
      .rank-row:hover td { background: var(--paper-3); }

      .rank-cards { display: none; list-style: none; }
      .rank-card { border-bottom: 1px solid var(--line); }
      .rank-card:last-child { border-bottom: 0; }
      .rank-card-main {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 16px;
        color: inherit;
        text-decoration: none;
      }
      .rank-card-main:hover { text-decoration: none; background: var(--paper-3); }
      .rank-card-name { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1; }
      .rank-card-name .name { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rank-card-score { font-family: var(--mono); font-variant-numeric: tabular-nums; font-weight: 600; font-size: 16px; }
      .rank-card-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 16px;
        padding: 0 16px 12px 55px;
        font-family: var(--mono);
        font-size: 10.5px;
        font-variant-numeric: tabular-nums;
        color: var(--ink);
      }
      .rank-card-stats em { font-style: normal; color: var(--ink-3); margin-right: 5px; }

      /* ── 首页选型 ─────────────────────────────────────────── */
      .picker-search {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--line-2);
        border-radius: 0;
        background: transparent;
      }
      .picker-search:focus-within { border-bottom-color: var(--accent); }
      .picker-search svg { color: var(--accent); flex: none; }
      .picker-input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: none;
        color: var(--ink);
        font-family: var(--sans);
        font-size: 20px;
        letter-spacing: -0.01em;
        line-height: 1.4;
        outline: none;
      }
      .picker-input::placeholder { color: var(--ink-3); }
      .picker-input::-webkit-search-cancel-button { display: none; }
      .picker-clear {
        border: 0;
        background: none;
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: 16px;
        line-height: 1;
        cursor: pointer;
        padding: 0 2px;
      }
      .picker-clear:hover { color: var(--ink); }
      .picker-filters {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
      }
      .chips { display: flex; flex-wrap: wrap; gap: 4px; }
      .chip {
        padding: 3px 8px;
        border: 0;
        border-bottom: 1px solid transparent;
        border-radius: 0;
        background: none;
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        line-height: 1.6;
        cursor: pointer;
      }
      .chip:hover { color: var(--ink); }
      .chip[aria-pressed='true'] { color: var(--accent); border-bottom-color: var(--accent); }
      .picker-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 12px 0;
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
      }
      .picker-list { list-style: none; }
      .picker-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 4px;
        border-bottom: 1px solid var(--line);
        color: var(--ink);
      }
      .picker-list li:last-child .picker-item { border-bottom: 0; }
      .picker-item:hover { background: var(--paper-3); text-decoration: none; }
      .picker-item-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
      .picker-item-main .name { font-weight: 600; }
      .picker-item:hover .name { color: var(--accent); }
      .picker-item-meta {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.04em;
        color: var(--ink-3);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .picker-item-score {
        font-family: var(--mono);
        font-variant-numeric: tabular-nums;
        font-size: 16px;
        font-weight: 600;
        min-width: 3.4rem;
        text-align: right;
      }
      .picker-empty { padding: 16px 4px; font-size: 13px; }
      .link-btn {
        border: 0;
        background: none;
        color: var(--accent);
        cursor: pointer;
        padding: 0 2px;
        font: inherit;
        border-bottom: 1px solid currentColor;
      }

      /* ── 首页 hero / 双榜账簿 ─────────────────────────────── */
      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(250px, 0.85fr);
        gap: 56px;
        align-items: end;
        padding-bottom: 36px;
        border-bottom: 1px solid var(--line-2);
      }
      .hero .display { margin: 14px 0 20px; max-width: 20ch; }
      .hero-rail { padding-bottom: 2px; }
      .ledger-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        border-top: 1px solid var(--line);
      }
      .ledger { padding: 0; }
      .ledger + .ledger { border-left: 1px solid var(--line); }
      .ledger-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 20px 12px;
        border-bottom: 1px solid var(--line);
      }
      .ledger:first-child .ledger-head { padding-left: 0; }
      .ledger:last-child .ledger-head { padding-right: 0; }
      .ledger-title {
        display: flex;
        align-items: baseline;
        gap: 10px;
        font-family: var(--sans);
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .ledger-title .idx {
        font-family: var(--mono);
        font-size: 9.5px;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .ledger table { font-size: 13.5px; }
      .ledger th { border-top: 0; }
      .ledger th:first-child, .ledger td:first-child { padding-left: 0; }
      .ledger th:last-child, .ledger td:last-child { padding-right: 10px; }
      .ledger:last-child th:last-child, .ledger:last-child td:last-child { padding-right: 0; }
      .ledger-foot {
        padding: 12px 0 14px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        color: var(--ink-3);
      }

      /* ── 详情页 hero ──────────────────────────────────────── */
      .agent-hero {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) minmax(230px, 0.75fr);
        gap: 28px;
        align-items: start;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--line-2);
      }
      .agent-hero h1 { margin: 8px 0 10px; }
      .agent-hero .stat-rail { border-top: 0; }
      .agent-hero .stat-rail div:first-child { padding-top: 0; }

      /* ── 统计条（hero 右侧） ──────────────────────────────── */
      .stat-rail { display: grid; gap: 0; border-top: 1px solid var(--line-2); }
      .stat-rail div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
      }
      .stat-rail dt,
      .stat-rail span[data-k] {
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .stat-rail b {
        font-family: var(--mono);
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--ink);
      }
      .stat-rail b em { font-style: normal; color: var(--accent); }

      /* ── 图表 ─────────────────────────────────────────────── */
      .bar-chart { list-style: none; display: grid; gap: 12px; }
      .bar-row {
        display: grid;
        grid-template-columns: minmax(0, 8em) 1fr 4em;
        align-items: center;
        gap: 14px;
        font-size: 12.5px;
      }
      .bar-label { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .bar-label a { color: inherit; }
      .bar-track { height: 6px; border-radius: 0; background: var(--paper-3); overflow: hidden; }
      .bar-fill { display: block; height: 100%; border-radius: 0; background: var(--accent); transition: width 0.3s ease; }
      .bar-fill.tone-default,
      .bar-fill.tone-accent { background: var(--accent); }
      .bar-fill.tone-success { background: var(--ok); }
      .bar-fill.tone-attention { background: var(--warn); }
      .bar-fill.tone-danger { background: var(--bad); }
      .bar-value {
        text-align: right;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-2);
        font-variant-numeric: tabular-nums;
      }

      .line-chart { margin: 0; }
      .lc-grid-wrap { display: grid; grid-template-columns: 3.6em 1fr; height: var(--lc-height, 200px); }
      .lc-yaxis { position: relative; font-family: var(--mono); font-size: 10px; color: var(--ink-3); }
      .lc-yaxis span {
        position: absolute;
        right: 10px;
        transform: translateY(-50%);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
      .lc-canvas { position: relative; border-left: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); }
      .lc-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
      .lc-grid { stroke: var(--line); stroke-width: 1; stroke-dasharray: 1 4; }
      .lc-line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
      .lc-line.tone-default,
      .lc-line.tone-accent { stroke: var(--accent); }
      .lc-line.tone-success { stroke: var(--accent-2); }
      .lc-line.tone-attention { stroke: var(--warn); }
      .lc-line.tone-danger { stroke: var(--bad); }
      .lc-area { stroke: none; opacity: 0.1; }
      .lc-area.tone-default,
      .lc-area.tone-accent { fill: var(--accent); }
      .lc-area.tone-success { fill: var(--accent-2); }
      .lc-area.tone-attention { fill: var(--warn); }
      .lc-area.tone-danger { fill: var(--bad); }
      .lc-dots { position: absolute; inset: 0; }
      .lc-dot {
        position: absolute;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background: var(--accent);
        box-shadow: 0 0 0 2px var(--paper-2);
      }
      .lc-dot.tone-success { background: var(--accent-2); }
      .lc-dot.tone-attention { background: var(--warn); }
      .lc-dot.tone-danger { background: var(--bad); }
      .lc-xaxis {
        position: relative;
        height: 16px;
        margin: 7px 0 0 3.6em;
        font-family: var(--mono);
        font-size: 10px;
        color: var(--ink-3);
      }
      .lc-xaxis span {
        position: absolute;
        transform: translateX(-50%);
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
      }
      .lc-xaxis span.is-first { transform: none; }
      .lc-xaxis span.is-last { transform: translateX(-100%); }
      .lc-legend {
        list-style: none;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        margin: 12px 0 0 3.6em;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        color: var(--ink-3);
      }
      .lc-legend li { display: inline-flex; align-items: center; gap: 6px; }
      .swatch { width: 8px; height: 8px; border-radius: 0; display: inline-block; background: var(--accent); }
      .swatch.tone-success { background: var(--accent-2); }
      .swatch.tone-attention { background: var(--warn); }
      .swatch.tone-danger { background: var(--bad); }
      .chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
      .chart-grid > * { background: var(--paper-2); }

      .pkg { overflow-wrap: anywhere; word-break: break-word; }

      /* ── 页脚 ─────────────────────────────────────────────── */
      .colophon {
        border-top: 1px solid var(--line-2);
        padding: 28px 0 48px;
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.04em;
        color: var(--ink-3);
      }
      .colophon-inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 32px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
      }
      .colophon b { color: var(--ink-2); font-weight: 500; }
      .colophon nav { display: flex; gap: 18px; flex-wrap: wrap; }
      .colophon a { color: var(--ink-3); }
      .colophon a:hover { color: var(--accent); }

      /* ── 入场动效 ─────────────────────────────────────────── */
      @keyframes rise {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: none; }
      }
      main > .container > * { animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both; }
      main > .container > *:nth-child(2) { animation-delay: 0.04s; }
      main > .container > *:nth-child(3) { animation-delay: 0.08s; }
      main > .container > *:nth-child(4) { animation-delay: 0.12s; }
      main > .container > *:nth-child(n + 5) { animation-delay: 0.16s; }
      @media (prefers-reduced-motion: reduce) {
        main > .container > * { animation: none; }
        .bar-fill { transition: none; }
      }

      /* ── 响应式 ───────────────────────────────────────────── */
      @media (max-width: 900px) {
        .container, .masthead-top, .masthead-nav, .colophon-inner { padding-left: 20px; padding-right: 20px; }
        main { padding: 28px 0 56px; }
        .section { margin-top: 40px; }
        .wordmark-tag { display: none; }
      }
      @media (max-width: 768px) {
        .container, .masthead-top, .masthead-nav, .colophon-inner { padding-left: 16px; padding-right: 16px; }
        .masthead-top { padding-top: 10px; padding-bottom: 8px; }
        .masthead-nav a { padding: 7px 10px 8px; font-size: 12.5px; }
        .masthead-nav a i { display: none; }
        .snap { display: none; }
        .hide-sm { display: none; }
        .pkg { max-width: 8.5em; }
        .grid { grid-template-columns: 1fr; }
        .grid.grid-tight { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .grid.grid-tight .card { padding: 14px; }
        .grid.grid-tight .card .num { font-size: 22px; }
        .card { padding: 16px; }
        .box-body { padding: 16px; }
        .rank-table { display: none; }
        .rank-cards { display: block; }
        .rank-toolbar { gap: 14px; }
        .rank-toolbar-count { margin-left: 0; width: 100%; }
        .tabs { gap: 14px; }
        .bar-row { grid-template-columns: minmax(0, 5.6em) 1fr 3.2em; gap: 10px; font-size: 12px; }
        .lc-grid-wrap { height: 170px; }
        .lc-xaxis span { font-size: 9.5px; }
        .picker-input { font-size: 17px; }
        .picker-filters { gap: 12px; }
        .picker-item { gap: 11px; }
        .picker-item-score { min-width: 2.8rem; font-size: 15px; }
        .hero { grid-template-columns: 1fr; gap: 24px; padding-bottom: 24px; }
        .hero .display { max-width: none; }
        .ledger-grid { grid-template-columns: 1fr; }
        .ledger + .ledger { border-left: 0; border-top: 1px solid var(--line); }
        .ledger:first-child .ledger-head { padding-left: 0; }
        .ledger-head { padding-left: 0; padding-right: 0; }
        .agent-hero { grid-template-columns: auto minmax(0, 1fr); gap: 16px; }
        .agent-hero .agent-hero-rail { grid-column: 1 / -1; }
        .agent-hero .stat-rail { border-top: 1px solid var(--line-2); }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>

    <header class="masthead">
      <div class="masthead-top">
        <a class="wordmark" href="/" aria-label="AgentNews 首页">
          <span class="mark" aria-hidden="true">◤</span>AgentNews
        </a>
        <span class="wordmark-tag">AI AGENT INDEX</span>
        <div class="masthead-meta">
          <span class="snap">SNAPSHOT <b>{date}</b></span>
          <button class="theme-btn" id="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题">
            <svg class="icon-moon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M9.6 1.1a6.9 6.9 0 1 0 5.3 10.5A7.4 7.4 0 0 1 9.6 1.1Z" />
            </svg>
            <svg class="icon-sun" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 11.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7ZM8 0a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 0Zm0 13.5a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 13.5ZM2.3 2.3a.75.75 0 0 1 1.06 0l.7.71a.75.75 0 0 1-1.06 1.06l-.7-.7a.75.75 0 0 1 0-1.07Zm9.64 9.64a.75.75 0 0 1 1.06 0l.7.7a.75.75 0 1 1-1.06 1.07l-.7-.71a.75.75 0 0 1 0-1.06ZM0 8a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1A.75.75 0 0 1 0 8Zm13.5 0a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1a.75.75 0 0 1-.75-.75ZM3 11.94a.75.75 0 0 1 0 1.06l-.7.7a.75.75 0 1 1-1.07-1.06l.71-.7a.75.75 0 0 1 1.06 0Zm9.64-9.64a.75.75 0 0 1 0 1.06l-.7.7A.75.75 0 0 1 10.88 3l.7-.7a.75.75 0 0 1 1.06 0Z" />
            </svg>
          </button>
        </div>
      </div>
      <nav class="masthead-nav" aria-label="主导航">
        {NAV.map((item, i) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            <i>{String(i + 1).padStart(2, '0')}</i>{item.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main">
      <div class="container">
        {hasData ? (
          <slot />
        ) : (
          <div class="page-head">
            <span class="eyebrow">Index · Pending</span>
            <h1>数据积累中</h1>
            <p class="lede">首次运行后 24 小时内自动生成快照。当前无评分数据。</p>
          </div>
        )}
      </div>
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <div>
          <b>AgentNews</b> — AI Agent Index<br />
          数据截至 {date} · 开源 {openCount} / 闭源 {closedCount} · 综合分是观点，非客观事实
        </div>
        <nav aria-label="页脚导航">
          <a href="/about/">方法与口径</a>
          <a href="/changelog/">变更记录</a>
          <a href="/archive/">数据归档</a>
          <a href="/security/">安全公告</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('an-theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
