---
import { loadLatestScores, loadAgentsMeta } from '../lib/data';
import PinTray from '../components/PinTray';
import {
  HTML_LANG,
  type Lang,
  langOf,
  pathFor,
  stripLang,
  swapLangPath,
  t,
} from '../i18n/dict';

const data = loadLatestScores();
const rows = data?.rows ?? [];
const hasData = rows.length > 0;
const date = data?.date ?? '—';
const agentsMeta = loadAgentsMeta();

const path = Astro.url.pathname;
const props = Astro.props as { lang?: Lang; pageTitle?: string; description?: string };
const lang: Lang = props.lang ?? langOf(path);
const base = stripLang(path);
const SITE = Astro.site ?? new URL('https://agentnews.example.com');

const pageTitle = props.pageTitle ?? t(lang, 'app.name');
const description =
  props.description ??
  (lang === 'en'
    ? `AI agent index: ${rows.length} agents across open/closed boards, normalized across ecosystems. Data as of ${date}.`
    : `AI Agent 排行榜：${rows.length} 个 agent 的开源/闭源双榜，按 star、安装量、活跃度跨生态归一化排名。数据截至 ${date}。`);

const canonical = new URL(path, SITE).href;
const zhHref = new URL(base, SITE).href;
const enHref = new URL(pathFor('en', base), SITE).href;

const NAV = [
  { key: 'index', href: '/' },
  { key: 'board', href: '/top/open/all/month/' },
  { key: 'compare', href: '/compare/' },
  { key: 'new', href: '/rising/' },
  { key: 'log', href: '/activity/' },
  { key: 'osv', href: '/security/' },
  { key: 'archive', href: '/archive/' },
  { key: 'method', href: '/about/' },
];
const isActive = (href: string) =>
  href === '/' ? base === '/' || base === '' : base.startsWith(href.replace(/\/$/, ''));

/** 托盘用的轻量元信息 */
const pinMeta: Record<string, { name: string; form: string; score: number | null; icon: string | null; iconFallback: string | null }> = {};
for (const r of rows) {
  pinMeta[r.slug] = {
    name: r.name ?? r.slug,
    form: r.form,
    score: r.score,
    icon: agentsMeta[r.slug]?.icon ?? null,
    iconFallback: agentsMeta[r.slug]?.iconFallback ?? null,
  };
}
const openCount = rows.filter((r) => r.oss_bucket !== 'closed').length;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle} · AgentNews</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={zhHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${pageTitle} · AgentNews`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('an-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <script is:inline>
      // 首次访问：非中文浏览器在中文首页自动跳到 /en/（深链不跳，避免打断分享链接）
      (function () {
        try {
          var stored = localStorage.getItem('an-lang');
          if (stored === 'zh' || stored === 'en') return;
          var nav = (navigator.languages && navigator.languages[0]) || navigator.language || '';
          if (/^zh/i.test(nav)) return;
          if (location.pathname === '/' || location.pathname === '') location.replace('/en/');
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      document.addEventListener(
        'error',
        function (e) {
          var el = e.target;
          if (!el || el.tagName !== 'IMG') return;
          var fb = el.getAttribute('data-fallback');
          if (fb) {
            el.setAttribute('data-fallback', '');
            el.src = fb;
            return;
          }
          if (el.closest('.agent-icon')) el.remove();
        },
        true,
      );
    </script>
    <style is:global>
      /* ═══════════════════════════════════════════════════════════════
         AgentNews — SURVEY SHEET
         核心隐喻：归一化 = 把不同的东西放到同一把尺子上。
         所以视觉语言是「测量」：刻度、发丝线、等宽数字、单一信号色。
         界面用纯墨色；颜色只留给数据（冷 → 热）。
         ═══════════════════════════════════════════════════════════════ */
      :root {
        color-scheme: light;
        --paper: #fcfcfb;
        --paper-2: #ffffff;
        --paper-3: #f4f4f2;
        --rule: #e2e2df;
        --rule-2: #cfcfca;
        --ink: #0e0f10;
        --ink-2: #5a5d61;
        --ink-3: #8f9396;
        --ink-4: #b9bcbd;

        /* 数据热力刻度：冷 → 温 → 热（只用于编码数值） */
        --heat-1: #2f5fe0;
        --heat-2: #4b8fd6;
        --heat-3: #e0a91c;
        --heat-4: #d9561a;
        --heat-5: #c22a12;
        --ok: #1f7a4d;
        --bad: #b3261e;

        /* Windows 优先：Segoe UI + 微软雅黑 UI；macOS 走 system-ui / PingFang */
        --sans: system-ui, -apple-system, 'Segoe UI', 'Microsoft YaHei UI', 'Microsoft YaHei',
          'PingFang SC', 'Noto Sans SC', 'Hiragino Sans GB', Roboto, Helvetica, Arial, sans-serif;
        --mono: 'Cascadia Mono', Consolas, ui-monospace, SFMono-Regular, 'SF Mono', Menlo,
          'DejaVu Sans Mono', monospace;

        /* 兼容页面里遗留的旧变量名 */
        --gh-canvas: var(--paper-2);
        --gh-canvas-subtle: var(--paper-3);
        --gh-border: var(--rule);
        --gh-border-muted: var(--rule);
        --gh-fg: var(--ink);
        --gh-fg-muted: var(--ink-2);
        --gh-fg-subtle: var(--ink-3);
        --gh-accent: var(--ink);
        --gh-accent-subtle: var(--paper-3);
        --gh-success: var(--ok);
        --gh-attention: #9a6b00;
        --gh-danger: var(--bad);
        --gh-neutral-subtle: var(--paper-3);
        --bg: var(--paper);
        --card: var(--paper-2);
        --border: var(--rule);
        --text: var(--ink);
        --muted: var(--ink-2);
        --accent: var(--ink);
        --green: var(--ok);
        --red: var(--bad);
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --paper: #08090a;
        --paper-2: #0e1011;
        --paper-3: #161819;
        --rule: #232628;
        --rule-2: #33373a;
        --ink: #f2f3f3;
        --ink-2: #9ba0a3;
        --ink-3: #71777a;
        --ink-4: #4e5457;
        --heat-1: #6f9bff;
        --heat-2: #63b3f0;
        --heat-3: #f0c04a;
        --heat-4: #ff8b52;
        --heat-5: #ff5a3c;
        --ok: #57c98a;
        --bad: #ff6b5b;
        --gh-attention: #d9a53a;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --paper: #08090a;
          --paper-2: #0e1011;
          --paper-3: #161819;
          --rule: #232628;
          --rule-2: #33373a;
          --ink: #f2f3f3;
          --ink-2: #9ba0a3;
          --ink-3: #71777a;
          --ink-4: #4e5457;
          --heat-1: #6f9bff;
          --heat-2: #63b3f0;
          --heat-3: #f0c04a;
          --heat-4: #ff8b52;
          --heat-5: #ff5a3c;
          --ok: #57c98a;
          --bad: #ff6b5b;
          --gh-attention: #d9a53a;
        }
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.62;
        /* 不设 antialiased：Windows 上会关掉次像素渲染，字发虚 */
        font-variant-numeric: tabular-nums;
      }
      a { color: inherit; text-decoration: none; }
      a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
      code, .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
      code { font-size: 0.88em; padding: 0.1em 0.3em; background: var(--paper-3); color: var(--ink-2); }

      /* ── 排版：小、密、克制 ───────────────────────────────── */
      h1, h2, h3 { font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; }
      h1 { font-size: 29px; letter-spacing: -0.018em; }
      h2 { font-size: 16px; }
      h3 { font-size: 15px; }
      p { margin: 0; }

      .container { max-width: 1320px; margin: 0 auto; padding: 0 28px; }
      .stack > * + * { margin-top: 16px; }
      .row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .spread { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
      .muted { color: var(--ink-2); }
      .subtle { color: var(--ink-3); }
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 8px; top: 8px; z-index: 100; background: var(--paper-2); padding: 8px; }

      /* 标签：全站统一的小型大写标记 */
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .eyebrow::before {
        content: '';
        width: 5px;
        height: 5px;
        background: var(--ink);
        flex: none;
      }
      .lede { font-size: 14.5px; line-height: 1.7; color: var(--ink-2); max-width: 74ch; }
      .display {
        font-size: clamp(30px, 3.8vw, 42px);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.12;
        text-wrap: balance;
      }

      /* ── 刻度尺：本站的签名元素 ───────────────────────────── */
      .ruler {
        position: relative;
        height: 15px;
        border-bottom: 1px solid var(--rule-2);
        background-image: repeating-linear-gradient(
          to right,
          var(--rule-2) 0 1px,
          transparent 1px 8px
        );
        background-size: 100% 5px;
        background-position: bottom left;
        background-repeat: repeat-x;
      }
      .ruler::after {
        content: '';
        position: absolute;
        inset: auto 0 0 0;
        height: 9px;
        background-image: repeating-linear-gradient(
          to right,
          var(--rule-2) 0 1px,
          transparent 1px 40px
        );
        background-size: 100% 9px;
        background-position: bottom left;
        background-repeat: repeat-x;
      }

      /* ── 顶栏 ─────────────────────────────────────────────── */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        background: color-mix(in srgb, var(--paper) 92%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--rule);
      }
      .topbar-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 28px;
        height: 50px;
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 15.5px;
        font-weight: 600;
        letter-spacing: -0.02em;
        flex: none;
      }
      .brand:hover { text-decoration: none; }
      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        background: var(--ink);
        color: var(--paper);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 700;
        flex: none;
      }
      .topnav { display: flex; align-items: center; gap: 2px; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
      .topnav::-webkit-scrollbar { display: none; }
      .topnav a {
        display: inline-flex;
        align-items: baseline;
        gap: 5px;
        padding: 6px 10px;
        font-size: 14px;
        color: var(--ink-2);
        white-space: nowrap;
        border: 1px solid transparent;
      }
      .topnav a i {
        font-family: var(--mono);
        font-style: normal;
        font-size: 9.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-4);
      }
      .topnav a:hover { color: var(--ink); text-decoration: none; background: var(--paper-3); }
      .topnav a[aria-current='page'] {
        color: var(--paper);
        background: var(--ink);
        border-color: var(--ink);
      }
      .topnav a[aria-current='page'] i { color: color-mix(in srgb, var(--paper) 70%, transparent); }
      .topbar-meta { display: flex; align-items: center; gap: 10px; margin-left: auto; flex: none; }
      .snap-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--ink-3);
        white-space: nowrap;
      }
      .snap-chip b { color: var(--ink); font-weight: 500; }
      .theme-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border: 1px solid var(--rule);
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
      }
      .theme-btn:hover { border-color: var(--ink-4); color: var(--ink); }
      .theme-btn .icon-sun { display: none; }
      .theme-btn .icon-moon { display: block; }
      :root[data-theme='dark'] .theme-btn .icon-sun { display: block; }
      :root[data-theme='dark'] .theme-btn .icon-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .theme-btn .icon-sun { display: block; }
        :root:not([data-theme='light']) .theme-btn .icon-moon { display: none; }
      }

      /* ── 页面骨架 ─────────────────────────────────────────── */
      main { padding: 26px 0 72px; }
      .page-head { display: flex; flex-direction: column; gap: 8px; padding-bottom: 18px; }
      .page-head h1 { margin-top: 2px; }
      .crumbs {
        display: flex;
        align-items: center;
        gap: 7px;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .crumbs a:hover { color: var(--ink); }
      .section { margin-top: 36px; }
      .section-title {
        display: flex;
        align-items: baseline;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 14px;
      }
      .section-title h2 {
        font-family: var(--mono);
        font-size: 11.5px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink);
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .section-title h2::before {
        content: '';
        width: 5px;
        height: 5px;
        background: var(--ink);
      }
      .section-title .muted { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; color: var(--ink-3); }

      /* ── 面板：发丝线，无圆角，无阴影 ─────────────────────── */
      .box { background: var(--paper-2); border: 1px solid var(--rule); }
      .box-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 9px 14px;
        border-bottom: 1px solid var(--rule);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-2);
        background: var(--paper-3);
      }
      .box-body { padding: 18px; }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
        margin-top: 18px;
      }
      .grid > * { background: var(--paper-2); }
      .grid.grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      @media (max-width: 980px) { .grid.grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      .card { background: var(--paper-2); padding: 16px; }
      .card:not(.grid > *) { border: 1px solid var(--rule); }
      .card h2 {
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .card .num {
        font-family: var(--mono);
        font-size: 28px;
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-top: 6px;
      }
      .card .detail { font-size: 12.5px; line-height: 1.55; color: var(--ink-3); margin-top: 5px; }
      .guide-list { list-style: none; margin-top: 10px; display: grid; gap: 6px; }
      .guide-list li {
        position: relative;
        padding-left: 13px;
        font-size: 13.5px;
        line-height: 1.55;
        color: var(--ink-2);
      }
      .guide-list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 1px; background: var(--ink-4); }

      /* ── 表格：账簿式，密而清楚 ───────────────────────────── */
      .table-wrap { width: 100%; overflow-x: auto; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; }
      th, td { text-align: left; padding: 8px 12px; vertical-align: middle; }
      th {
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
        white-space: nowrap;
        border-bottom: 1px solid var(--rule-2);
        background: transparent;
      }
      td { border-bottom: 1px solid var(--rule); }
      /* 英文长单词（包名 / 标量名）不撑破表格 */
      td, th { overflow-wrap: anywhere; }
      tbody tr:hover td { background: var(--paper-3); }
      th:first-child, td:first-child { padding-left: 14px; }
      th:last-child, td:last-child { padding-right: 14px; }
      td.num, th.num { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
      strong { font-weight: 600; }
      .pos {
        width: 3.4rem;
        min-width: 3.4rem;
        white-space: nowrap;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--ink-3);
      }
      .up { color: var(--ok); }
      .down { color: var(--bad); }

      /* ── 徽标 ─────────────────────────────────────────────── */
      .badge {
        display: inline-flex;
        align-items: center;
        height: 18px;
        padding: 0 4px;
        border: 1px solid currentColor;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.06em;
        line-height: 16px;
        white-space: nowrap;
        vertical-align: middle;
      }
      .b-open { color: var(--ok); }
      .b-semi { color: var(--gh-attention); }
      .b-closed { color: var(--bad); }
      .counter {
        display: inline-block;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-3);
        letter-spacing: 0.04em;
      }

      /* ── 按钮 ─────────────────────────────────────────────── */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: 1px solid var(--rule-2);
        background: var(--paper-2);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        line-height: 1.5;
        cursor: pointer;
        white-space: nowrap;
      }
      .btn:hover { border-color: var(--ink); text-decoration: none; }
      .btn-primary { background: var(--ink); border-color: var(--ink); color: var(--paper); }
      .btn-primary:hover { background: var(--ink); color: var(--paper); opacity: 0.85; }
      .btn-sm { padding: 4px 9px; font-size: 10px; }

      /* ── 筛选：刻度式切换 ─────────────────────────────────── */
      .tabs {
        display: flex;
        gap: 0;
        overflow-x: auto;
        scrollbar-width: none;
        border-bottom: 1px solid var(--rule-2);
        margin-bottom: 16px;
      }
      .tabs::-webkit-scrollbar { display: none; }
      .tab {
        padding: 8px 12px;
        margin-bottom: -1px;
        border: 1px solid transparent;
        border-bottom: 1px solid transparent;
        color: var(--ink-2);
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }
      .tab:hover { color: var(--ink); text-decoration: none; background: var(--paper-3); }
      .tab[aria-current='page'] {
        color: var(--ink);
        border-color: var(--rule-2);
        border-bottom-color: var(--paper-2);
        background: var(--paper-2);
        font-weight: 500;
      }
      .segmented { display: inline-flex; border: 1px solid var(--rule-2); }
      .segmented a, .segmented button {
        padding: 4px 10px;
        border-right: 1px solid var(--rule-2);
        color: var(--ink-2);
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: transparent;
        border-top: 0;
        border-left: 0;
        border-bottom: 0;
        cursor: pointer;
      }
      .segmented > *:last-child { border-right: 0; }
      .segmented a:hover, .segmented button:hover { background: var(--paper-3); color: var(--ink); text-decoration: none; }
      .segmented a[aria-current='page'], .segmented button[aria-current='page'] { background: var(--ink); color: var(--paper); }

      /* ── 提示 ─────────────────────────────────────────────── */
      .warn {
        border-left: 2px solid var(--gh-attention);
        background: color-mix(in srgb, var(--gh-attention) 8%, transparent);
        padding: 9px 13px;
        font-size: 13.5px;
      }
      .notice { border-left: 2px solid var(--rule-2); background: var(--paper-3); padding: 9px 13px; font-size: 13.5px; color: var(--ink-2); }
      .notice strong { color: var(--ink); }

      /* ── Agent 图标：方形、无圆角、细边 ──────────────────── */
      .agent-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: var(--icon-size, 26px);
        height: var(--icon-size, 26px);
        border: 1px solid var(--rule);
        background: var(--paper-3);
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: calc(var(--icon-size, 26px) * 0.42);
        font-weight: 600;
        line-height: 1;
        overflow: hidden;
        text-transform: uppercase;
        user-select: none;
      }
      .agent-icon-letter { position: relative; z-index: 1; }
      .agent-icon img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: var(--paper-2);
        z-index: 2;
      }
      .agent-cell { display: flex; align-items: center; gap: 9px; min-width: 0; }
      .agent-cell .name { font-weight: 500; color: var(--ink); }
      .agent-cell .name:hover { text-decoration: underline; }
      .agent-cell .tags { display: inline-flex; gap: 4px; flex-wrap: wrap; align-items: center; }

      /* ── 榜单控件 ─────────────────────────────────────────── */
      .rank-toolbar {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        padding: 10px 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
      }
      .rank-toolbar-count {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.05em;
        color: var(--ink-3);
        margin-left: auto;
      }
      .rank-hint {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--ink-3);
        padding: 8px 0;
        border-bottom: 1px solid var(--rule);
      }
      .rank-empty { margin: 14px 0; }
      th.sortable { padding: 0; }
      th.sortable button {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        width: 100%;
        justify-content: flex-end;
        padding: 8px 12px;
        font: inherit;
        font-size: 10.5px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: inherit;
        background: none;
        border: 0;
        cursor: pointer;
      }
      th.sortable button:hover { color: var(--ink); }
      th.sortable[aria-sort='descending'] button,
      th.sortable[aria-sort='ascending'] button { color: var(--ink); font-weight: 600; }
      .sort-caret { font-size: 7px; line-height: 1; min-width: 7px; }
      .rank-row { cursor: pointer; }
      .rank-row:hover td { background: var(--paper-3); }

      /* 行内微条：把数值变成可比较的长度（本站核心可视化） */
      .micro {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        justify-content: flex-end;
        width: 100%;
      }
      .micro-track {
        width: 44px;
        height: 3px;
        background: var(--paper-3);
        position: relative;
        flex: none;
      }
      .micro-fill { position: absolute; inset: 0 auto 0 0; background: var(--ink-4); }
      .micro-fill.heat { background: var(--heat-4); }

      /* 行内钉选按钮：hover 才出现，避免视觉噪音 */
      .pin-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border: 1px solid transparent;
        background: transparent;
        color: var(--ink-4);
        font-family: var(--mono);
        font-size: 12px;
        line-height: 1;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.12s;
      }
      tr:hover .pin-btn, .pin-btn:focus-visible, .pin-btn.is-pinned { opacity: 1; }
      .pin-btn:hover { border-color: var(--ink); color: var(--ink); }
      .pin-btn.is-pinned { color: var(--paper); background: var(--ink); border-color: var(--ink); }

      .rank-cards { display: none; list-style: none; }
      .rank-card { border-bottom: 1px solid var(--rule); }
      .rank-card:last-child { border-bottom: 0; }
      .rank-card-main { display: flex; align-items: center; gap: 9px; padding: 10px 14px; }
      .rank-card-main:hover { text-decoration: none; background: var(--paper-3); }
      .rank-card-name { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
      .rank-card-name .name { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .rank-card-score { font-family: var(--mono); font-weight: 500; font-size: 15px; }
      .rank-card-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 3px 14px;
        padding: 0 14px 10px 49px;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-2);
      }
      .rank-card-stats em { font-style: normal; color: var(--ink-3); margin-right: 4px; }

      /* ── 首页：测量台 ─────────────────────────────────────── */
      .measure-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 28px;
        align-items: end;
        padding-bottom: 14px;
      }
      .measure-head .display { margin: 10px 0 12px; }
      .readout {
        display: grid;
        grid-template-columns: repeat(5, auto);
        gap: 0;
        border: 1px solid var(--rule);
        background: var(--paper-2);
      }
      .readout div {
        padding: 10px 14px;
        border-right: 1px solid var(--rule);
        text-align: right;
      }
      .readout div:last-child { border-right: 0; }
      .readout dt, .readout span[data-k] {
        display: block;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .readout b {
        display: block;
        font-family: var(--mono);
        font-size: 17px;
        font-weight: 500;
        letter-spacing: -0.02em;
        margin-top: 2px;
      }

      /* 指标切换条：本站的主交互 */
      .metric-bar {
        display: flex;
        align-items: stretch;
        border: 1px solid var(--rule);
        background: var(--paper-2);
        margin-top: 16px;
      }
      .metric-bar > button {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        align-items: flex-start;
        padding: 10px 14px;
        border: 0;
        border-right: 1px solid var(--rule);
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
        text-align: left;
      }
      .metric-bar > button:last-child { border-right: 0; }
      .metric-bar > button:hover { background: var(--paper-3); color: var(--ink); }
      .metric-bar > button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
      .metric-bar .m-label {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
      .metric-bar .m-hint { font-size: 11.5px; opacity: 0.7; }
      .metric-bar > button[aria-pressed='true'] .m-hint { opacity: 0.85; }

      /* 双榜并列：两列账簿 */
      .board-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        border: 1px solid var(--rule);
        background: var(--rule);
      }
      .board-col { background: var(--paper-2); }
      .board-col + .board-col { border-left: 1px solid var(--rule); }
      .board-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 14px;
        border-bottom: 1px solid var(--rule);
        background: var(--paper-3);
      }
      .board-title {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
        font-weight: 500;
      }
      .board-title span { color: var(--ink-3); letter-spacing: 0.06em; }
      .board-row {
        display: grid;
        grid-template-columns: 2.2rem 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 7px 14px;
        border-bottom: 1px solid var(--rule);
        font-size: 14px;
      }
      .board-row:last-child { border-bottom: 0; }
      .board-row:hover { background: var(--paper-3); }
      .board-rank { font-family: var(--mono); font-size: 12px; color: var(--ink-3); }
      .board-name { display: flex; align-items: center; gap: 8px; min-width: 0; }
      .board-name a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .board-val { font-family: var(--mono); font-size: 13.5px; text-align: right; display: flex; align-items: center; gap: 8px; }
      .board-foot {
        padding: 8px 14px;
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.05em;
        color: var(--ink-3);
        border-top: 1px solid var(--rule);
      }

      /* 尺度说明条：把「归一化」讲清楚 */
      .scale-strip {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        border: 1px solid var(--rule);
        border-top: 0;
        background: var(--paper-2);
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.05em;
        color: var(--ink-3);
        flex-wrap: wrap;
      }
      .scale-ramp {
        display: inline-flex;
        height: 6px;
        width: 120px;
        flex: none;
      }
      .scale-ramp i { flex: 1; }
      .scale-ramp i:nth-child(1) { background: var(--heat-1); }
      .scale-ramp i:nth-child(2) { background: var(--heat-2); }
      .scale-ramp i:nth-child(3) { background: var(--heat-3); }
      .scale-ramp i:nth-child(4) { background: var(--heat-4); }
      .scale-ramp i:nth-child(5) { background: var(--heat-5); }

      /* ── 首页选型 ─────────────────────────────────────────── */
      .picker-search {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid var(--rule);
      }
      .picker-search:focus-within { border-bottom-color: var(--ink); }
      .picker-search svg { color: var(--ink-3); flex: none; }
      .picker-input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: none;
        color: var(--ink);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.5;
        outline: none;
      }
      .picker-input::placeholder { color: var(--ink-4); }
      .picker-input::-webkit-search-cancel-button { display: none; }
      .picker-clear {
        border: 0;
        background: none;
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: 14px;
        cursor: pointer;
        padding: 0 2px;
      }
      .picker-clear:hover { color: var(--ink); }
      .picker-filters {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        padding: 10px 0;
        border-bottom: 1px solid var(--rule);
      }
      .chips { display: flex; flex-wrap: wrap; gap: 3px; }
      .chip {
        padding: 2px 8px;
        border: 1px solid transparent;
        background: none;
        color: var(--ink-2);
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.05em;
        line-height: 1.7;
        cursor: pointer;
      }
      .chip:hover { color: var(--ink); border-color: var(--rule-2); }
      .chip[aria-pressed='true'] { color: var(--paper); background: var(--ink); border-color: var(--ink); }
      .picker-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 8px 0;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 0.05em;
        color: var(--ink-3);
      }
      .picker-list { list-style: none; }
      .picker-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 8px 2px;
        border-bottom: 1px solid var(--rule);
      }
      .picker-list li:last-child .picker-item { border-bottom: 0; }
      .picker-item:hover { background: var(--paper-3); text-decoration: none; }
      .picker-item-main { display: flex; flex-direction: column; min-width: 0; flex: 1; }
      .picker-item-main .name { font-weight: 500; }
      .picker-item-meta {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-3);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .picker-item-score { font-family: var(--mono); font-size: 15px; font-weight: 500; min-width: 3rem; text-align: right; }
      .picker-empty { padding: 14px 2px; font-size: 12.5px; }
      .link-btn {
        border: 0;
        background: none;
        color: var(--ink);
        cursor: pointer;
        padding: 0 2px;
        font: inherit;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      /* ── 对比 ─────────────────────────────────────────────── */
      .cmp-pickers {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }
      .cmp-pick { display: flex; flex-direction: column; gap: 4px; padding: 10px 14px; background: var(--paper-2); }
      .cmp-pick-label {
        display: flex;
        align-items: baseline;
        gap: 7px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        color: var(--ink-3);
        text-transform: uppercase;
      }
      .cmp-pick-label i { font-style: normal; opacity: 0.6; letter-spacing: 0.06em; }
      .cmp-pick select {
        width: 100%;
        border: 0;
        border-bottom: 1px solid var(--rule-2);
        background: transparent;
        color: var(--ink);
        font-family: var(--sans);
        font-size: 14px;
        padding: 4px 0;
        outline: none;
        appearance: none;
        cursor: pointer;
      }
      .cmp-pick select:focus { border-bottom-color: var(--ink); }
      .cmp-presets {
        display: flex;
        align-items: center;
        gap: 3px;
        flex-wrap: wrap;
        margin-top: 10px;
        font-family: var(--mono);
        font-size: 10px;
        color: var(--ink-3);
      }
      .cmp-wrap { border: 1px solid var(--rule); margin-top: 16px; }
      .cmp-table { font-size: 13.5px; }
      .cmp-table th, .cmp-table td { padding: 8px 14px; }
      .cmp-metric {
        position: sticky;
        left: 0;
        z-index: 1;
        width: 128px;
        background: var(--paper-2);
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
        white-space: nowrap;
      }
      .cmp-table tbody tr:hover .cmp-metric { background: var(--paper-3); }
      .cmp-col { border-top: 0; text-align: left; }
      .cmp-head { display: flex; align-items: center; gap: 8px; }
      .cmp-head:hover { text-decoration: none; }
      .cmp-head .name { display: block; font-weight: 500; font-size: 14px; }
      .cmp-sub {
        display: block;
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .cmp-cell { font-family: var(--mono); }
      .cmp-cell.is-best { font-weight: 600; position: relative; }
      .cmp-cell.is-best::after {
        content: '';
        position: absolute;
        right: 6px;
        top: 50%;
        width: 3px;
        height: 3px;
        margin-top: -1.5px;
        background: var(--heat-4);
      }
      .cmp-dot { display: inline-block; width: 3px; height: 3px; background: var(--heat-4); margin-left: 5px; vertical-align: middle; }
      .cmp-foot { margin-top: 10px; font-family: var(--mono); font-size: 9.5px; color: var(--ink-3); }
      .cmp-empty { border: 1px dashed var(--rule-2); padding: 40px 20px; text-align: center; margin-top: 16px; }
      .cmp-empty h3 { margin: 10px 0 5px; font-size: 16px; }
      .cmp-empty .muted { font-size: 12.5px; max-width: 46ch; margin: 0 auto; }

      /* ── 形态卡片 ─────────────────────────────────────────── */
      .form-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
      .form-card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 14px;
        border: 1px solid var(--rule);
        background: var(--paper-2);
        min-height: 150px;
      }
      .form-card:hover { background: var(--paper-3); text-decoration: none; }
      .form-card .idx { font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; color: var(--ink-3); text-transform: uppercase; }
      .form-card h3 { font-size: 15px; display: flex; align-items: baseline; gap: 7px; }
      .form-card h3 em {
        font-style: normal;
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .form-card .fit { font-size: 12.5px; line-height: 1.5; color: var(--ink-2); }
      .form-card .mini {
        margin-top: auto;
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--ink-3);
        display: flex;
        flex-direction: column;
        gap: 1px;
      }
      .form-card .mini b { font-weight: 500; color: var(--ink-2); }
      .form-card .go { font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); }

      /* ── 引导条 ───────────────────────────────────────────── */
      .cta-band {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding: 16px;
        border: 1px solid var(--rule);
        background: var(--paper-3);
      }
      .cta-band h2 { font-size: 17px; letter-spacing: -0.02em; margin: 6px 0 4px; }
      .cta-band p { font-size: 13.5px; color: var(--ink-2); max-width: 60ch; }

      /* ── 详情页 ───────────────────────────────────────────── */
      .agent-hero {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) minmax(240px, 0.7fr);
        gap: 22px;
        align-items: start;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--rule);
      }
      .agent-hero h1 { margin: 6px 0 6px; display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
      .stat-rail { display: grid; }
      .stat-rail > div {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 14px;
        padding: 5px 0;
        border-bottom: 1px solid var(--rule);
      }
      .stat-rail > div:first-child { border-top: 1px solid var(--rule); }
      .stat-rail span[data-k] {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .stat-rail b { font-family: var(--mono); font-size: 14px; font-weight: 500; letter-spacing: -0.01em; }
      .cmd-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding: 8px 11px;
        border: 1px solid var(--rule-2);
        background: var(--paper-3);
      }
      .cmd-row code { border: 0; background: transparent; padding: 0; font-size: 13.5px; color: var(--ink); overflow-wrap: anywhere; }
      .cmd-row .btn { margin-left: auto; }
      .getstarted-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(230px, 0.6fr);
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
      }
      .getstarted-grid > div { background: var(--paper-2); padding: 16px; }
      .getstarted-grid h3 {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-3);
        font-weight: 500;
        margin-bottom: 10px;
      }
      .link-row { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
      .link-row a {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.05em;
        padding: 3px 8px;
        border: 1px solid var(--rule-2);
        color: var(--ink-2);
      }
      .link-row a:hover { border-color: var(--ink); color: var(--ink); text-decoration: none; }

      /* ── 版本区块 ─────────────────────────────────────────── */
      .ver-current { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
      .ver-current b {
        font-family: var(--mono);
        font-size: 22px;
        font-weight: 500;
        letter-spacing: -0.03em;
      }
      .ver-meta {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        color: var(--ink-3);
        border: 1px solid var(--rule-2);
        padding: 1px 6px;
      }
      .ver-release-head {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 12px;
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--ink-3);
      }
      .ver-release-head a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
      .release-notes {
        margin-top: 8px;
        padding-left: 12px;
        border-left: 2px solid var(--rule);
        font-family: var(--sans);
        font-size: 13px;
        line-height: 1.6;
        color: var(--ink-2);
        white-space: pre-wrap;
        max-height: 220px;
        overflow: auto;
      }
      .ver-history { list-style: none; display: grid; }
      .ver-history li {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 10px;
        padding: 5px 0;
        border-bottom: 1px solid var(--rule);
        font-family: var(--mono);
        font-size: 12px;
      }
      .ver-history li:last-child { border-bottom: 0; }
      .ver-history .v { font-weight: 500; }
      .ver-history .d { font-size: 10.5px; color: var(--ink-3); }

      /* ── 图表 ─────────────────────────────────────────────── */
      .bar-chart { list-style: none; display: grid; gap: 8px; }
      .bar-row {
        display: grid;
        grid-template-columns: minmax(0, 8em) 1fr 4em;
        align-items: center;
        gap: 12px;
        font-size: 12.5px;
      }
      .bar-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .bar-track { height: 5px; background: var(--paper-3); overflow: hidden; }
      .bar-fill { display: block; height: 100%; background: var(--ink-4); }
      .bar-fill.tone-default,
      .bar-fill.tone-accent { background: var(--heat-1); }
      .bar-fill.tone-success { background: var(--heat-2); }
      .bar-fill.tone-attention { background: var(--heat-3); }
      .bar-fill.tone-danger { background: var(--heat-5); }
      .bar-value { text-align: right; font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); }

      .line-chart { margin: 0; }
      .lc-grid-wrap { display: grid; grid-template-columns: 3.2em 1fr; height: var(--lc-height, 190px); }
      .lc-yaxis { position: relative; font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); }
      .lc-yaxis span { position: absolute; right: 8px; transform: translateY(-50%); white-space: nowrap; }
      .lc-canvas { position: relative; border-left: 1px solid var(--rule-2); border-bottom: 1px solid var(--rule-2); }
      .lc-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
      .lc-grid { stroke: var(--rule); stroke-width: 1; stroke-dasharray: 1 4; }
      .lc-line { fill: none; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
      .lc-line.tone-default,
      .lc-line.tone-accent { stroke: var(--heat-1); }
      .lc-line.tone-success { stroke: var(--heat-2); }
      .lc-line.tone-attention { stroke: var(--heat-3); }
      .lc-line.tone-danger { stroke: var(--heat-5); }
      .lc-area { stroke: none; opacity: 0.08; }
      .lc-area.tone-default,
      .lc-area.tone-accent { fill: var(--heat-1); }
      .lc-area.tone-success { fill: var(--heat-2); }
      .lc-area.tone-attention { fill: var(--heat-3); }
      .lc-area.tone-danger { fill: var(--heat-5); }
      .lc-dots { position: absolute; inset: 0; }
      .lc-dot {
        position: absolute;
        width: 4px;
        height: 4px;
        transform: translate(-50%, -50%);
        background: var(--heat-1);
        box-shadow: 0 0 0 1.5px var(--paper-2);
      }
      .lc-dot.tone-success { background: var(--heat-2); }
      .lc-dot.tone-attention { background: var(--heat-3); }
      .lc-dot.tone-danger { background: var(--heat-5); }
      .lc-xaxis { position: relative; height: 16px; margin: 6px 0 0 3.2em; font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); }
      .lc-xaxis span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
      .lc-xaxis span.is-first { transform: none; }
      .lc-xaxis span.is-last { transform: translateX(-100%); }
      .lc-legend {
        list-style: none;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin: 9px 0 0 3.2em;
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--ink-3);
      }
      .lc-legend li { display: inline-flex; align-items: center; gap: 5px; }
      .swatch { width: 6px; height: 6px; display: inline-block; background: var(--heat-1); }
      .swatch.tone-success { background: var(--heat-2); }
      .swatch.tone-attention { background: var(--heat-3); }
      .swatch.tone-danger { background: var(--heat-5); }
      .chart-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
      .chart-grid > * { background: var(--paper-2); }
      .pkg { overflow-wrap: anywhere; word-break: break-word; }

      /* ── 对比托盘 ─────────────────────────────────────────── */
      .pin-tray {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 50;
        border-top: 1px solid var(--ink);
        background: var(--paper-2);
      }
      .pin-tray-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 8px 28px;
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }
      .pin-tray-label {
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-3);
        flex: none;
      }
      .pin-tray-label b { color: var(--ink); font-weight: 600; }
      .pin-tray-list { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; flex: 1; min-width: 0; }
      .pin-tray-list li {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 2px 4px 2px 2px;
        border: 1px solid var(--rule-2);
        background: var(--paper-3);
        font-size: 13px;
      }
      .pin-name { max-width: 10em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .pin-x {
        border: 0;
        background: none;
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: 12px;
        line-height: 1;
        cursor: pointer;
        padding: 0 2px;
      }
      .pin-x:hover { color: var(--bad); }
      .pin-tray-actions { display: flex; align-items: center; gap: 10px; flex: none; }
      .pin-hint { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); }
      .pin-clear {
        border: 0;
        background: none;
        color: var(--ink-3);
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .pin-clear:hover { color: var(--ink); }

      /* ── 页脚 ─────────────────────────────────────────────── */
      .colophon { border-top: 1px solid var(--rule); padding: 20px 0 40px; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.04em; color: var(--ink-3); line-height: 1.7;}
      .colophon-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 28px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }
      .colophon b { color: var(--ink-2); font-weight: 500; }
      .colophon nav { display: flex; gap: 14px; flex-wrap: wrap; }
      .colophon a:hover { color: var(--ink); }

      /* ── 响应式 ───────────────────────────────────────────── */
      @media (max-width: 1080px) {
        .form-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .measure-head { grid-template-columns: 1fr; gap: 14px; }
        .readout { grid-template-columns: repeat(5, 1fr); }
      }
      @media (max-width: 900px) {
        .container, .topbar-inner, .colophon-inner, .pin-tray-inner { padding-left: 18px; padding-right: 18px; }
        .readout div { padding: 7px 10px; text-align: left; }
      }
      @media (max-width: 768px) {
        .container, .topbar-inner, .colophon-inner, .pin-tray-inner { padding-left: 14px; padding-right: 14px; }
        main { padding: 18px 0 56px; }
        .section { margin-top: 26px; }
        h1 { font-size: 24px; }
        .topnav a { padding: 6px 8px; font-size: 13.5px; }
        .topnav a i { display: none; }
        .snap-chip { display: none; }
        .hide-sm { display: none; }
        .pkg { max-width: 8.5em; }
        .grid { grid-template-columns: 1fr; }
        .grid.grid-4, .grid.grid-tight { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .grid.grid-tight .card { padding: 12px; }
        .grid.grid-tight .card .num { font-size: 20px; }
        .card { padding: 13px; }
        .box-body { padding: 13px; }
        .rank-table { display: none; }
        .rank-cards { display: block; }
        .rank-toolbar { gap: 12px; }
        .rank-toolbar-count { margin-left: 0; width: 100%; }
        .tabs { gap: 0; }
        .board-2 { grid-template-columns: 1fr; }
        .board-col + .board-col { border-left: 0; border-top: 1px solid var(--rule); }
        .metric-bar { flex-wrap: wrap; }
        .metric-bar > button { flex: 1 1 40%; border-bottom: 1px solid var(--rule); }
        .readout { grid-template-columns: repeat(3, 1fr); }
        .readout div { border-bottom: 1px solid var(--rule); }
        .bar-row { grid-template-columns: minmax(0, 5.4em) 1fr 3em; gap: 9px; font-size: 11.5px; }
        .lc-grid-wrap { height: 160px; }
        .picker-input { font-size: 14px; }
        .cmp-pickers { grid-template-columns: 1fr; }
        .cmp-metric { width: 70px; font-size: 9.5px; letter-spacing: 0.01em; }
        .cmp-table { font-size: 12.5px; }
        .cmp-table th, .cmp-table td { padding: 8px 6px; }
        .cmp-head { gap: 6px; }
        .cmp-head .name { font-size: 13px; }
        .getstarted-grid { grid-template-columns: 1fr; }
        .agent-hero { grid-template-columns: auto minmax(0, 1fr); gap: 14px; }
        .agent-hero .agent-hero-rail { grid-column: 1 / -1; }
        .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .form-card { padding: 11px; min-height: 0; }
        .form-card h3 { font-size: 14px; }
        .pin-tray-inner { padding-top: 6px; padding-bottom: 6px; }
        .pin-name { max-width: 6.5em; }
        .pin-clear { display: none; }
        body { padding-bottom: 64px; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'app.skip')}</a>

    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href={pathFor(lang, '/')} aria-label="AgentNews">
          <span class="brand-mark" aria-hidden="true">A</span>
          AgentNews
        </a>
        <nav class="topnav" aria-label={t(lang, 'app.tagline')}>
          {NAV.map((item) => (
            <a href={pathFor(lang, item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {t(lang, `nav.${item.key}`)}{lang === 'zh' && <i>{t(lang, `nav.${item.key}En`)}</i>}
            </a>
          ))}
        </nav>
        <div class="topbar-meta">
          <span class="snap-chip">{t(lang, 'app.snapshot').toUpperCase()} <b>{date}</b></span>
          <div class="segmented lang-switch" role="group" aria-label={t(lang, 'app.lang')}>
            <a href={swapLangPath(path, 'zh')} data-lang="zh" aria-current={lang === 'zh' ? 'page' : undefined}>中</a>
            <a href={swapLangPath(path, 'en')} data-lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          </div>
          <button class="theme-btn" id="theme-toggle" type="button" aria-label={t(lang, 'app.theme')} title={t(lang, 'app.theme')}>
            <svg class="icon-moon" width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M9.6 1.1a6.9 6.9 0 1 0 5.3 10.5A7.4 7.4 0 0 1 9.6 1.1Z" />
            </svg>
            <svg class="icon-sun" width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 11.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7ZM8 0a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 0Zm0 13.5a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 13.5ZM2.3 2.3a.75.75 0 0 1 1.06 0l.7.71a.75.75 0 0 1-1.06 1.06l-.7-.7a.75.75 0 0 1 0-1.07Zm9.64 9.64a.75.75 0 0 1 1.06 0l.7.7a.75.75 0 1 1-1.06 1.07l-.7-.71a.75.75 0 0 1 0-1.06ZM0 8a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1A.75.75 0 0 1 0 8Zm13.5 0a.75.75 0 0 1 .75-.75h1a.75.75 0 0 1 0 1.5h-1a.75.75 0 0 1-.75-.75ZM3 11.94a.75.75 0 0 1 0 1.06l-.7.7a.75.75 0 1 1-1.07-1.06l.71-.7a.75.75 0 0 1 1.06 0Zm9.64-9.64a.75.75 0 0 1 0 1.06l-.7.7A.75.75 0 0 1 10.88 3l.7-.7a.75.75 0 0 1 1.06 0Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <div class="container">
        {hasData ? (
          <slot />
        ) : (
          <div class="page-head">
            <span class="eyebrow">Index · Pending</span>
            <h1>{lang === 'en' ? 'Waiting for data' : '数据积累中'}</h1>
            <p class="lede">
              {lang === 'en'
                ? 'Snapshots are generated within 24 hours of the first run. No scores yet.'
                : '首次运行后 24 小时内自动生成快照。当前无评分数据。'}
            </p>
          </div>
        )}
      </div>
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <div>
          {t(lang, 'footer.line', {
            name: 'AgentNews',
            tagline: t(lang, 'app.tagline'),
            date,
            open: openCount,
            closed: rows.length - openCount,
          })}<br />
          {t(lang, 'footer.principles')}
        </div>
        <nav aria-label={t(lang, 'footer.method')}>
          <a href={pathFor(lang, '/about/')}>{t(lang, 'footer.method')}</a>
          <a href={pathFor(lang, '/changelog/')}>{t(lang, 'footer.changelog')}</a>
          <a href={pathFor(lang, '/archive/')}>{t(lang, 'footer.archive')}</a>
          <a href={pathFor(lang, '/security/')}>{t(lang, 'footer.security')}</a>
        </nav>
      </div>
    </footer>

    <PinTray client:idle meta={pinMeta} lang={lang} />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current =
          root.dataset.theme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('an-theme', next);
        } catch {}
      });

      document.addEventListener('click', (e) => {
        // 语言切换：记住选择，避免下次访问被自动跳转
        const langLink = e.target.closest('[data-lang]');
        if (langLink) {
          try {
            localStorage.setItem('an-lang', langLink.getAttribute('data-lang') || 'zh');
          } catch {}
          return;
        }
        const btn = e.target.closest('[data-copy]');
        if (!btn) return;
        const text = btn.getAttribute('data-copy') || '';
        const old = btn.textContent;
        const done = () => {
          btn.textContent = btn.getAttribute('data-copied') || 'Copied';
          setTimeout(() => (btn.textContent = old), 1200);
        };
        if (navigator.clipboard?.writeText) navigator.clipboard.writeText(text).then(done).catch(() => {});
      });
    </script>
  </body>
</html>
