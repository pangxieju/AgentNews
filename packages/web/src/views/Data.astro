---
import Base from '../layouts/Base.astro';
import { type Lang, pathFor, t } from '../i18n/dict';
import { loadLatestScores } from '../lib/data';
import { isListed } from '../lib/shared';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const en = lang === 'en';
const h = (p: string) => pathFor(lang, p);
const SITE = Astro.site?.toString().replace(/\/$/, '') ?? 'https://agentnews-c5h.pages.dev';

const data = loadLatestScores();
const date = data?.date ?? 'YYYY-MM-DD';
/* 列表口径统一：冻结形态与误分类条目不进任何导出/引用 */
const listed = (data?.rows ?? []).filter(isListed);
/* 快照文件按形态分组排列，直接切前 20 会全是 cli —— 按综合分取前 20 更有代表性 */
const rows = listed
  .slice()
  .sort(
    (a, b) =>
      (b.score ?? 0) - (a.score ?? 0) ||
      (a.rank_in_form ?? 999) - (b.rank_in_form ?? 999) ||
      a.slug.localeCompare(b.slug),
  );

/**
 * 只展出行级契约字段（不含 version / 时间戳 / 历史），
 * 页面体积可控，也避免把内部推断字段当成公开 API。
 */
const sample = rows.slice(0, 20).map((r) => ({
  slug: r.slug,
  name: r.name,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  rank_in_form: r.rank_in_form,
  delta_1d: r.delta_1d,
  delta_7d: r.delta_7d,
  growth_30d_pct: r.growth_30d_pct,
  data_level: r.data_level,
  metrics: {
    stars: r.metrics?.stars ?? null,
    forks: r.metrics?.forks ?? null,
    contributors: r.metrics?.contributors ?? null,
    installs: r.metrics?.installs ?? null,
    activity: r.metrics?.activity ?? null,
  },
}));
const sampleJson = JSON.stringify(sample, null, 1);

/* 引用格式样例：日期取当前快照日，路径保持模板形态 */
const citeAgent = `AgentNews (${date}). "<agent name>". AI Agent Index. Available at: ${SITE}/agent/<slug>/`;
const citeBoard = `AgentNews (${date}). "AI Agent Index - Open / All / Month board". Available at: ${SITE}/top/open/all/month/`;

const preStyle =
  'margin:0; padding:14px; background:var(--paper-3); border:1px solid var(--rule); overflow:auto; max-height:520px; font-size:11.5px; line-height:1.55; color:var(--ink-2);';
const citeStyle =
  'display:block; padding:12px 14px; background:var(--paper-3); border:1px solid var(--rule); font-size:13px; line-height:1.6; color:var(--ink); overflow-wrap:anywhere; white-space:pre-wrap;';
/* ── SEO / 结构化数据：数据页是 Dataset，可直接被语义化检索 ── */
const description = en
  ? `Download AgentNews snapshots (JSON, CSV), read the read-only API, cite the index or embed a live rank badge. Snapshot ${date}, score_version ${data?.version ?? '—'}, ${rows.length} listed agents.`
  : `下载 AgentNews 快照（JSON / CSV）、调用只读 API、引用榜单或嵌入实时徽章。快照 ${date}，score_version ${data?.version ?? '—'}，${rows.length} 个上榜条目。`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'AgentNews · AI Agent Index snapshots',
  description,
  url: `${SITE}/data/`,
  temporalCoverage: date,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'AgentNews', url: SITE },
  distribution: [
    { '@type': 'DataDownload', name: 'Latest scores (JSON)', contentUrl: `${SITE}/data/scores.json`, encodingFormat: 'application/json' },
    { '@type': 'DataDownload', name: 'Latest scores (CSV)', contentUrl: `${SITE}/data/scores.csv`, encodingFormat: 'text/csv' },
    { '@type': 'DataDownload', name: 'Snapshot dates (JSON)', contentUrl: `${SITE}/data/dates.json`, encodingFormat: 'application/json' },
  ],
};
---

<Base lang={lang} pageTitle={t(lang, 'data.title')} description={description} jsonLd={jsonLd}>
  <div class="page-head">
    <div class="crumbs"><a href={h('/')}>AgentNews</a><span>/</span><span>{t(lang, 'data.crumb')}</span></div>
    <span class="eyebrow">{t(lang, 'data.eyebrow')}</span>
    <h1>{t(lang, 'data.title')}</h1>
    <p class="lede">{t(lang, 'data.lede')}</p>
  </div>

  <section class="section" style="margin-top:22px">
    <div class="section-title">
      <h2>{en ? 'Download & API' : '下载与 API'}</h2>
      <span class="muted">{date} · score_version {data?.version ?? '—'}</span>
    </div>
    <div class="box">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>{en ? 'Format' : '格式'}</th>
              <th>URL</th>
              <th>{en ? 'Use for' : '用途'}</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>JSON</td><td><a href="/data/scores.json"><code>/data/scores.json</code></a></td><td>{en ? 'Latest snapshot, public field contract' : '最新快照，公开字段契约'}</td></tr>
            <tr><td>CSV</td><td><a href="/data/scores.csv"><code>/data/scores.csv</code></a></td><td>{en ? 'Spreadsheets, quick analysis' : '表格工具、快速分析'}</td></tr>
            <tr><td>API</td><td><a href="/api/v1/scores.json"><code>/api/v1/scores.json</code></a></td><td>{en ? 'Read-only endpoint, CORS enabled' : '只读接口，已开 CORS'}</td></tr>
            <tr><td>{en ? 'Dates' : '日期清单'}</td><td><a href="/data/dates.json"><code>/data/dates.json</code></a></td><td>{en ? 'Available snapshot dates' : '可用快照日期'}</td></tr>
            <tr><td>{en ? 'Archive' : '历史快照'}</td><td><code>/data/&#123;date&#125;/scores.json</code></td><td>{en ? 'Any past snapshot (same schema)' : '任意历史快照（同结构）'}</td></tr>
            <tr><td>RSS</td><td><a href="/feed.xml"><code>/feed.xml</code></a></td><td>{en ? 'Rank / release updates' : '排名与发版更新'}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="box-body">
        <pre style={preStyle}>curl -s {SITE}/api/v1/scores.json | jq '.rows[] | select(.rank_in_form == 1) | &#123;slug, score&#125;'</pre>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{en ? 'Embed badge' : '嵌入徽章'}</h2>
      <span class="muted">{en ? 'Live SVG · updates with each snapshot' : '实时 SVG · 随快照更新'}</span>
    </div>
    <div class="box">
      <div class="box-body">
        <p style="margin-bottom:10px;font-size:13px;color:var(--ink-2)">
          {en
            ? 'Project authors and media can embed the current rank. The badge links back to the agent page.'
            : '项目作者与媒体可嵌入当前名次，徽章会链接回详情页。'}
        </p>
        <pre style={preStyle}>&lt;img src="{SITE}/badge/{rows[0]?.slug ?? 'slug'}.svg" alt="AgentNews rank"&gt;</pre>
        <pre style={{ ...preStyle, marginTop: '10px' }}>[![AgentNews]({SITE}/badge/{rows[0]?.slug ?? 'slug'}.svg)]({SITE}/agent/{rows[0]?.slug ?? 'slug'}/)</pre>
        <p style="margin-top:10px;font-size:12px;color:var(--ink-3)">
          {en ? 'Pattern: ' : '地址规律：'}<code>{SITE}/badge/&#123;slug&#125;.svg</code>
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="margin-top:22px">
    <div class="section-title">
      <h2>{en ? 'Snapshot data' : '快照数据'}</h2>
      <span class="muted">{date}</span>
    </div>
    <div class="box">
      <div class="box-header">
        <span>{en ? 'Top 20 by score · field subset' : '综合分前 20 条 · 字段子集'}</span>
        <span class="mono subtle">{rows.length} {en ? 'listed rows' : '条上榜'}</span>
      </div>
      <div class="box-body">
        <p class="muted" style="margin:0 0 12px">
          {en
            ? 'Below: the top 20 listed agents of the latest snapshot, trimmed to the fields shown. It is a preview, not the full dataset.'
            : '下面是最新快照里综合分前 20 条上榜条目，只保留展示用到的字段。它是预览，不是完整数据集。'}
        </p>
        <pre class="mono" style={preStyle}>{sampleJson}</pre>
        <div class="notice" style="margin-top:14px">
          {en
            ? 'There is no download button: full snapshots are JSON files in the repository under data/scores/YYYY-MM-DD.json, not separate files served from this site. The repository is not public yet — once it is, this page will link straight to it.'
            : '这里没有下载按钮：完整快照就是仓库里的 data/scores/YYYY-MM-DD.json 文件，而不是本站单独发布的文件。仓库暂未公开，公开后本页会改成直达链接。'}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{en ? 'Citation' : '引用格式'}</h2>
      <span class="muted">{en ? 'name the snapshot date' : '必须写明快照日'}</span>
    </div>
    <div class="grid">
      <div class="box">
        <div class="box-header"><span>{en ? 'Single agent' : '单个 Agent'}</span></div>
        <div class="box-body">
          <code class="mono" style={citeStyle}>{citeAgent}</code>
        </div>
      </div>
      <div class="box">
        <div class="box-header"><span>{en ? 'Whole board' : '整榜单'}</span></div>
        <div class="box-body">
          <code class="mono" style={citeStyle}>{citeBoard}</code>
        </div>
      </div>
    </div>
    <div class="notice" style="margin-top:14px">
      {en
        ? 'Rankings move with every snapshot, so always keep the date and the original link. Replace <agent name> and <slug> with the entry you cite, and swap the board path for the one you used.'
        : '排名随快照变化，引用请保留日期与原链接。把 <agent name>、<slug> 换成你要引用的条目，榜单路径换成你实际使用的那一个。'}
    </div>
  </section>

  <section class="section" id="corrections">
    <div class="section-title">
      <h2>{en ? 'Corrections & claims' : '纠错与认领'}</h2>
      <span class="muted">{en ? '3 business days' : '3 个工作日内'}</span>
    </div>
    <div class="box">
      <div class="box-body muted">
        <p style="margin:0 0 10px">
          {en
            ? 'Wrong data, or you maintain a project listed here and want to claim it? Open a GitHub issue with the slug, the field and a source we can check.'
            : '数据有误，或者你是这里的项目维护者想认领条目？在 GitHub 提 issue，写明 slug、出错字段，以及一个可核验的来源。'}
        </p>
        <p style="margin:0 0 10px">
          <a href="https://github.com/" rel="nofollow noopener">{en ? 'Issue tracker (repository not public yet)' : 'Issue 入口（仓库暂未公开）'}</a>
          {en
            ? ' — the path after https://github.com/ becomes the repository link once it is public.'
            : ' —— 仓库公开后，https://github.com/ 之后的路径会换成真实的仓库地址。'}
        </p>
        <p style="margin:0 0 10px">
          {en
            ? 'Claims: include an official email or organisation page so we can verify identity before we change anything.'
            : '认领：请附官方邮箱或组织主页，我们核验身份后再改动条目。'}
        </p>
        <p style="margin:0">
          {en
            ? 'Correction SLA: a reply within 3 business days; accepted fixes ship in the next snapshot.'
            : '纠错 SLA：3 个工作日内回复；确认成立的纠错在下一个快照生效。'}
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{en ? 'Keep going' : '继续'}</h2>
    </div>
    <div class="grid">
      <div class="box">
        <div class="box-header"><span>{t(lang, 'footer.method')}</span></div>
        <div class="box-body">
          <p class="muted" style="margin:0 0 10px">
            {en
              ? 'How the score is computed, how open vs closed is decided, where the metrics come from and what is filtered out.'
              : '综合分怎么算、开源与闭源怎么判、指标来自哪里、哪些条目不参与排名。'}
          </p>
          <a class="btn" href={h('/about/')}>{t(lang, 'footer.method')}</a>
        </div>
      </div>
      <div class="box">
        <div class="box-header"><span>{t(lang, 'footer.rss')}</span></div>
        <div class="box-body">
          <p class="muted" style="margin:0 0 10px">
            {en
              ? 'RSS feed with the top 30 listed agents; it is rebuilt whenever a new snapshot is published.'
              : 'RSS 订阅：榜单前 30 条，新快照发布即更新。'}
          </p>
          <a class="btn" href="/feed.xml">{t(lang, 'footer.rss')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>