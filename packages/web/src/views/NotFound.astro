---
import Base from '../layouts/Base.astro';
import { pathFor, t, type Lang } from '../i18n/dict';
interface Props { lang: Lang }
const { lang } = Astro.props;
const H = (p: string) => pathFor(lang, p);
---
<Base lang={lang} pageTitle={t(lang, 'app.notFound')} description={t(lang, 'notfound.lede')} noindex>
  <div class="page-head">
    <span class="eyebrow">404</span>
    <h1>{t(lang, 'app.notFound')}</h1>
    <p class="lede">{t(lang, 'notfound.lede')}</p>
    <p style="margin-top:18px"><a class="btn" href={H('/')}>← {t(lang, 'app.home')}</a></p>
  </div>
</Base>