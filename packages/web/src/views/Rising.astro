---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import { loadLatestScores, loadAgentsMeta, loadAgentState, fmt } from '../lib/data';
import { type Lang, bucketText, formLabel, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const state = loadAgentState();
const startedAt = state?.started_at ?? '—';
const meta = loadAgentsMeta();

/** 新秀资格（PRD §5.6）：出道 ≤ 180 天 */
const NEWCOMER_DAYS = 180;

const newcomers = rows
  .filter((r) => r.age_days != null && r.age_days <= NEWCOMER_DAYS && r.score != null)
  .sort((a, b) => (b.score ?? 0) - (a.score ?? 0));

const youngest = [...rows]
  .filter((r) => r.age_days != null)
  .sort((a, b) => a.age_days! - b.age_days!)
  .slice(0, 10);

const bucketBadge = (b: string) => (b === 'open' ? 'b-open' : b === 'semi' ? 'b-semi' : 'b-closed');
---

<Base lang={lang} pageTitle={`${t(lang, 'rising.title')} · AgentNews`}>
  <div class="page-head">
    <div class="crumbs"><a href={h('/')}>AgentNews</a><span>/</span><span>{t(lang, 'rising.crumb')}</span></div>
    <span class="eyebrow">{lang === 'en' ? 'Rising · Age ≤ 180 days' : '新秀 · 出道 ≤ 180 天'}</span>
    <h1>{t(lang, 'rising.title')}</h1>
    <p class="lede">{t(lang, 'rising.lede', { days: NEWCOMER_DAYS, date })}</p>
  </div>

  <div class="warn">
    <strong>{lang === 'en' ? 'How age is measured: ' : '口径说明：'}</strong>
    {t(lang, 'rising.explain', { started: startedAt })}
  </div>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'rising.list')}</h2>
      <span class="counter">{newcomers.length}</span>
    </div>

    {newcomers.length > 0 ? (
      <div class="box">
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="pos">#</th><th>Agent</th><th>{lang === 'en' ? 'Form' : '形态'}</th>
                <th class="num">{t(lang, 'rising.age')}</th>
                <th class="num hide-sm">{t(lang, 'rising.firstListed')}</th>
                <th class="num">{t(lang, 'metric.score')}</th>
                <th class="num hide-sm">{t(lang, 'metric.stars')}</th>
                <th class="num hide-sm">{t(lang, 'metric.installs')}</th>
              </tr>
            </thead>
            <tbody>
              {newcomers.map((r, i) => (
                <tr>
                  <td class="pos">{i + 1}</td>
                  <td>
                    <div class="agent-cell">
                      <AgentIcon
                        slug={r.slug}
                        name={r.name ?? r.slug}
                        icon={meta[r.slug]?.icon}
                        iconFallback={meta[r.slug]?.iconFallback}
                        size={24}
                      />
                      <span class="tags">
                        <a class="name" href={h(`/agent/${r.slug}/`)}>{r.name}</a>
                        <span class={`badge ${bucketBadge(r.oss_bucket)}`}>{bucketText(lang, r.oss_bucket)}</span>
                      </span>
                    </div>
                  </td>
                  <td class="muted">{formLabel(lang, r.form)}</td>
                  <td class="num">{t(lang, 'rising.days', { n: r.age_days! })}</td>
                  <td class="num muted hide-sm">{r.first_listed ?? '—'}</td>
                  <td class="num"><strong>{r.score}</strong></td>
                  <td class="num hide-sm">{fmt(r.metrics?.stars)}</td>
                  <td class="num hide-sm">{fmt(r.metrics?.installs)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : (
      <div class="notice">{t(lang, 'rising.empty', { days: NEWCOMER_DAYS })}</div>
    )}
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'rising.youngest')}</h2>
      <span class="muted">{t(lang, 'rising.youngestHint')}</span>
    </div>
    <div class="box">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="pos">#</th><th>Agent</th><th>{lang === 'en' ? 'Form' : '形态'}</th>
              <th class="num">{t(lang, 'rising.age')}</th>
              <th class="num hide-sm">{t(lang, 'rising.firstListed')}</th>
              <th class="num">{t(lang, 'metric.score')}</th>
            </tr>
          </thead>
          <tbody>
            {youngest.map((r, i) => (
              <tr>
                <td class="pos">{i + 1}</td>
                <td>
                  <div class="agent-cell">
                    <AgentIcon
                      slug={r.slug}
                      name={r.name ?? r.slug}
                      icon={meta[r.slug]?.icon}
                      iconFallback={meta[r.slug]?.iconFallback}
                      size={24}
                    />
                    <a class="name" href={h(`/agent/${r.slug}/`)}>{r.name}</a>
                  </div>
                </td>
                <td class="muted">{formLabel(lang, r.form)}</td>
                <td class="num">{t(lang, 'rising.days', { n: r.age_days! })}</td>
                <td class="num muted hide-sm">{r.first_listed ?? '—'}</td>
                <td class="num">{r.score ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>