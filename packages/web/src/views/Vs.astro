---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import { loadLatestScores, loadAgentsMeta, fmt, fmtPct } from '../lib/data';
import { planFor } from '../lib/plans';
import { isListed } from '../lib/shared';
import { buildGroupBoard } from '../lib/group';
import { type Lang, bucketText, formLabel, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
  aSlug: string;
  bSlug: string;
}
const { lang, aSlug, bSlug } = Astro.props;
const en = lang === 'en';
const H = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const date = data?.date ?? '—';
const rows = (data?.rows ?? []).filter(isListed);
const meta = loadAgentsMeta();
const a = rows.find((r) => r.slug === aSlug);
const b = rows.find((r) => r.slug === bSlug);
const SITE = Astro.site ?? new URL('https://agentnews-c5h.pages.dev');

const label = (r: typeof a) => r?.name ?? r?.slug ?? '—';
const planA = a ? planFor(a.slug, meta[a.slug]?.license, meta[a.slug]?.homepage) : null;
const planB = b ? planFor(b.slug, meta[b.slug]?.license, meta[b.slug]?.homepage) : null;

const sameForm = !!a && !!b && a.form === b.form;
const form = a?.form ?? b?.form ?? '';

type Row = { key: string; label: string; a: string; b: string; better?: 'a' | 'b' | null };
const betterHigh = (x: number | null | undefined, y: number | null | undefined): 'a' | 'b' | null => {
  if (x == null || y == null || x === y) return null;
  return x > y ? 'a' : 'b';
};
const betterLow = (x: number | null | undefined, y: number | null | undefined): 'a' | 'b' | null => {
  if (x == null || y == null || x === y) return null;
  return x < y ? 'a' : 'b';
};

const installNote = (r: typeof a) =>
  r?.flags?.includes('store_installs') ? (en ? ' (store total)' : '（商店累计）') : '';

const rowsTable: Row[] = [];
if (a && b) {
  rowsTable.push({
    key: 'score',
    label: t(lang, 'metric.score'),
    a: a.score != null ? String(a.score) : '—',
    b: b.score != null ? String(b.score) : '—',
    better: betterHigh(a.score, b.score),
  });
  rowsTable.push({
    key: 'rank',
    label: t(lang, 'metric.rank'),
    a: a.rank_in_form != null ? `#${a.rank_in_form}` : '—',
    b: b.rank_in_form != null ? `#${b.rank_in_form}` : '—',
    better: betterLow(a.rank_in_form, b.rank_in_form),
  });
  rowsTable.push({
    key: 'stars',
    label: t(lang, 'metric.stars'),
    a: a.metrics?.stars != null ? fmt(a.metrics.stars) : '—',
    b: b.metrics?.stars != null ? fmt(b.metrics.stars) : '—',
    better: betterHigh(a.metrics?.stars, b.metrics?.stars),
  });
  rowsTable.push({
    key: 'installs',
    label: t(lang, 'metric.installs'),
    a: a.metrics?.installs != null ? fmt(a.metrics.installs) + installNote(a) : '—',
    b: b.metrics?.installs != null ? fmt(b.metrics.installs) + installNote(b) : '—',
    better: betterHigh(a.metrics?.installs, b.metrics?.installs),
  });
  rowsTable.push({
    key: 'd7',
    label: t(lang, 'metric.delta7dInstalls'),
    a: a.installs_delta_7d != null ? (a.installs_delta_7d > 0 ? '+' : '') + fmt(a.installs_delta_7d) : '—',
    b: b.installs_delta_7d != null ? (b.installs_delta_7d > 0 ? '+' : '') + fmt(b.installs_delta_7d) : '—',
    better: betterHigh(a.installs_delta_7d, b.installs_delta_7d),
  });
  rowsTable.push({
    key: 'activity',
    label: t(lang, 'metric.activity'),
    a: a.metrics?.activity != null ? a.metrics.activity.toFixed(2) : '—',
    b: b.metrics?.activity != null ? b.metrics.activity.toFixed(2) : '—',
    better: betterHigh(a.metrics?.activity, b.metrics?.activity),
  });
  rowsTable.push({
    key: 'license',
    label: t(lang, 'metric.license'),
    a: meta[a.slug]?.license ?? '—',
    b: meta[b.slug]?.license ?? '—',
  });
  rowsTable.push({ key: 'free', label: en ? 'Free tier' : '免费版', a: planA?.free ?? '—', b: planB?.free ?? '—' });
  const priceText = (p: typeof planA) =>
    !p
      ? '—'
      : p.confidence !== 'verified' || p.price_monthly == null
        ? en
          ? 'Unverified'
          : '未核验'
        : p.price_monthly === 0
          ? en
            ? '$0 (self-host)'
            : '$0（自托管）'
          : `$${p.price_monthly}/mo`;
  rowsTable.push({
    key: 'price',
    label: en ? 'Starts at' : '起步价',
    a: priceText(planA),
    b: priceText(planB),
    better:
      planA?.confidence === 'verified' &&
      planB?.confidence === 'verified' &&
      planA.price_monthly != null &&
      planB.price_monthly != null
        ? betterLow(planA.price_monthly, planB.price_monthly)
        : null,
  });
  rowsTable.push({ key: 'selfhost', label: en ? 'Self-host' : '自托管', a: planA?.self_host ?? '—', b: planB?.self_host ?? '—' });
  rowsTable.push({
    key: 'release',
    label: t(lang, 'metric.release'),
    a: a.metrics?.last_release ? String(a.metrics.last_release).slice(0, 10) : '—',
    b: b.metrics?.last_release ? String(b.metrics.last_release).slice(0, 10) : '—',
  });
}

/* 事实型结论：只陈述数据，不给能力评价 */
const facts: string[] = [];
if (a && b) {
  if (a.score != null && b.score != null && a.score !== b.score) {
    const lead = a.score > b.score ? a : b;
    const other = lead === a ? b : a;
    facts.push(
      en
        ? `${label(lead)} leads the in-form score (${lead.score} vs ${other.score}).`
        : `${label(lead)} 组内综合分领先（${lead.score} vs ${other.score}）。`,
    );
  }
  if (a.metrics?.installs != null && b.metrics?.installs != null) {
    const lead = a.metrics.installs > b.metrics.installs ? a : b;
    const other = lead === a ? b : a;
    facts.push(
      en
        ? `${label(lead)} has more installs (${fmt(lead.metrics.installs)} vs ${fmt(other.metrics.installs)}).`
        : `${label(lead)} 安装量更高（${fmt(lead.metrics.installs)} vs ${fmt(other.metrics.installs)}）。`,
    );
  }
  if (a.installs_delta_7d != null && b.installs_delta_7d != null) {
    const lead = a.installs_delta_7d > b.installs_delta_7d ? a : b;
    const other = lead === a ? b : a;
    facts.push(
      en
        ? `${label(lead)} grew faster over 7 days (${fmt(lead.installs_delta_7d)} vs ${fmt(other.installs_delta_7d)} installs).`
        : `${label(lead)} 近 7 天安装增量更大（${fmt(lead.installs_delta_7d)} vs ${fmt(other.installs_delta_7d)}）。`,
    );
  }
  if (
    planA?.confidence === 'verified' &&
    planB?.confidence === 'verified' &&
    planA.price_monthly != null &&
    planB.price_monthly != null &&
    planA.price_monthly !== planB.price_monthly
  ) {
    const cheaper = planA.price_monthly < planB.price_monthly ? a : b;
    const cheapPlan = cheaper === a ? planA : planB;
    facts.push(
      en
        ? `${label(cheaper)} has the lower entry price ($${cheapPlan.price_monthly}/mo).`
        : `${label(cheaper)} 起步价更低（$${cheapPlan.price_monthly}/月）。`,
    );
  }
}

const title = a && b ? `${label(a)} vs ${label(b)}` : en ? 'Comparison' : '对比';
const description =
  a && b
    ? en
      ? `${label(a)} vs ${label(b)} — ${formLabel(lang, a.form)} comparison: score, stars, installs, 7-day install growth, activity, license, free tier, price and self-hosting. Snapshot ${date}.`
      : `${label(a)} vs ${label(b)}：${formLabel(lang, a.form)} 内对比综合分、Star、安装量、7 天安装增量、活跃度、License、免费版、价格与自托管。快照 ${date}。`
    : title;

const jsonLd = a && b
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        description,
        url: new URL(H(`/vs/${[a.slug, b.slug].sort().join('-vs-')}/`), SITE).href,
        about: [a.slug, b.slug].map((slug) => {
          const r = slug === a.slug ? a : b;
          return { '@type': 'SoftwareApplication', name: label(r), applicationCategory: 'DeveloperApplication' };
        }),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'AgentNews', item: SITE.href },
          { '@type': 'ListItem', position: 2, name: formLabel(lang, form), item: new URL(H(`/forms/${form}/`), SITE).href },
        ],
      },
    ]
  : undefined;
---

<Base lang={lang} pageTitle={title} description={description} jsonLd={jsonLd} noindex={!a || !b || !sameForm}>
  {!a || !b || !sameForm ? (
    <div class="page-head"><h1>{t(lang, 'app.notFound')}</h1></div>
  ) : (
    <>
      <div class="crumbs">
        <a href={H('/')}>AgentNews</a><span>/</span>
        <a href={H(`/forms/${form}/`)}>{formLabel(lang, form)}</a>
      </div>
      <div class="page-head">
        <span class="eyebrow">{en ? 'Comparison · same form' : '对比 · 同形态'}</span>
        <h1 style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
          <AgentIcon slug={a.slug} name={label(a)} icon={meta[a.slug]?.icon} iconFallback={meta[a.slug]?.iconFallback} size={40} />
          {label(a)}
          <span class="muted" style="font-size:18px">vs</span>
          <AgentIcon slug={b.slug} name={label(b)} icon={meta[b.slug]?.icon} iconFallback={meta[b.slug]?.iconFallback} size={40} />
          {label(b)}
        </h1>
        <p class="lede">
          {en
            ? `Both are ${formLabel(lang, form)} products, ranked in separate ${bucketText(lang, a.oss_bucket)} / ${bucketText(lang, b.oss_bucket)} namespaces. Facts below, no capability verdict.`
            : `两者都属于${formLabel(lang, form)}，分别位于${bucketText(lang, a.oss_bucket)} / ${bucketText(lang, b.oss_bucket)} 命名空间。以下只列事实，不做能力裁决。`}
        </p>
        <p style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn btn-primary" href={`${H('/compare/')}?a=${a.slug}&b=${b.slug}`}>
            {en ? 'Open interactive compare' : '打开交互对比'}
          </a>
          <a class="btn" href={H(`/agent/${a.slug}/`)}>{label(a)} →</a>
          <a class="btn" href={H(`/agent/${b.slug}/`)}>{label(b)} →</a>
        </p>
      </div>

      {facts.length > 0 && (
        <section class="section">
          <div class="section-title"><h2>{en ? 'What the data says' : '数据怎么说'}</h2></div>
          <div class="box">
            <div class="box-body">
              <ul style="margin:0;padding-left:18px;font-size:13.5px;line-height:1.8">
                {facts.map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </div>
        </section>
      )}

      <section class="section">
        <div class="section-title">
          <h2>{en ? 'Side by side' : '逐项对比'}</h2>
          <span class="muted">{date}</span>
        </div>
        <div class="box">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>{en ? 'Metric' : '指标'}</th>
                  <th class="num">{label(a)}</th>
                  <th class="num">{label(b)}</th>
                </tr>
              </thead>
              <tbody>
                {rowsTable.map((row) => (
                  <tr>
                    <td>{row.label}</td>
                    <td class={`num ${row.better === 'a' ? 'up' : ''}`}>{row.a}{row.better === 'a' ? ' ▲' : ''}</td>
                    <td class={`num ${row.better === 'b' ? 'up' : ''}`}>{row.b}{row.better === 'b' ? ' ▲' : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="muted" style="font-size:11.5px;margin-top:10px">
          {en
            ? '▲ marks the better value in this row. Installs may use store totals (VS Code / JetBrains); see the flag legend in Method.'
            : '▲ 表示该行更优。安装量可能为商店累计口径（VS Code / JetBrains），详见 Method 的标记图例。'}
        </p>
      </section>

      <section class="section">
        <div class="section-title"><h2>{en ? 'Keep going' : '继续看'}</h2></div>
        <p style="display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn" href={H(`/agent/${a.slug}/`)}>{label(a)} · {en ? 'full profile' : '完整详情'}</a>
          <a class="btn" href={H(`/agent/${b.slug}/`)}>{label(b)} · {en ? 'full profile' : '完整详情'}</a>
          <a class="btn" href={H(`/forms/${form}/`)}>{formLabel(lang, form)} · {en ? 'guide' : '形态指南'}</a>
          <a class="btn" href={H('/data/')}>{en ? 'Download the data' : '下载数据'}</a>
        </p>
      </section>
    </>
  )}
</Base>