---
import Base from '../layouts/Base.astro';
import { type Lang, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = (p: string) => pathFor(lang, p);

const weights: Array<[string, string]> = [
  [t(lang, 'about.w1'), '20%'],
  [t(lang, 'about.w2'), '25%'],
  [t(lang, 'about.w3'), '15%'],
  [t(lang, 'about.w4'), '20%'],
  [t(lang, 'about.w5'), '10%'],
  [t(lang, 'about.w6'), '5%'],
  [t(lang, 'about.w7'), '5%'],
];
---

<Base lang={lang} pageTitle={`${t(lang, 'about.title')} · AgentNews`}>
  <div class="page-head">
    <div class="crumbs"><a href={h('/')}>AgentNews</a><span>/</span><span>{t(lang, 'about.crumb')}</span></div>
    <span class="eyebrow">{lang === 'en' ? 'Method · Weights & Rules' : '口径 · 权重与规则'}</span>
    <h1>{t(lang, 'about.title')}</h1>
    <p class="lede">{t(lang, 'about.lede')}</p>
  </div>

  <div class="grid" style="margin-top:0">
    <div class="box">
      <div class="box-header">{t(lang, 'about.score')}</div>
      <div class="box-body muted">
        <ol style="padding-left:20px">
          <li>{t(lang, 'about.step1')}</li>
          <li>{t(lang, 'about.step2')}</li>
          <li>{t(lang, 'about.step3')}</li>
          <li>{t(lang, 'about.step4')}</li>
        </ol>
      </div>
    </div>
    <div class="box">
      <div class="box-header">{t(lang, 'about.weights')}</div>
      <div class="box-body muted">
        {weights.map(([label, pct]) => (
          <div class="spread"><span>{label}</span><span class="mono">{pct}</span></div>
        ))}
      </div>
    </div>
    <div class="box">
      <div class="box-header">{t(lang, 'about.oss')}</div>
      <div class="box-body muted">{t(lang, 'about.ossText')}</div>
    </div>
    <div class="box">
      <div class="box-header">{t(lang, 'about.sources')}</div>
      <div class="box-body muted">{t(lang, 'about.sourcesText')}</div>
    </div>
  </div>

  <section class="section">
    <div class="section-title"><h2>{t(lang, 'about.anti')}</h2></div>
    <div class="box">
      <div class="box-body muted">
        <ul style="padding-left:20px">
          <li>{t(lang, 'about.anti1')}</li>
          <li>{t(lang, 'about.anti2')}</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title"><h2>{t(lang, 'about.disclaimer')}</h2></div>
    <div class="box">
      <div class="box-body muted">{t(lang, 'about.disclaimerText')}</div>
    </div>
  </section>
</Base>