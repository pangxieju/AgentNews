---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import HomePicker, { type PickRow } from '../components/HomePicker';
import { loadLatestScores, loadAgentsMeta, fmtPct } from '../lib/data';
import { FORM_ORDER } from '../lib/shared';
import { FORM_GUIDES } from '../i18n/guides';
import { type Lang, formLabel, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const H = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const metaAll = loadAgentsMeta();

const meta: Record<string, { icon: string | null; iconFallback: string | null }> = {};
for (const r of rows) {
  const m = metaAll[r.slug];
  if (m) meta[r.slug] = { icon: m.icon, iconFallback: m.iconFallback };
}

const open = rows.filter((r) => r.oss_bucket !== 'closed');
const closed = rows.filter((r) => r.oss_bucket === 'closed');
const topOpen = [...open].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).slice(0, 6);
const topClosed = [...closed].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).slice(0, 6);
const hasGrowth = rows.some((r) => r.growth_30d_pct != null);

const guides = FORM_GUIDES[lang];
const formCards = FORM_ORDER.map((f, i) => {
  const list = rows.filter((r) => r.form === f);
  const ranked = [...list].filter((r) => r.score != null).sort((a, b) => (b.score ?? 0) - (a.score ?? 0));
  return {
    form: f,
    idx: String(i + 1).padStart(2, '0'),
    label: formLabel(lang, f),
    en: guides[f]?.en ?? '',
    fit: guides[f]?.tagline ?? '',
    count: list.length,
    top: ranked.slice(0, 2).map((r) => ({ name: r.name ?? r.slug, score: r.score })),
  };
}).filter((c) => c.count > 0);

const pick: PickRow[] = rows.map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  vendor: metaAll[r.slug]?.vendor ?? null,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  stars: r.metrics?.stars ?? null,
}));

const titleLines = t(lang, 'home.title').split('\n');
---

<Base lang={lang} pageTitle={t(lang, 'app.tagline')}>
  <div class="measure-head">
    <div>
      <span class="eyebrow">{t(lang, 'home.eyebrow', { date })}</span>
      <h1 class="display">
        {titleLines.map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </h1>
      <p class="lede">{t(lang, 'home.lede', { n: rows.length })}</p>
    </div>
    <div class="readout">
      <div><span data-k>{t(lang, 'home.readout.listed')}</span><b>{rows.length}</b></div>
      <div><span data-k>{t(lang, 'home.readout.open')}</span><b>{open.length}</b></div>
      <div><span data-k>{t(lang, 'home.readout.closed')}</span><b>{closed.length}</b></div>
      <div><span data-k>{t(lang, 'home.readout.forms')}</span><b>{formCards.length}</b></div>
      <div><span data-k>{t(lang, 'home.readout.ranked')}</span><b>{rows.filter((r) => r.rank_in_form != null).length}</b></div>
    </div>
  </div>
  <div class="ruler" aria-hidden="true"></div>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'home.step1')}</h2>
      <span class="muted">{t(lang, 'home.step1Hint')}</span>
    </div>
    <div class="form-grid">
      {formCards.map((c) => (
        <a class="form-card" href={H(`/forms/${c.form}/`)}>
          <span class="idx">{t(lang, 'home.formMeta', { idx: c.idx, n: c.count })}</span>
          <h3>{c.label}{c.en && c.en.toLowerCase() !== c.label.toLowerCase() && <em>{c.en}</em>}</h3>
          <p class="fit">{c.fit}</p>
          <div class="mini">
            {c.top.length === 0 && <span>{t(lang, 'home.noData')}</span>}
            {c.top.map((x, i) => (
              <span>{i === 0 ? '①' : '②'} <b>{x.name}</b> {x.score}</span>
            ))}
          </div>
          <span class="go">{t(lang, 'home.guide')}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'home.step2')}</h2>
      <span class="muted">{t(lang, 'home.step2Hint')}</span>
    </div>
    <HomePicker client:load items={pick} meta={meta} lang={lang} />
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'home.step3')}</h2>
      <span class="muted">{t(lang, 'home.step3Hint')}</span>
    </div>
    <div class="cta-band">
      <div>
        <span class="eyebrow">{t(lang, 'home.compareEyebrow')}</span>
        <h2>{t(lang, 'home.compareTitle')}</h2>
        <p>{t(lang, 'home.compareDesc')}</p>
      </div>
      <a class="btn btn-primary" href={H('/compare/')}>{t(lang, 'home.compareCta')}</a>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'home.board')}</h2>
      <span class="muted">{t(lang, 'home.boardHint', { date })}</span>
    </div>
    <div class="board-2">
      <div class="board-col">
        <div class="board-head">
          <span class="board-title">
            {t(lang, 'home.boardOpen')} <span>Open · {open.length}</span>
          </span>
          <a class="btn btn-sm" href={H('/top/open/all/month/')}>{t(lang, 'app.more')}</a>
        </div>
        {topOpen.map((r, i) => (
          <div class="board-row">
            <span class="board-rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="board-name">
              <AgentIcon
                slug={r.slug}
                name={r.name ?? r.slug}
                icon={meta[r.slug]?.icon}
                iconFallback={meta[r.slug]?.iconFallback}
                size={20}
              />
              <a href={H(`/agent/${r.slug}/`)}>{r.name ?? r.slug}</a>
            </span>
            <span class="board-val">
              {hasGrowth && <span class="muted" style="font-size:10px">{fmtPct(r.growth_30d_pct)}</span>}
              <b>{r.score ?? '—'}</b>
            </span>
          </div>
        ))}
        <div class="board-foot">{t(lang, 'home.boardOpenFoot')}</div>
      </div>

      <div class="board-col">
        <div class="board-head">
          <span class="board-title">
            {t(lang, 'home.boardClosed')} <span>Closed · {closed.length}</span>
          </span>
          <a class="btn btn-sm" href={H('/top/closed/all/month/')}>{t(lang, 'app.more')}</a>
        </div>
        {topClosed.map((r, i) => (
          <div class="board-row">
            <span class="board-rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="board-name">
              <AgentIcon
                slug={r.slug}
                name={r.name ?? r.slug}
                icon={meta[r.slug]?.icon}
                iconFallback={meta[r.slug]?.iconFallback}
                size={20}
              />
              <a href={H(`/agent/${r.slug}/`)}>{r.name ?? r.slug}</a>
            </span>
            <span class="board-val">
              {hasGrowth && <span class="muted" style="font-size:10px">{fmtPct(r.growth_30d_pct)}</span>}
              <b>{r.score ?? '—'}</b>
            </span>
          </div>
        ))}
        <div class="board-foot">{t(lang, 'home.boardClosedFoot')}</div>
      </div>
    </div>
    <div class="scale-strip">
      <span>{t(lang, 'home.scale')}</span>
      <span class="scale-ramp" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <span>{t(lang, 'home.scaleRange')}</span>
      <span style="margin-left:auto">{t(lang, 'home.scaleNote')}</span>
    </div>
  </section>
</Base>