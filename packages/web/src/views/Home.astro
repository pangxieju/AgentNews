---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import HomePicker, { type PickRow } from '../components/HomePicker';
import { loadLatestScores, loadAgentsMeta, loadEvents, type AgentEvent, fmtPct } from '../lib/data';
import { FOCUS_FORMS, isListed } from '../lib/shared';
import { FORM_GUIDES } from '../i18n/guides';
import { type Lang, formLabel, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const H = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const rows = data?.rows ?? [];
/** 列表范围：首页所有统计都只基于公开列表内的条目 */
const listedRows = rows.filter(isListed);
const date = data?.date ?? '—';
const metaAll = loadAgentsMeta();

const meta: Record<string, { icon: string | null; iconFallback: string | null }> = {};
for (const r of listedRows) {
  const m = metaAll[r.slug];
  if (m) meta[r.slug] = { icon: m.icon, iconFallback: m.iconFallback };
}

/** 只保留有分的条目，按综合分降序 */
function byScore<T extends { score: number | null }>(list: T[]): T[] {
  return list.filter((r) => r.score != null).sort((a, b) => (b.score ?? 0) - (a.score ?? 0));
}

const open = listedRows.filter((r) => r.oss_bucket !== 'closed');
const closed = listedRows.filter((r) => r.oss_bucket === 'closed');
const topOpen = byScore(open).slice(0, 5);
const topClosed = byScore(closed).slice(0, 5);
/** 闭源条目里暂无综合分（数据未接入）的数量 */
const closedPending = closed.filter((r) => r.score == null).length;
const hasGrowth = listedRows.some((r) => r.growth_30d_pct != null);

const rankedCount = listedRows.filter((r) => r.rank_in_form != null).length;

const guides = FORM_GUIDES[lang];
const formCards = FOCUS_FORMS.map((f, i) => {
  const list = listedRows.filter((r) => r.form === f);
  return {
    form: f,
    idx: String(i + 1).padStart(2, '0'),
    label: formLabel(lang, f),
    en: guides[f]?.en ?? '',
    fit: guides[f]?.tagline ?? '',
    count: list.length,
    top: byScore(list).slice(0, 3).map((r) => ({ name: r.name ?? r.slug, score: r.score })),
  };
});

const MARKERS = ['①', '②', '③'];

const pick: PickRow[] = listedRows.map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  vendor: metaAll[r.slug]?.vendor ?? null,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  stars: r.metrics?.stars ?? null,
}));

const titleLines = t(lang, 'home.title').split('\n');

/* ── 首页「最近动向」：取自 events 流水（跨天去重，小幅排名波动忽略） ── */
const recentEvents = (() => {
  const seen = new Set<string>();
  const out: AgentEvent[] = [];
  const listedSlugs = new Set(listedRows.map((r) => r.slug));
  for (const e of loadEvents()) {
    if (!listedSlugs.has(e.slug)) continue;
    if (e.kind === 'rank_jump' && Math.abs((e.from ?? 0) - (e.to ?? 0)) < 2) continue;
    if (seen.has(e.slug)) continue;
    seen.add(e.slug);
    out.push(e);
    if (out.length >= 6) break;
  }
  return out;
})();
const eventText = (e: AgentEvent): string => {
  const tail = e.detail?.includes('→') ? e.detail.split('→').pop()?.trim() : e.detail;
  switch (e.kind) {
    case 'version': return lang === 'en' ? `${e.name} updated to ${tail ?? ''}` : `${e.name} 更新到 ${tail ?? ''}`;
    case 'release': return lang === 'en' ? `${e.name} released ${tail ?? ''}` : `${e.name} 发布 ${tail ?? ''}`;
    case 'rank_jump': {
      const d = Math.abs((e.from ?? 0) - (e.to ?? 0));
      const dir = (e.from ?? 0) > (e.to ?? 0);
      return lang === 'en'
        ? `${e.name} moved ${dir ? 'down' : 'up'} ${d} ${d === 1 ? 'spot' : 'spots'}`
        : `${e.name} 排名${dir ? '下降' : '上升'} ${d} 位`;
    }
    case 'listed': return lang === 'en' ? `${e.name} newly listed` : `${e.name} 新上榜`;
    default: return e.title ?? e.name;
  }
};

/* ── SEO / 结构化数据 ── */
const SITE = Astro.site ?? new URL('https://agentnews-c5h.pages.dev');
const description =
  lang === 'en'
    ? `AI agent index: ${listedRows.length} agents across terminal, IDE plugin, AI IDE, desktop, browser, framework, platform and autonomous forms — with open/closed adoption data, percentile scores and weekly install deltas. Snapshot ${date}.`
    : `AI agent 索引：${listedRows.length} 个终端 / IDE 插件 / AI IDE / 桌面 / 浏览器 / 框架 / 平台 / 自主形态产品的开源与闭源采用度、组内分位分数与周安装增量。快照 ${date}。`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'AgentNews · AI Agent Index',
    url: SITE.href,
    inLanguage: lang === 'en' ? 'en' : 'zh-CN',
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'AgentNews',
    url: SITE.href,
    logo: new URL('/icon-512.png', SITE).href,
  },
];
---

<Base lang={lang} pageTitle={t(lang, 'app.tagline')} description={description} jsonLd={jsonLd}>
  <div class="measure-head">
    <div>
      <span class="eyebrow">{t(lang, 'home.eyebrow', { date })}</span>
      <h1 class="display">
        {titleLines.map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </h1>
      <p class="lede">{t(lang, 'home.lede', { n: listedRows.length })}</p>
    </div>
    <div class="readout">
      <div><span data-k>{t(lang, 'home.readout.listed')}</span><b>{listedRows.length}</b></div>
      <div><span data-k>{t(lang, 'home.readout.ranked')}</span><b>{rankedCount}</b></div>
      <div><span data-k>{t(lang, 'app.snapshot')}</span><b>{date}</b></div>
    </div>
  </div>
  <div class="ruler" aria-hidden="true"></div>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'home.step1')}</h2>
      <span class="muted">{t(lang, 'home.step1Hint')}</span>
    </div>
    <div class="form-grid">
      {formCards.map((c) => (
        <a class="form-card" href={H(`/forms/${c.form}/`)}>
          <span class="idx">{t(lang, 'home.formMeta', { idx: c.idx, n: c.count })}</span>
          <h3>{c.label}{c.en && c.en.toLowerCase() !== c.label.toLowerCase() && <em>{c.en}</em>}</h3>
          <p class="fit">{c.fit}</p>
          <div class="mini">
            {c.top.length === 0 && <span>{t(lang, 'home.noData')}</span>}
            {c.top.map((x, i) => (
              <span>{MARKERS[i] ?? `${i + 1}.`} <b>{x.name}</b> {x.score}</span>
            ))}
          </div>
          <span class="go">{t(lang, 'home.guide')}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'home.step2')}</h2>
      <span class="muted">{t(lang, 'home.step2Hint')}</span>
    </div>
    <HomePicker client:load items={pick} meta={meta} lang={lang} />
    <div class="row" style="margin-top:14px">
      <a class="btn btn-primary" href={H('/compare/')}>{t(lang, 'home.compareCta')}</a>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>{t(lang, 'home.board')}</h2>
      <span class="muted">{t(lang, 'home.boardHint', { date })}</span>
    </div>
    <div class="board-2">
      <div class="board-col">
        <div class="board-head">
          <span class="board-title">
            {t(lang, 'home.boardOpen')} <span>Open · {open.length}</span>
          </span>
          <a class="btn btn-sm" href={H('/top/open/all/month/')}>{t(lang, 'app.more')}</a>
        </div>
        {topOpen.map((r, i) => (
          <div class="board-row">
            <span class="board-rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="board-name">
              <AgentIcon
                slug={r.slug}
                name={r.name ?? r.slug}
                icon={meta[r.slug]?.icon}
                iconFallback={meta[r.slug]?.iconFallback}
                size={20}
              />
              <a href={H(`/agent/${r.slug}/`)}>{r.name ?? r.slug}</a>
            </span>
            <span class="board-val">
              {hasGrowth && <span class="muted" style="font-size:10px">{fmtPct(r.growth_30d_pct)}</span>}
              <b>{r.score ?? '—'}</b>
            </span>
          </div>
        ))}
        <div class="board-foot">{t(lang, 'home.boardOpenFoot')}</div>
      </div>

      <div class="board-col">
        <div class="board-head">
          <span class="board-title">
            {t(lang, 'home.boardClosed')} <span>Closed · {closed.length}</span>
          </span>
          <a class="btn btn-sm" href={H('/top/closed/all/month/')}>{t(lang, 'app.more')}</a>
        </div>
        {topClosed.map((r, i) => (
          <div class="board-row">
            <span class="board-rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="board-name">
              <AgentIcon
                slug={r.slug}
                name={r.name ?? r.slug}
                icon={meta[r.slug]?.icon}
                iconFallback={meta[r.slug]?.iconFallback}
                size={20}
              />
              <a href={H(`/agent/${r.slug}/`)}>{r.name ?? r.slug}</a>
            </span>
            <span class="board-val">
              {hasGrowth && <span class="muted" style="font-size:10px">{fmtPct(r.growth_30d_pct)}</span>}
              <b>{r.score ?? '—'}</b>
            </span>
          </div>
        ))}
        <div class="board-foot">
          {t(lang, 'home.boardClosedFoot')}
          {closedPending > 0 && <> · {t(lang, 'home.closedPending', { n: closedPending })}</>}
        </div>
      </div>
    </div>
  </section>

  {recentEvents.length > 0 && (
    <section class="section">
      <div class="section-title">
        <h2>{lang === 'en' ? 'Recent moves' : '最近动向'}</h2>
        <span class="muted">{lang === 'en' ? 'Version bumps, releases and rank moves' : '发版、版本更新与排名变动'}</span>
      </div>
      <div class="box">
        {recentEvents.map((e) => (
          <div style="display:flex;align-items:center;gap:10px;padding:9px 14px;border-bottom:1px solid var(--rule);font-size:13.5px">
            <AgentIcon
              slug={e.slug}
              name={meta[e.slug]?.name ?? e.name}
              icon={meta[e.slug]?.icon}
              iconFallback={meta[e.slug]?.iconFallback}
              size={20}
            />
            <a class="name" href={H(`/agent/${e.slug}/`)} style="font-weight:600;white-space:nowrap">
              {e.name}
            </a>
            <span class="muted" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{eventText(e)}</span>
            <span class="muted" style="margin-left:auto;font-size:11.5px;white-space:nowrap">{e.date}</span>
          </div>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  /* 首页形态卡片：8 种形态按 3 列排布（全局样式不在本次改动范围） */
  .form-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 768px) {
    .form-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
