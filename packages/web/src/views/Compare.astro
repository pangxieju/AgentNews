---
import Base from '../layouts/Base.astro';
import CompareBoard, { type CompareItem } from '../components/CompareBoard';
import { loadLatestScores, loadAgentsMeta } from '../lib/data';
import { type Lang, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const H = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const meta = loadAgentsMeta();
const items: CompareItem[] = (data?.rows ?? []).map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  rank_in_form: r.rank_in_form,
  stars: r.metrics?.stars ?? null,
  forks: r.metrics?.forks ?? null,
  contributors: r.metrics?.contributors ?? null,
  installs: r.metrics?.installs ?? null,
  activity: r.metrics?.activity ?? null,
  growth_30d_pct: r.growth_30d_pct,
  license: meta[r.slug]?.license ?? null,
  last_release: r.metrics?.last_release ?? null,
  version: r.metrics?.version ?? null,
  version_at: r.metrics?.version_at ?? null,
  data_level: r.data_level,
  icon: meta[r.slug]?.icon ?? null,
  iconFallback: meta[r.slug]?.iconFallback ?? null,
}));
---

<Base lang={lang} pageTitle={`${t(lang, 'compare.title')} · AgentNews`}>
  <div class="page-head">
    <div class="crumbs"><a href={H('/')}>AgentNews</a><span>/</span><span>{t(lang, 'compare.crumb')}</span></div>
    <span class="eyebrow">{t(lang, 'compare.eyebrow')}</span>
    <h1>{t(lang, 'compare.title')}</h1>
    <p class="lede">{t(lang, 'compare.lede')}</p>
  </div>

  <CompareBoard client:load items={items} lang={lang} />

  <noscript>
    <div class="notice" style="margin-top:16px">
      {t(lang, 'compare.noscript')}
      <a href={H('/top/open/all/month/')}>{t(lang, 'rank.crumb')}</a>.
    </div>
  </noscript>
</Base>