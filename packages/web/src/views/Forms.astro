---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import { loadLatestScores, loadAgentsMeta, fmt, fmtPct } from '../lib/data';
import { FORM_ORDER } from '../lib/shared';
import { FORM_GUIDES } from '../i18n/guides';
import { type Lang, bucketText, formLabel, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
  form: string;
}
const { lang, form } = Astro.props;
const H = (p: string) => pathFor(lang, p);
const guide = FORM_GUIDES[lang][form];

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const meta = loadAgentsMeta();

const list = rows.filter((r) => r.form === form).sort((a, b) => (b.score ?? -1) - (a.score ?? -1));
const openCount = list.filter((r) => r.oss_bucket !== 'closed').length;
const hasGrowth = list.some((r) => r.growth_30d_pct != null);
const top2 = list.filter((r) => r.score != null).slice(0, 2);
const others = FORM_ORDER.filter((f) => f !== form).map((f) => ({
  form: f,
  label: formLabel(lang, f),
  en: FORM_GUIDES[lang][f]?.en ?? '',
}));

const bucketBadge = (b: string) => (b === 'open' ? 'b-open' : b === 'semi' ? 'b-semi' : 'b-closed');
---

<Base lang={lang} pageTitle={`${formLabel(lang, form)} · AgentNews`}>
  {!guide ? (
    <div class="page-head"><h1>{t(lang, 'agent.notFound')}</h1></div>
  ) : (
    <>
      <div class="page-head">
        <div class="crumbs">
          <a href={H('/')}>AgentNews</a><span>/</span><span>{t(lang, 'forms.crumb')}</span>
        </div>
        <span class="eyebrow">{t(lang, 'forms.eyebrow', { en: guide.en })}</span>
        <h1>{formLabel(lang, form)}</h1>
        <p class="lede">{guide.tagline}</p>
      </div>

      <div class="grid" style="margin-top:0">
        <div class="card">
          <h2>{t(lang, 'forms.fit')}</h2>
          <ul class="guide-list">{guide.fit.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="card">
          <h2>{t(lang, 'forms.tradeoff')}</h2>
          <ul class="guide-list">{guide.tradeoff.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="card">
          <h2>{t(lang, 'forms.watch')}</h2>
          <div class="detail" style="font-size:13.5px;color:var(--ink-2);margin-top:10px">{guide.watch}</div>
        </div>
      </div>

      <section class="section">
        <div class="section-title">
          <h2>{t(lang, 'forms.board')}</h2>
          <span class="muted">{t(lang, 'forms.boardHint', { n: list.length, open: openCount, closed: list.length - openCount, date })}</span>
        </div>
        <div class="box">
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th class="pos">#</th><th>Agent</th><th class="hide-sm">{t(lang, 'metric.bucket')}</th>
                  <th class="num">{t(lang, 'metric.score')}</th><th class="num">{t(lang, 'metric.stars')}</th>
                  <th class="num hide-sm">{t(lang, 'metric.installs')}</th>
                  {hasGrowth && <th class="num">{t(lang, 'metric.growth30d')}</th>}
                  <th class="hide-sm">{t(lang, 'forms.version')}</th>
                  <th class="hide-sm">{t(lang, 'forms.release')}</th>
                </tr>
              </thead>
              <tbody>
                {list.map((r) => (
                  <tr>
                    <td class="pos">{r.rank_in_form ?? '—'}</td>
                    <td>
                      <div class="agent-cell">
                        <AgentIcon
                          slug={r.slug}
                          name={r.name ?? r.slug}
                          icon={meta[r.slug]?.icon}
                          iconFallback={meta[r.slug]?.iconFallback}
                          size={26}
                        />
                        <a class="name" href={H(`/agent/${r.slug}/`)}>{r.name ?? r.slug}</a>
                      </div>
                    </td>
                    <td class="hide-sm"><span class={`badge ${bucketBadge(r.oss_bucket)}`}>{bucketText(lang, r.oss_bucket)}</span></td>
                    <td class="num"><strong>{r.score ?? '—'}</strong></td>
                    <td class="num">{fmt(r.metrics?.stars)}</td>
                    <td class="num hide-sm">{fmt(r.metrics?.installs)}</td>
                    {hasGrowth && <td class="num">{fmtPct(r.growth_30d_pct)}</td>}
                    <td class="mono muted hide-sm" style="font-size:11px">
                      {r.metrics?.version ?? '—'}
                      {r.metrics?.version_at ? <span style="opacity:.6"> · {r.metrics.version_at.slice(0, 10)}</span> : ''}
                    </td>
                    <td class="mono muted hide-sm" style="font-size:11px">
                      {r.metrics?.last_release ? r.metrics.last_release.slice(0, 10) : '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {top2.length >= 2 && (
        <section class="section">
          <div class="cta-band">
            <div>
              <span class="eyebrow">Compare</span>
              <h2>{t(lang, 'forms.compareTitle')}</h2>
              <p>{t(lang, 'forms.compareDesc', { a: top2[0]!.name, b: top2[1]!.name })}</p>
            </div>
            <a class="btn btn-primary" href={`${H('/compare/')}?a=${top2[0]!.slug}&b=${top2[1]!.slug}`}>
              {t(lang, 'forms.compareCta')}
            </a>
          </div>
        </section>
      )}

      <section class="section">
        <div class="section-title">
          <h2>{t(lang, 'forms.others')}</h2>
          <span class="muted">{t(lang, 'forms.othersHint')}</span>
        </div>
        <div class="row" style="gap:10px">
          {others.map((o) => (
            <a class="btn btn-sm" href={H(`/forms/${o.form}/`)}>
              {o.label}
              {o.en && o.en.toLowerCase() !== o.label.toLowerCase() && (
                <span class="mono" style="opacity:.55">{o.en}</span>
              )}
            </a>
          ))}
        </div>
      </section>
    </>
  )}
</Base>