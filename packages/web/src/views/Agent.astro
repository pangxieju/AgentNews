---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import LineChart from '../components/charts/LineChart.astro';
import { loadLatestScores, loadSecurity, loadAgentsMeta, loadHistory, loadVersionHistory, fmt, fmtPct } from '../lib/data';
import { installInfo } from '../lib/shared';
import { type Lang, bucketText, formLabel, pathFor, t } from '../i18n/dict';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const H = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';

const row = rows.find((r) => r.slug === slug);
const sec = loadSecurity()?.subjects?.[slug];
const agentsMeta = loadAgentsMeta();
const meta = agentsMeta[slug];
const history = loadHistory(slug);
const starPts = history.filter((h) => h.stars != null).map((h) => ({ x: h.date, y: h.stars! }));
const scorePts = history.filter((h) => h.score != null).map((h) => ({ x: h.date, y: h.score! }));
const trendReady = starPts.length >= 2;
const versions = loadVersionHistory(slug);
const info = installInfo(meta?.sources ?? [], meta?.homepage ?? null);
const siblings = rows
  .filter((r) => r.form === row?.form && r.slug !== slug && r.score != null)
  .sort((a, b) => (b.score ?? 0) - (a.score ?? 0))
  .slice(0, 4);

const bucketBadge = (b: string) => (b === 'open' ? 'b-open' : b === 'semi' ? 'b-semi' : 'b-closed');
---

<Base lang={lang} pageTitle={row ? `${row.name ?? row.slug} · AgentNews` : t(lang, 'agent.notFound')}>
  {!row ? (
    <div class="page-head"><h1>{t(lang, 'agent.notFound')}</h1></div>
  ) : (
    <>
      <div class="crumbs">
        <a href={H('/')}>AgentNews</a><span>/</span>
        <a href={H(`/top/${row.oss_bucket === 'closed' ? 'closed' : 'open'}/all/month/`)}>{t(lang, 'agent.crumb')}</a>
        <span>/</span><span>{formLabel(lang, row.form)}</span>
      </div>

      <section class="agent-hero">
        <AgentIcon
          slug={row.slug}
          name={row.name ?? row.slug}
          icon={meta?.icon}
          iconFallback={meta?.iconFallback}
          size={84}
        />
        <div style="min-width:0">
          <span class="eyebrow">{formLabel(lang, row.form)}{meta?.vendor ? ` · ${meta.vendor}` : ''}</span>
          <h1 style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            {row.name ?? row.slug}
            <span class={`badge ${bucketBadge(row.oss_bucket)}`}>{bucketText(lang, row.oss_bucket)}</span>
          </h1>
          <p class="lede" style="font-size:13.5px">{t(lang, 'agent.lede', { date })}</p>
          {meta?.homepage && (
            <a class="btn" style="margin-top:14px" href={meta.homepage} target="_blank" rel="noopener">
              {t(lang, 'agent.homepage')}
            </a>
          )}
        </div>
        <aside class="agent-hero-rail">
          <div class="stat-rail">
            <div><span data-k>{t(lang, 'agent.statScore')}</span><b>{row.score ?? '—'}</b></div>
            <div>
              <span data-k>{t(lang, 'agent.statRank')}</span>
              <b>{row.rank_in_form != null ? `#${row.rank_in_form}` : '—'}</b>
            </div>
            <div>
              <span data-k>{t(lang, 'agent.statGrowth')}</span>
              <b class={row.growth_30d_pct != null ? (row.growth_30d_pct > 0 ? 'up' : 'down') : ''}>
                {fmtPct(row.growth_30d_pct)}
              </b>
            </div>
            <div><span data-k>{t(lang, 'agent.statLevel')}</span><b>{row.data_level}</b></div>
          </div>
        </aside>
      </section>

      <section class="section">
        <div class="section-title">
          <h2>{t(lang, 'agent.getStarted')}</h2>
          <span class="muted">{t(lang, 'agent.getStartedHint')}</span>
        </div>
        <div class="getstarted-grid">
          <div>
            <h3>{t(lang, 'agent.install')}</h3>
            {info.command ? (
              <div class="cmd-row">
                <code>{info.command}</code>
                <button
                  class="btn btn-sm"
                  type="button"
                  data-copy={info.command}
                  data-copied={t(lang, 'app.copied')}
                >
                  {t(lang, 'app.copy')}
                </button>
              </div>
            ) : (
              <p class="muted" style="font-size:13.5px">
                {t(lang, 'agent.noCommand', { channel: info.channel })}
              </p>
            )}
            <div class="link-row">
              {info.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
              ))}
            </div>
            {meta?.note && (
              <p class="muted" style="font-size:12.5px;margin-top:14px">
                {t(lang, 'agent.note')}：{meta.note}
              </p>
            )}
          </div>
          <div>
            <h3>{t(lang, 'agent.facts')}</h3>
            <div class="stat-rail" style="border-top:0">
              <div><span data-k>{t(lang, 'agent.channel')}</span><b style="font-size:12.5px">{info.channel}</b></div>
              <div><span data-k>{t(lang, 'agent.license')}</span><b style="font-size:12.5px">{meta?.license ?? '—'}</b></div>
              <div>
                <span data-k>{t(lang, 'agent.lastRelease')}</span>
                <b style="font-size:12.5px">
                  {row.metrics?.last_release ? row.metrics.last_release.slice(0, 10) : '—'}
                </b>
              </div>
              {row.metrics?.version && (
                <div>
                  <span data-k>{t(lang, 'agent.version')}</span>
                  <b style="font-size:12.5px" title={row.metrics.version_source ?? undefined}>
                    {row.metrics.version}
                    {row.metrics.version_at ? ` · ${row.metrics.version_at.slice(0, 10)}` : ''}
                  </b>
                </div>
              )}
              <div><span data-k>{t(lang, 'agent.level')}</span><b style="font-size:12.5px">{row.data_level}</b></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-title">
          <h2>{t(lang, 'agent.versions')}</h2>
          <span class="muted">
            {row.metrics?.version
              ? `${row.metrics.version}${row.metrics.version_source ? ' · ' + row.metrics.version_source : ''}`
              : t(lang, 'app.none')}
          </span>
        </div>
        {row.metrics?.version ? (
          <div class="getstarted-grid">
            <div>
              <h3>{t(lang, 'agent.versionLatest')}</h3>
              <div class="ver-current">
                <b>{row.metrics.version}</b>
                <span class="ver-meta">{row.metrics.version_source ?? 'unknown'}</span>
                {row.metrics.version_at && (
                  <span class="ver-meta">
                    {t(lang, 'agent.versionAt', { date: row.metrics.version_at.slice(0, 10) })}
                  </span>
                )}
              </div>
              {row.metrics.release_notes ? (
                <>
                  <div class="ver-release-head">
                    {row.metrics.release_tag && <code>{row.metrics.release_tag}</code>}
                    {row.metrics.release_url && (
                      <a href={row.metrics.release_url} target="_blank" rel="noopener">
                        {t(lang, 'agent.githubRelease')}
                      </a>
                    )}
                  </div>
                  <pre class="release-notes">{row.metrics.release_notes}</pre>
                </>
              ) : (
                <p class="muted" style="font-size:12.5px;margin-top:10px">{t(lang, 'agent.versionNoNotes')}</p>
              )}
            </div>
            <div>
              <h3>{t(lang, 'agent.versionHistory')}</h3>
              {versions.length > 0 ? (
                <ol class="ver-history">
                  {versions
                    .slice()
                    .reverse()
                    .map((v) => (
                      <li>
                        <span class="v">{v.version}</span>
                        <span class="d">
                          {v.date}
                          {v.version_at ? ` · ${v.version_at.slice(0, 10)}` : ''}
                        </span>
                      </li>
                    ))}
                </ol>
              ) : (
                <p class="muted" style="font-size:12.5px">{t(lang, 'agent.versionHistoryEmpty')}</p>
              )}
            </div>
          </div>
        ) : (
          <div class="notice">{t(lang, 'agent.versionMissing')}</div>
        )}
      </section>

      <section class="section">
        <div class="section-title">
          <h2>{t(lang, 'agent.trend')}</h2>
          <span class="muted">{t(lang, 'agent.trendHint', { n: history.length })}</span>
        </div>
        {trendReady ? (
          <div class="chart-grid">
            <div class="box">
              <div class="box-header">{t(lang, 'agent.starTrend')}</div>
              <div class="box-body">
                <LineChart series={[{ name: t(lang, 'chart.series.star'), points: starPts, tone: 'accent' }]} height={190} />
              </div>
            </div>
            <div class="box">
              <div class="box-header">{t(lang, 'agent.scoreTrend')}</div>
              <div class="box-body">
                <LineChart series={[{ name: t(lang, 'chart.series.score'), points: scorePts, tone: 'success' }]} height={190} />
              </div>
            </div>
          </div>
        ) : (
          <div class="notice">{t(lang, 'agent.trendEmpty', { date: history[0]?.date ?? date })}</div>
        )}
      </section>

      <section class="section">
        <div class="box">
          <div class="box-header">{t(lang, 'agent.metrics')}</div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>{t(lang, 'agent.metric')}</th>
                  <th class="num">{t(lang, 'metric.current')}</th>
                  <th class="num hide-sm">{t(lang, 'agent.delta1d')}</th>
                  <th class="num hide-sm">{t(lang, 'agent.delta7d')}</th>
                  <th class="num hide-sm">{t(lang, 'agent.delta30d')}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>{t(lang, 'metric.stars')}</td>
                  <td class="num">{fmt(row.metrics?.stars)}</td>
                  <td class="num hide-sm">{fmt(row.delta_1d)}</td>
                  <td class="num hide-sm">{fmt(row.delta_7d)}</td>
                  <td class="num hide-sm">{fmt(row.delta_30d)}</td>
                </tr>
                <tr><td>{t(lang, 'metric.forks')}</td><td class="num">{fmt(row.metrics?.forks)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
                <tr><td>{t(lang, 'metric.contributors')}</td><td class="num">{fmt(row.metrics?.contributors)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
                <tr><td>{t(lang, 'metric.installs')}</td><td class="num">{fmt(row.metrics?.installs)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
                <tr>
                  <td>{t(lang, 'agent.relGrowth')}</td><td class="num">—</td><td class="num">—</td>
                  <td class="num">{fmtPct(row.growth_7d_pct)}</td><td class="num">{fmtPct(row.growth_30d_pct)}</td>
                </tr>
                <tr>
                  <td>{t(lang, 'metric.activity')}</td>
                  <td class="num">{row.metrics?.activity != null ? row.metrics.activity.toFixed(2) : '—'}</td>
                  <td class="num">—</td><td class="num">—</td><td class="num">—</td>
                </tr>
                <tr>
                  <td>{t(lang, 'agent.version')}</td>
                  <td class="num mono" style="font-size:12px">
                    {row.metrics?.version ?? '—'}
                    {row.metrics?.version_at ? <span class="muted" style="opacity:.7"> · {row.metrics.version_at.slice(0, 10)}</span> : ''}
                  </td>
                  <td class="num">—</td><td class="num">—</td><td class="num">—</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {row.flags.includes('partial_data') && <div class="warn" style="margin-top:16px">{t(lang, 'agent.partial')}</div>}
      {row.data_level === 'L3' && <div class="warn" style="margin-top:16px">{t(lang, 'agent.l3')}</div>}

      {siblings.length > 0 && (
        <section class="section">
          <div class="section-title">
            <h2>{t(lang, 'agent.peers')}</h2>
            <span class="muted">{t(lang, 'agent.peersHint', { form: formLabel(lang, row.form) })}</span>
          </div>
          <div class="box">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th class="pos">#</th><th>Agent</th>
                    <th class="num">{t(lang, 'metric.score')}</th>
                    <th class="num">{t(lang, 'metric.stars')}</th>
                    <th class="num hide-sm">{t(lang, 'metric.installs')}</th>
                    <th class="num hide-sm">{t(lang, 'metric.growth30d')}</th>
                    <th class="hide-sm">{t(lang, 'metric.version')}</th>
                  </tr>
                </thead>
                <tbody>
                  {siblings.map((r) => (
                    <tr>
                      <td class="pos">{r.rank_in_form ?? '—'}</td>
                      <td>
                        <div class="agent-cell">
                          <AgentIcon
                            slug={r.slug}
                            name={r.name ?? r.slug}
                            icon={agentsMeta[r.slug]?.icon}
                            iconFallback={agentsMeta[r.slug]?.iconFallback}
                            size={24}
                          />
                          <a class="name" href={H(`/agent/${r.slug}/`)}>{r.name ?? r.slug}</a>
                        </div>
                      </td>
                      <td class="num"><strong>{r.score ?? '—'}</strong></td>
                      <td class="num">{fmt(r.metrics?.stars)}</td>
                      <td class="num hide-sm">{fmt(r.metrics?.installs)}</td>
                      <td class="num hide-sm">{fmtPct(r.growth_30d_pct)}</td>
                      <td class="mono muted hide-sm" style="font-size:11px">
                        {r.metrics?.version ?? '—'}
                        {r.metrics?.version_at ? <span style="opacity:.6"> · {r.metrics.version_at.slice(0, 10)}</span> : ''}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <div class="row" style="margin-top:14px;gap:10px">
            <a class="btn btn-sm" href={H(`/forms/${row.form}/`)}>
              {t(lang, 'agent.peersAll', { form: formLabel(lang, row.form) })}
            </a>
            <a class="btn btn-sm" href={`${H('/compare/')}?a=${row.slug}&b=${siblings[0]!.slug}`}>
              {t(lang, 'agent.peersCompare')}
            </a>
          </div>
        </section>
      )}

      <section class="section">
        <div class="section-title"><h2>{t(lang, 'agent.security')}</h2></div>
        {sec ? (
          <div class="card">
            <div class="detail" style="font-size:14px;color:var(--ink)">
              {lang === 'en' ? 'Package ' : '包 '}
              <a href={sec.url} target="_blank" rel="noopener"><code>{sec.package}</code></a>
              {lang === 'en' ? ` (${sec.ecosystem}) has ` : `（${sec.ecosystem}）在 OSV 上有 `}
              <strong>{sec.advisories}</strong>
              {lang === 'en' ? ' advisories on OSV.' : ' 条历史公告。'}
              {sec.malicious > 0 && (
                <span class="badge b-closed">{t(lang, 'agent.securityMalicious', { n: sec.malicious })}</span>
              )}
              {sec.latest && (
                <span>
                  {lang === 'en' ? ` Latest update ${sec.latest.slice(0, 10)}.` : ` 最近一条更新于 ${sec.latest.slice(0, 10)}。`}
                </span>
              )}
              <div style="margin-top:8px;color:var(--ink-3)">{t(lang, 'agent.securityNote')}</div>
            </div>
          </div>
        ) : (
          <div class="warn">{t(lang, 'agent.securityNone')}</div>
        )}
      </section>
    </>
  )}
</Base>