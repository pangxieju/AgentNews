---
import Base from '../../layouts/Base.astro';
import AgentIcon from '../../components/AgentIcon';
import LineChart from '../../components/charts/LineChart.astro';
import { loadLatestScores, loadSecurity, loadAgentsMeta, loadHistory, loadVersionHistory, fmt, fmtPct, formLabel } from '../../lib/data';
import { installInfo } from '../../lib/shared';

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';

// 静态生成：为每个已知 slug 生成页面
export function getStaticPaths() {
  const latest = loadLatestScores();
  const all = latest?.rows ?? [];
  return [...new Set(all.map((r) => r.slug))].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const row = rows.find((r) => r.slug === slug);
const sec = loadSecurity()?.subjects?.[slug];
const meta = loadAgentsMeta()[slug];
const history = loadHistory(slug);
const starPts = history.filter((h) => h.stars != null).map((h) => ({ x: h.date, y: h.stars! }));
const scorePts = history.filter((h) => h.score != null).map((h) => ({ x: h.date, y: h.score! }));
const trendReady = starPts.length >= 2;
const versions = loadVersionHistory(slug);
const info = installInfo(meta?.sources ?? [], meta?.homepage ?? null);
const siblings = rows
  .filter((r) => r.form === row?.form && r.slug !== slug && r.score != null)
  .sort((a, b) => (b.score ?? 0) - (a.score ?? 0))
  .slice(0, 4);
if (!row) {
  Astro.redirect('/top');
}

const bucketBadge = (b: string) => (b === 'open' ? 'b-open' : b === 'semi' ? 'b-semi' : 'b-closed');
const bucketText = (b: string) => (b === 'open' ? '开源' : b === 'semi' ? '半开源' : '闭源');
---

<Base pageTitle={row ? `${row.name ?? row.slug} · AgentNews` : '未找到'}>
  {row && (
    <>
      <div class="crumbs">
        <a href="/">AgentNews</a><span>/</span>
        <a href={`/top/${row.oss_bucket === 'closed' ? 'closed' : 'open'}/all/month/`}>榜单</a><span>/</span>
        <span>{formLabel(row.form)}</span>
      </div>

      <section class="agent-hero">
        <AgentIcon
          slug={row.slug}
          name={row.name ?? row.slug}
          icon={meta?.icon}
          iconFallback={meta?.iconFallback}
          size={84}
        />
        <div style="min-width:0">
          <span class="eyebrow">{formLabel(row.form)}{meta?.vendor ? ` · ${meta.vendor}` : ''}</span>
          <h1 style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            {row.name ?? row.slug}
            <span class={`badge ${bucketBadge(row.oss_bucket)}`}>{bucketText(row.oss_bucket)}</span>
          </h1>
          <p class="lede" style="font-size:13.5px">数据截至 {date} · 综合分在同形态组内归一化</p>
          {meta?.homepage && (
            <a class="btn" style="margin-top:14px" href={meta.homepage} target="_blank" rel="noopener">
              访问官网 ↗
            </a>
          )}
        </div>
        <aside class="agent-hero-rail">
          <div class="stat-rail">
            <div><span data-k>综合分</span><b>{row.score ?? '—'}</b></div>
            <div><span data-k>组内排名</span><b>{row.rank_in_form != null ? `#${row.rank_in_form}` : '—'}</b></div>
            <div>
              <span data-k>30d 增速</span>
              <b class={row.growth_30d_pct != null ? (row.growth_30d_pct > 0 ? 'up' : 'down') : ''}>{fmtPct(row.growth_30d_pct)}</b>
            </div>
            <div><span data-k>完整度</span><b>{row.data_level}</b></div>
          </div>
        </aside>
      </section>

      <section class="section">
        <div class="section-title">
          <h2>上手 / Get started</h2>
          <span class="muted">安装渠道与入口</span>
        </div>
        <div class="getstarted-grid">
          <div>
            <h3>安装 / 获取</h3>
            {info.command ? (
              <div class="cmd-row">
                <code>{info.command}</code>
                <button class="btn btn-sm" type="button" data-copy={info.command}>复制</button>
              </div>
            ) : (
              <p class="muted" style="font-size:13.5px">
                通过 {info.channel} 分发，没有可复制的命令行安装方式。
              </p>
            )}
            <div class="link-row">
              {info.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
              ))}
            </div>
            {meta?.note && (
              <p class="muted" style="font-size:12.5px;margin-top:14px">编辑备注：{meta.note}</p>
            )}
          </div>
          <div>
            <h3>关键事实</h3>
            <div class="stat-rail" style="border-top:0">
              <div><span data-k>分发渠道</span><b style="font-size:12.5px">{info.channel}</b></div>
              <div><span data-k>License</span><b style="font-size:12.5px">{meta?.license ?? '—'}</b></div>
              <div>
                <span data-k>最近发版</span>
                <b style="font-size:12.5px">{row.metrics?.last_release ? row.metrics.last_release.slice(0, 10) : '—'}</b>
              </div>
              {row.metrics?.version && (
                <div>
                  <span data-k>当前版本</span>
                  <b style="font-size:12.5px" title={row.metrics.version_source ?? undefined}>
                    {row.metrics.version}
                    {row.metrics.version_at ? ` · ${row.metrics.version_at.slice(0, 10)}` : ''}
                  </b>
                </div>
              )}
              <div><span data-k>数据完整度</span><b style="font-size:12.5px">{row.data_level}</b></div>
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-title">
          <h2>版本 / Releases</h2>
          <span class="muted">
            {row.metrics?.version
              ? `${row.metrics.version}${row.metrics.version_source ? ' · ' + row.metrics.version_source : ''}`
              : '未采集到版本'}
          </span>
        </div>
        {row.metrics?.version ? (
          <div class="getstarted-grid">
            <div>
              <h3>最新版本与更新说明</h3>
              <div class="ver-current">
                <b>{row.metrics.version}</b>
                <span class="ver-meta">{row.metrics.version_source ?? 'unknown'}</span>
                {row.metrics.version_at && (
                  <span class="ver-meta">发布于 {row.metrics.version_at.slice(0, 10)}</span>
                )}
              </div>
              {row.metrics.release_notes ? (
                <>
                  <div class="ver-release-head">
                    {row.metrics.release_tag && <code>{row.metrics.release_tag}</code>}
                    {row.metrics.release_url && (
                      <a href={row.metrics.release_url} target="_blank" rel="noopener">GitHub release ↗</a>
                    )}
                  </div>
                  <pre class="release-notes">{row.metrics.release_notes}</pre>
                </>
              ) : (
                <p class="muted" style="font-size:12.5px;margin-top:10px">
                  该渠道只发布版本号，未提供更新说明（npm / PyPI / 商店）。
                </p>
              )}
            </div>
            <div>
              <h3>版本记录</h3>
              {versions.length > 0 ? (
                <ol class="ver-history">
                  {versions
                    .slice()
                    .reverse()
                    .map((v) => (
                      <li>
                        <span class="v">{v.version}</span>
                        <span class="d">
                          {v.date}
                          {v.version_at ? ` · ${v.version_at.slice(0, 10)}` : ''}
                        </span>
                      </li>
                    ))}
                </ol>
              ) : (
                <p class="muted" style="font-size:12.5px">从下一次采集开始记录版本变化。</p>
              )}
            </div>
          </div>
        ) : (
          <div class="notice">
            未采集到版本信息：该 agent 可能只有 manual 渠道，或包名不在 npm / PyPI / VS Code 市场。
          </div>
        )}
      </section>

      <section class="section">
        <div class="section-title">
          <h2>趋势</h2>
          <span class="muted" style="font-size:12px">每日快照 · {history.length} 个数据点</span>
        </div>
        {trendReady ? (
          <div class="chart-grid">
            <div class="box">
              <div class="box-header">Star 走势</div>
              <div class="box-body">
                <LineChart series={[{ name: 'Star', points: starPts, tone: 'accent' }]} height={190} />
              </div>
            </div>
            <div class="box">
              <div class="box-header">综合分走势</div>
              <div class="box-body">
                <LineChart series={[{ name: '综合分', points: scorePts, tone: 'success' }]} height={190} />
              </div>
            </div>
          </div>
        ) : (
          <div class="notice">
            趋势图需要至少 2 天快照。当前首份快照为 <strong>{history[0]?.date ?? date}</strong>，
            下一次采集后即可看到折线。
          </div>
        )}
      </section>

      <section class="section">
        <div class="box">
          <div class="box-header">指标明细</div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>指标</th><th class="num">当前</th><th class="num hide-sm">1d 增量</th><th class="num hide-sm">7d 增量</th><th class="num hide-sm">30d 增量</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td>Star</td>
                  <td class="num">{fmt(row.metrics?.stars)}</td>
                  <td class="num hide-sm">{fmt(row.delta_1d)}</td>
                  <td class="num hide-sm">{fmt(row.delta_7d)}</td>
                  <td class="num hide-sm">{fmt(row.delta_30d)}</td>
                </tr>
                <tr><td>Fork</td><td class="num">{fmt(row.metrics?.forks)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
                <tr><td>贡献者</td><td class="num">{fmt(row.metrics?.contributors)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
                <tr><td>安装量</td><td class="num">{fmt(row.metrics?.installs)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
                <tr><td>相对增速</td><td class="num">—</td><td class="num">—</td><td class="num">{fmtPct(row.growth_7d_pct)}</td><td class="num">{fmtPct(row.growth_30d_pct)}</td></tr>
                <tr><td>活跃度</td><td class="num">{row.metrics?.activity != null ? row.metrics?.activity.toFixed(2) : '—'}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
                <tr>
                  <td>当前版本</td>
                  <td class="num mono" style="font-size:12px">
                    {row.metrics?.version ?? '—'}
                    {row.metrics?.version_at ? <span class="muted" style="opacity:.7"> · {row.metrics.version_at.slice(0, 10)}</span> : ''}
                  </td>
                  <td class="num">—</td><td class="num">—</td><td class="num">—</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {row.flags.includes('partial_data') && (
        <div class="warn" style="margin-top:16px">该 agent 部分数据源采集失败，综合分基于可用指标重算（缺失权重已重分配）。</div>
      )}
      {row.data_level === 'L3' && (
        <div class="warn" style="margin-top:16px">数据未公开：仅收录，不参与排名（PRD §5.7）。</div>
      )}

      {siblings.length > 0 && (
        <section class="section">
          <div class="section-title">
            <h2>同形态其他选择</h2>
            <span class="muted">{formLabel(row.form)} 内排名靠前</span>
          </div>
          <div class="box">
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th class="pos">#</th><th>Agent</th>
                    <th class="num">综合分</th><th class="num">Star</th>
                    <th class="num hide-sm">安装量</th><th class="num hide-sm">30d 增速</th>
                    <th class="hide-sm">版本</th>
                  </tr>
                </thead>
                <tbody>
                  {siblings.map((r) => (
                    <tr>
                      <td class="pos">{r.rank_in_form ?? '—'}</td>
                      <td>
                        <div class="agent-cell">
                          <AgentIcon
                            slug={r.slug}
                            name={r.name ?? r.slug}
                            icon={loadAgentsMeta()[r.slug]?.icon}
                            iconFallback={loadAgentsMeta()[r.slug]?.iconFallback}
                            size={24}
                          />
                          <a class="name" href={`/agent/${r.slug}/`}>{r.name ?? r.slug}</a>
                        </div>
                      </td>
                      <td class="num"><strong>{r.score ?? '—'}</strong></td>
                      <td class="num">{fmt(r.metrics?.stars)}</td>
                      <td class="num hide-sm">{fmt(r.metrics?.installs)}</td>
                      <td class="num hide-sm">{fmtPct(r.growth_30d_pct)}</td>
                      <td class="mono muted hide-sm" style="font-size:11px">
                        {r.metrics?.version ?? '—'}
                        {r.metrics?.version_at ? <span style="opacity:.6"> · {r.metrics.version_at.slice(0, 10)}</span> : ''}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <div class="row" style="margin-top:14px;gap:10px">
            <a class="btn btn-sm" href={`/forms/${row.form}/`}>全部 {formLabel(row.form)} →</a>
            <a class="btn btn-sm" href={`/compare/?a=${row.slug}&b=${siblings[0]!.slug}`}>与第一名对比 →</a>
          </div>
        </section>
      )}

      <section class="section">
        <div class="section-title"><h2>安全公告</h2></div>
        {sec ? (
          <div class="card">
            <div class="detail" style="font-size:14px;color:var(--gh-fg)">
              包 <a href={sec.url} target="_blank" rel="noopener"><code>{sec.package}</code></a>（{sec.ecosystem}）在 OSV 上有
              <strong>{sec.advisories}</strong> 条历史公告{sec.malicious > 0 && <span class="badge b-closed">含 {sec.malicious} 条恶意包</span>}。
              {sec.latest && <span> 最近一条更新于 {sec.latest.slice(0, 10)}。</span>}
              <div style="margin-top:8px;color:var(--gh-fg-muted)">仅收录历史公告，不代表当前版本受影响，也不构成安全建议。</div>
            </div>
          </div>
        ) : (
          <div class="warn">无包管理渠道，未做 OSV 查询（不会因为“查不到”就说明安全）。</div>
        )}
      </section>
    </>
  )}
</Base>
