---
import Base from '../../layouts/Base.astro';
import { loadLatestScores, loadSecurity, fmt, fmtPct } from '../../lib/data';

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';

// 静态生成：为每个已知 slug 生成页面
export function getStaticPaths() {
  const latest = loadLatestScores();
  const all = latest?.rows ?? [];
  return [...new Set(all.map((r) => r.slug))].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
const row = rows.find((r) => r.slug === slug);
const sec = loadSecurity()?.subjects?.[slug];
if (!row) {
  Astro.redirect('/top');
}
---

<Base pageTitle={row ? `${row.slug} · AgentRank` : '未找到'}>
  {row && (
    <>
      <a href="/top/open/all/month" class="muted">← 返回榜单</a>
      <h1 style="margin-top:0.5rem">{row.name ?? row.slug}
        <span class={`badge ${row.oss_bucket === 'open' ? 'b-open' : row.oss_bucket === 'semi' ? 'b-semi' : 'b-closed'}`}>
          {row.oss_bucket === 'open' ? '开源' : row.oss_bucket === 'semi' ? '半开源' : '闭源'}
        </span>
      </h1>
      <p class="muted">形态：{row.form} · 数据截至 {date}</p>

      <div class="grid" style="margin-top:1rem">
        <div class="card"><h2>综合分</h2><div class="num">{row.score}</div><div class="detail">组内（{row.form}）分位数加权</div></div>
        <div class="card"><h2>组内排名</h2><div class="num">#{row.rank_in_form}</div><div class="detail">同形态内排名</div></div>
        <div class="card"><h2>30d 增速</h2><div class="num {row.growth_30d_pct != null && row.growth_30d_pct > 0 ? 'up' : 'down'}">{fmtPct(row.growth_30d_pct)}</div><div class="detail">滚动 30 日相对增速</div></div>
        <div class="card"><h2>数据完整度</h2><div class="num">{row.data_level}</div><div class="detail">L1 有数据 / L2 半数据 / L3 仅收录</div></div>
      </div>

      <table style="margin-top:1.5rem">
        <tr><th>指标</th><th class="num">当前</th><th class="num">1d 增量</th><th class="num">7d 增量</th><th class="num">30d 增量</th></tr>
        <tr>
          <td>Star</td>
          <td class="num">{fmt(row.metrics?.stars)}</td>
          <td class="num">{fmt(row.delta_1d)}</td>
          <td class="num">{fmt(row.delta_7d)}</td>
          <td class="num">{fmt(row.delta_30d)}</td>
        </tr>
        <tr><td>Fork</td><td class="num">{fmt(row.metrics?.forks)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
        <tr><td>贡献者</td><td class="num">{fmt(row.metrics?.contributors)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
        <tr><td>安装量</td><td class="num">{fmt(row.metrics?.installs)}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
        <tr><td>相对增速</td><td class="num">—</td><td class="num">—</td><td class="num">{fmtPct(row.growth_7d_pct)}</td><td class="num">{fmtPct(row.growth_30d_pct)}</td></tr>
        <tr><td>活跃度</td><td class="num">{row.metrics?.activity != null ? row.metrics?.activity.toFixed(2) : '—'}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
      </table>

      {row.flags.includes('partial_data') && (
        <div class="warn">该 agent 部分数据源采集失败，综合分基于可用指标重算（缺失权重已重分配）。</div>
      )}
      {row.data_level === 'L3' && (
        <div class="warn">数据未公开：仅收录，不参与排名（PRD §5.7）。</div>
      )}

      <h2 style="margin-top:2.5rem;font-size:1.05rem">安全公告</h2>
      {sec ? (
        <div class="card" style="margin-top:0.6rem">
          <div class="detail">
            包 <a href={sec.url} target="_blank" rel="noopener"><code>{sec.package}</code></a>（{sec.ecosystem}）在 OSV 上有
            <strong>{sec.advisories}</strong> 条历史公告{sec.malicious > 0 && <span class="badge b-closed">含 {sec.malicious} 条恶意包</span>}。
            {sec.latest && <span> 最近一条更新于 {sec.latest.slice(0, 10)}。</span>}
            <div style="margin-top:0.4rem;color:var(--muted)">仅收录历史公告，不代表当前版本受影响，也不构成安全建议。</div>
          </div>
        </div>
      ) : (
        <div class="warn" style="margin-top:0.6rem">无包管理渠道，未做 OSV 查询（不会因为“查不到”就说明安全）。</div>
      )}
    </>
  )}
</Base>
