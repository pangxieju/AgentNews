---
import Base from '../../layouts/Base.astro';
import AgentIcon from '../../components/AgentIcon';
import { loadLatestScores, loadAgentsMeta, fmt, fmtPct } from '../../lib/data';
import { FORM_ORDER, formLabel } from '../../lib/shared';
import { FORM_GUIDES } from '../../lib/forms';

export function getStaticPaths() {
  return FORM_ORDER.map((form) => ({ params: { form } }));
}

const { form } = Astro.params;
const guide = FORM_GUIDES[form!];
if (!guide) Astro.redirect('/');

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const meta = loadAgentsMeta();

const list = rows
  .filter((r) => r.form === form)
  .sort((a, b) => (b.score ?? -1) - (a.score ?? -1));
const openCount = list.filter((r) => r.oss_bucket !== 'closed').length;
const hasGrowth = list.some((r) => r.growth_30d_pct != null);
const top2 = list.filter((r) => r.score != null).slice(0, 2);
const others = FORM_ORDER.filter((f) => f !== form).map((f) => ({
  form: f,
  label: formLabel(f),
  en: FORM_GUIDES[f]?.en ?? '',
}));

const bucketBadge = (b: string) => (b === 'open' ? 'b-open' : b === 'semi' ? 'b-semi' : 'b-closed');
const bucketText = (b: string) => (b === 'open' ? '开源' : b === 'semi' ? '半开源' : '闭源');
---

<Base pageTitle={`${formLabel(form!)} · 形态指南 · AgentNews`}>
  <div class="page-head">
    <div class="crumbs">
      <a href="/">AgentNews</a><span>/</span><span>Form Guide</span>
    </div>
    <span class="eyebrow">Form Guide · {guide.en}</span>
    <h1>{formLabel(form!)}</h1>
    <p class="lede">{guide.tagline}</p>
  </div>

  <div class="grid" style="margin-top:0">
    <div class="card">
      <h2>适合</h2>
      <ul class="guide-list">
        {guide.fit.map((x) => <li>{x}</li>)}
      </ul>
    </div>
    <div class="card">
      <h2>取舍</h2>
      <ul class="guide-list">
        {guide.tradeoff.map((x) => <li>{x}</li>)}
      </ul>
    </div>
    <div class="card">
      <h2>看榜时关注</h2>
      <div class="detail" style="font-size:13.5px;color:var(--ink-2);margin-top:10px">{guide.watch}</div>
    </div>
  </div>

  <section class="section">
    <div class="section-title">
      <h2>本形态榜单</h2>
      <span class="muted">{list.length} 个 · 开源 {openCount} / 闭源 {list.length - openCount} · {date}</span>
    </div>
    <div class="box">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="pos">#</th><th>Agent</th><th>归属</th>
              <th class="num">综合分</th><th class="num">Star</th>
              <th class="num hide-sm">安装量</th>{hasGrowth && <th class="num">30d 增速</th>}<th class="hide-sm">最近发版</th>
            </tr>
          </thead>
          <tbody>
            {list.map((r, i) => (
              <tr>
                <td class="pos">{r.rank_in_form ?? '—'}</td>
                <td>
                  <div class="agent-cell">
                    <AgentIcon
                      slug={r.slug}
                      name={r.name ?? r.slug}
                      icon={meta[r.slug]?.icon}
                      iconFallback={meta[r.slug]?.iconFallback}
                      size={26}
                    />
                    <a class="name" href={`/agent/${r.slug}/`}>{r.name ?? r.slug}</a>
                  </div>
                </td>
                <td><span class={`badge ${bucketBadge(r.oss_bucket)}`}>{bucketText(r.oss_bucket)}</span></td>
                <td class="num"><strong>{r.score ?? '—'}</strong></td>
                <td class="num">{fmt(r.metrics?.stars)}</td>
                <td class="num hide-sm">{fmt(r.metrics?.installs)}</td>
                {hasGrowth && <td class="num">{fmtPct(r.growth_30d_pct)}</td>}
                <td class="mono muted hide-sm" style="font-size:11px">{r.metrics?.last_release ? r.metrics.last_release.slice(0, 10) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {top2.length >= 2 && (
    <section class="section">
      <div class="cta-band">
        <div>
          <span class="eyebrow">Compare</span>
          <h2>拿不准？并排比一下</h2>
          <p>{top2[0]!.name} 和 {top2[1]!.name} 是这个形态的前两名，逐行看差异比看总分有用。</p>
        </div>
        <a class="btn btn-primary" href={`/compare/?a=${top2[0]!.slug}&b=${top2[1]!.slug}`}>
          对比前两名 →
        </a>
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-title"><h2>其他形态</h2><span class="muted">跨形态不排名</span></div>
    <div class="row" style="gap:10px">
      {others.map((o) => (
        <a class="btn btn-sm" href={`/forms/${o.form}/`}>{o.label} <span class="mono" style="opacity:.55">{o.en}</span></a>
      ))}
    </div>
  </section>
</Base>