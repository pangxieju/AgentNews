---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon.astro';
import { loadEvents, loadLatestScores, loadAgentsMeta, EVENT_LABEL } from '../lib/data';

const events = loadEvents();
const data = loadLatestScores();
const date = data?.date ?? '—';
const meta = loadAgentsMeta();

// 按类型筛选
const kind = Astro.url.searchParams.get('kind') ?? 'all';
const filtered = kind === 'all' ? events : events.filter((e) => e.kind === kind);

const kinds = ['all', 'release', 'listed', 'rank_jump', 'newcomer'] as const;
const kindLabel = (k: string) => (k === 'all' ? '全部' : EVENT_LABEL[k as keyof typeof EVENT_LABEL] ?? k);

// 按日期分组
const byDate = new Map<string, typeof filtered>();
for (const e of filtered) {
  const list = byDate.get(e.date) ?? [];
  list.push(e);
  byDate.set(e.date, list);
}
const dates = [...byDate.keys()].sort().reverse();

const badgeClass = (k: string) =>
  k === 'release' ? 'b-open' : k === 'listed' ? 'b-semi' : k === 'rank_jump' ? 'b-semi' : k === 'newcomer' ? 'b-open' : 'b-closed';
---

<Base pageTitle="动态 · AgentNews">
  <div class="page-head">
    <div class="crumbs"><a href="/">AgentNews</a><span>/</span><span>动态</span></div>
    <h1>动态</h1>
    <p class="muted">发版 / 新收录 / 排名跃迁 / 新秀 · 数据截至 {date}</p>
  </div>

  <nav class="tabs" aria-label="事件类型">
    {kinds.map((k) => (
      <a class="tab" href={`/activity?kind=${k}`} aria-current={kind === k ? 'page' : undefined}>{kindLabel(k)}</a>
    ))}
  </nav>

  {dates.length === 0 ? (
    <div class="warn">
      尚无事件。事件由「与上一个快照的差异」生成 —— 上线首日没有基线，从第二天起才会产生动态。
    </div>
  ) : (
    dates.map((d) => (
      <section class="section">
        <div class="section-title"><h2>{d}</h2></div>
        <div class="box">
          <div class="table-wrap">
            <table>
              <tbody>
                {byDate.get(d)!.map((e) => (
                  <tr>
                    <td style="width:6rem"><span class={`badge ${badgeClass(e.kind)}`}>{EVENT_LABEL[e.kind as keyof typeof EVENT_LABEL] ?? e.kind}</span></td>
                    <td>
                      <div class="agent-cell">
                        <AgentIcon
                          slug={e.slug}
                          name={e.name}
                          icon={meta[e.slug]?.icon}
                          iconFallback={meta[e.slug]?.iconFallback}
                          size={24}
                        />
                        <span class="tags">
                          <a class="name" href={`/agent/${e.slug}/`}>{e.name}</a>
                          {e.kind === 'release' && e.detail && <span class="muted">· {e.detail}</span>}
                          {e.kind === 'rank_jump' && e.from != null && e.to != null && (
                            <span class="muted">· #{e.from} → #{e.to}</span>
                          )}
                          {e.kind === 'newcomer' && e.detail && <span class="muted">· {e.detail}</span>}
                        </span>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    ))
  )}
</Base>
