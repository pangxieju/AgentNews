---
import Base from '../layouts/Base.astro';
import { loadLatestScores, fmt, fmtPct } from '../lib/data';
import type { ScoreRow } from '@agentrank/core';

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';

// URL 参数：bucket / form / granularity
const bucket = Astro.url.searchParams.get('bucket') ?? 'open';
const form = Astro.url.searchParams.get('form') ?? 'all';
const g = Astro.url.searchParams.get('g') ?? 'month';

let filtered = rows;
if (bucket === 'open') filtered = filtered.filter((r) => r.oss_bucket !== 'closed');
if (bucket === 'closed') filtered = filtered.filter((r) => r.oss_bucket === 'closed');
if (form !== 'all') filtered = filtered.filter((r) => r.form === form);

// 排序：综合分降序（同分按 30d 增速）
const sorted = [...filtered].sort((a, b) =>
  (b.score ?? 0) - (a.score ?? 0) || (b.growth_30d_pct ?? -1) - (a.growth_30d_pct ?? -1),
);

const forms = ['all', 'cli', 'ide-plugin', 'ide-app', 'desktop', 'browser', 'framework', 'autonomous'];
const bucketLabel = bucket === 'open' ? '开源' : '闭源';
const formLabel = (f: string) =>
  ({ all: '全部', cli: 'CLI', 'ide-plugin': 'IDE 插件', 'ide-app': 'IDE 应用', desktop: '桌面', browser: '浏览器', framework: '框架', autonomous: '自主' })[f] ?? f;
---

<Base pageTitle={`${bucketLabel}榜 · AgentRank`}>
  <h1>{bucketLabel}榜 <span class="muted">· {date}</span></h1>
  <p class="muted">综合分 = 加权归一化（<a href="/about">口径</a>）· 支持按形态筛选 · 粒度切换</p>

  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin:1rem 0">
    {forms.map((f) => (
      <a href={`/top?bucket=${bucket}&form=${f}&g=${g}`} style="padding:0.35rem 0.8rem;border-radius:4px;border:1px solid var(--border)" class={form === f ? 'badge b-open' : ''}>{formLabel(f)}</a>
    ))}
  </div>

  <div style="display:flex;gap:0.5rem;margin-bottom:1rem;font-size:0.85rem">
    {['day', 'week', 'month'].map((gg) => (
      <a href={`/top?bucket=${bucket}&form=${form}&g=${gg}`} class={g === gg ? 'badge b-open' : ''} style="padding:0.3rem 0.8rem;border-radius:4px;border:1px solid var(--border)">{gg === 'day' ? '日榜' : gg === 'week' ? '周榜' : '月榜'}</a>
    ))}
  </div>

  <table>
    <tr>
      <th>#</th><th>Agent</th><th>形态</th><th class="num">综合分</th>
      <th class="num">7d 增量</th><th class="num">30d 增速</th><th class="num">数据级</th>
    </tr>
    {sorted.map((r, i) => (
      <tr>
        <td class="pos">{i + 1}</td>
        <td><a href={`/agent/${r.slug}`}>{r.slug}</a>
          <span class={`badge ${r.oss_bucket === 'open' ? 'b-open' : r.oss_bucket === 'semi' ? 'b-semi' : 'b-closed'}`}>
            {r.oss_bucket === 'open' ? '开源' : r.oss_bucket === 'semi' ? '半开源' : '闭源'}
          </span>
          {r.flags.includes('partial_data') && <span class="badge b-semi">数据不全</span>}
        </td>
        <td>{formLabel(r.form)}</td>
        <td class="num"><strong>{r.score}</strong></td>
        <td class="num">{r.delta_7d != null ? fmt(r.delta_7d) : '—'}</td>
        <td class="num">{fmtPct(r.growth_30d_pct)}</td>
        <td class="num">{r.data_level}</td>
      </tr>
    ))}
  </table>

  {rows.length === 0 && <div class="warn">暂无数据：请先运行 <code>pnpm collect</code>。</div>}
</Base>
