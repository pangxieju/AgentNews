---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import { loadLatestScores, loadAgentsMeta, loadAgentState, fmt, formLabel } from '../lib/data';

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const state = loadAgentState();
const startedAt = state?.started_at ?? '—';
const meta = loadAgentsMeta();

/** 新秀资格（PRD §5.6）：出道 ≤ 180 天 */
const NEWCOMER_DAYS = 180;

const newcomers = rows
  .filter((r) => r.age_days != null && r.age_days <= NEWCOMER_DAYS && r.score != null)
  .sort((a, b) => (b.score ?? 0) - (a.score ?? 0));

const youngest = [...rows]
  .filter((r) => r.age_days != null)
  .sort((a, b) => a.age_days! - b.age_days!)
  .slice(0, 10);

const bucketBadge = (b: string) => (b === 'open' ? 'b-open' : b === 'semi' ? 'b-semi' : 'b-closed');
const bucketText = (b: string) => (b === 'open' ? '开源' : b === 'semi' ? '半开源' : '闭源');
---

<Base pageTitle="新秀榜 · AgentNews">
  <div class="page-head">
    <div class="crumbs"><a href="/">AgentNews</a><span>/</span><span>新秀榜</span></div>
    <span class="eyebrow">Rising · Debut ≤ 180 days</span>
    <h1>新秀榜</h1>
    <p class="muted">出道 ≤ {NEWCOMER_DAYS} 天且已上榜的 agent · 数据截至 {date}</p>
  </div>

  <div class="warn">
    <strong>口径说明：</strong>出道天数 = min（repo 创建至今, 首次收录至今）。
    其中「首次收录」只在该项目<b>晚于系统上线日（{startedAt}）</b>被收录时计入 —— 因为上线当天收录的条目无法区分「本来就存在」与「刚出现」。
    本系统自 {startedAt} 起记录收录时间，随时间推移，「上线后冒出的新项目」会被准确识别。
  </div>

  <section class="section">
    <div class="section-title">
      <h2>新秀</h2>
      <span class="counter">{newcomers.length}</span>
    </div>

    {newcomers.length > 0 ? (
      <div class="box">
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>#</th><th>Agent</th><th>形态</th><th class="num">出道</th><th class="num hide-sm">首次收录</th><th class="num">综合分</th><th class="num">Star</th><th class="num hide-sm">安装量</th></tr>
            </thead>
            <tbody>
              {newcomers.map((r, i) => (
                <tr>
                  <td class="pos">{i + 1}</td>
                  <td>
                    <div class="agent-cell">
                      <AgentIcon
                        slug={r.slug}
                        name={r.name ?? r.slug}
                        icon={meta[r.slug]?.icon}
                        iconFallback={meta[r.slug]?.iconFallback}
                        size={24}
                      />
                      <span class="tags">
                        <a class="name" href={`/agent/${r.slug}/`}>{r.name}</a>
                        <span class={`badge ${bucketBadge(r.oss_bucket)}`}>{bucketText(r.oss_bucket)}</span>
                      </span>
                    </div>
                  </td>
                  <td class="muted">{formLabel(r.form)}</td>
                  <td class="num">{r.age_days} 天</td>
                  <td class="num muted hide-sm">{r.first_listed ?? '—'}</td>
                  <td class="num"><strong>{r.score}</strong></td>
                  <td class="num">{fmt(r.metrics?.stars)}</td>
                  <td class="num hide-sm">{fmt(r.metrics?.installs)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : (
      <div class="notice">
        当前无符合条件的 agent（收录名单里最年轻的也已超过 {NEWCOMER_DAYS} 天）。
        这说明当前样本偏向成熟项目 —— 新秀榜需要持续收录新项目才有内容。
      </div>
    )}
  </section>

  <section class="section">
    <div class="section-title">
      <h2>最年轻的 10 个</h2>
      <span class="muted" style="font-size:12px">按 repo 创建时间排序，帮助发现接近新秀资格的项目</span>
    </div>
    <div class="box">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>#</th><th>Agent</th><th>形态</th><th class="num">出道</th><th class="num hide-sm">首次收录</th><th class="num">综合分</th></tr>
          </thead>
          <tbody>
            {youngest.map((r, i) => (
              <tr>
                <td class="pos">{i + 1}</td>
                <td>
                  <div class="agent-cell">
                    <AgentIcon
                      slug={r.slug}
                      name={r.name ?? r.slug}
                      icon={meta[r.slug]?.icon}
                      iconFallback={meta[r.slug]?.iconFallback}
                      size={24}
                    />
                    <a class="name" href={`/agent/${r.slug}/`}>{r.name}</a>
                  </div>
                </td>
                <td class="muted">{formLabel(r.form)}</td>
                <td class="num">{r.age_days} 天</td>
                <td class="num muted hide-sm">{r.first_listed ?? '—'}</td>
                <td class="num">{r.score ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
