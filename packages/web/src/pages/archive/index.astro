---
import Base from '../../layouts/Base.astro';
import LineChart from '../../components/charts/LineChart.astro';
import { loadArchives, loadAllScores, loadDailyCounts } from '../../lib/data';

const archives = loadArchives();
const daily = loadAllScores();
const counts = loadDailyCounts();
const trendReady = counts.length >= 2;
---

<Base pageTitle="归档 · AgentNews">
  <div class="page-head">
    <div class="crumbs"><a href="/">AgentNews</a><span>/</span><span>归档</span></div>
    <span class="eyebrow">Archive · Weekly & Monthly</span>
    <h1>历史归档</h1>
    <p class="muted">每周日冻结周档，每月末冻结月档（PRD §5.5）· 归档口径为结算日当天的滚动值</p>
  </div>

  <section class="section">
    <div class="section-title"><h2>周档 / 月档</h2></div>
    {archives.length > 0 ? (
      <div class="box">
        <div class="table-wrap">
          <table>
            <thead><tr><th>周期</th><th>类型</th><th>结算日</th><th class="num">在榜数</th></tr></thead>
            <tbody>
              {archives.map((a) => (
                <tr>
                  <td><a href={`/archive/${a.label}/`}>{a.label}</a></td>
                  <td class="muted">{a.period === 'week' ? '周档' : '月档'}</td>
                  <td class="muted">{a.end}</td>
                  <td class="num">{a.rows.filter((r) => r.rank_in_form != null).length}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : (
      <div class="notice">
        尚无归档。周档在每周日采集后生成，月档在每月最后一天生成 —— 上线首周即可看到第一个周档。
      </div>
    )}
  </section>

  <section class="section">
    <div class="section-title">
      <h2>每日快照</h2>
      <span class="muted" style="font-size:12px">每日采集结果，用于趋势计算与历史回溯</span>
    </div>
    {trendReady ? (
      <div class="box" style="margin-bottom:16px">
        <div class="box-body">
          <LineChart
            series={[
              { name: '收录数', points: counts.map((c) => ({ x: c.date, y: c.listed })), tone: 'accent' },
              { name: '在榜数', points: counts.map((c) => ({ x: c.date, y: c.ranked })), tone: 'success' },
            ]}
            zeroBased
            height={210}
            unit=" 个"
          />
        </div>
      </div>
    ) : (
      <div class="notice" style="margin-bottom:16px">
        折线图需要至少 2 天快照（当前 {counts.length} 天：{counts[0]?.date ?? '—'}）。每日采集后自动补全。
      </div>
    )}
    {daily.length > 0 ? (
      <div class="box">
        <div class="table-wrap">
          <table>
            <thead><tr><th>日期</th><th class="num">在榜数</th><th class="num">收录数</th></tr></thead>
            <tbody>
              {daily.map((d) => (
                <tr>
                  <td>{d.date}</td>
                  <td class="num">{d.rows.filter((r) => r.rank_in_form != null).length}</td>
                  <td class="num">{d.rows.length}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    ) : (
      <div class="notice">尚无每日快照。</div>
    )}
  </section>

  <div class="notice" style="margin-top:24px">
    <strong>数据可下载：</strong>所有快照均为纯 JSON 文件，位于仓库 <code>data/</code> 目录，
    可通过 git 历史完整回溯（每个快照对应一个 commit）。
  </div>
</Base>
