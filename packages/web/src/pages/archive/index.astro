---
import Base from '../../layouts/Base.astro';
import { loadArchives, loadAllScores } from '../../lib/data';

const archives = loadArchives();
const daily = loadAllScores();
---

<Base pageTitle="归档 · AgentNews">
  <h1>历史归档</h1>
  <p class="muted">每周日冻结周档，每月末冻结月档（PRD §5.5）· 归档口径为结算日当天的滚动值</p>

  <h2 style="margin-top:2rem;font-size:1.05rem">周档 / 月档</h2>
  {archives.length > 0 ? (
    <table style="margin-top:0.8rem">
      <tr><th>周期</th><th>类型</th><th>结算日</th><th class="num">在榜数</th></tr>
      {archives.map((a) => (
        <tr>
          <td><a href={`/archive/${a.label}/`}>{a.label}</a></td>
          <td class="muted">{a.period === 'week' ? '周档' : '月档'}</td>
          <td class="muted">{a.end}</td>
          <td class="num">{a.rows.filter((r) => r.rank_in_form != null).length}</td>
        </tr>
      ))}
    </table>
  ) : (
    <div class="warn">
      尚无归档。周档在每周日采集后生成，月档在每月最后一天生成 —— 上线首周即可看到第一个周档。
    </div>
  )}

  <h2 style="margin-top:2.5rem;font-size:1.05rem">每日快照</h2>
  <p class="muted" style="font-size:0.85rem">每日采集结果，用于趋势计算与历史回溯</p>
  {daily.length > 0 ? (
    <table style="margin-top:0.8rem">
      <tr><th>日期</th><th class="num">在榜数</th><th class="num">收录数</th></tr>
      {daily.map((d) => (
        <tr>
          <td>{d.date}</td>
          <td class="num">{d.rows.filter((r) => r.rank_in_form != null).length}</td>
          <td class="num">{d.rows.length}</td>
        </tr>
      ))}
    </table>
  ) : (
    <div class="warn">尚无每日快照。</div>
  )}

  <div class="warn" style="margin-top:2rem">
    <strong>数据可下载：</strong>所有快照均为纯 JSON 文件，位于仓库 <code>data/</code> 目录，
    可通过 git 历史完整回溯（每个快照对应一个 commit）。
  </div>
</Base>
