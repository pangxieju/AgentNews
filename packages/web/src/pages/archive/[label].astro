---
import Base from '../../layouts/Base.astro';
import AgentIcon from '../../components/AgentIcon.astro';
import { loadArchives, loadArchive, loadAgentsMeta, fmt, fmtPct, formLabel } from '../../lib/data';

export function getStaticPaths() {
  const archives = loadArchives();
  return archives.map((a) => ({ params: { label: a.label } }));
}

const { label } = Astro.params;
const a = loadArchive(label!);
if (!a) Astro.redirect('/archive');
const meta = loadAgentsMeta();

const FORM_ORDER = ['cli', 'ide-plugin', 'ide-app', 'desktop', 'browser', 'framework', 'autonomous'];
const groups = FORM_ORDER
  .map((f) => ({
    form: f,
    rows: a!.rows.filter((r) => r.form === f).sort((x, y) => (x.rank_in_form ?? 999) - (y.rank_in_form ?? 999)),
  }))
  .filter((g) => g.rows.length > 0);

const bucketBadge = (b: string) => (b === 'open' ? 'b-open' : b === 'semi' ? 'b-semi' : 'b-closed');
const bucketText = (b: string) => (b === 'open' ? '开源' : b === 'semi' ? '半开源' : '闭源');
---

<Base pageTitle={`${label} 归档 · AgentNews`}>
  <div class="crumbs">
    <a href="/archive/">← 归档列表</a>
  </div>
  <div class="page-head">
    <h1>{label} <span class="muted" style="font-size:14px;font-weight:400">· {a?.period === 'week' ? '周档' : '月档'}</span></h1>
    <p class="muted">结算日 {a?.end} · 归档为冻结快照，不随新数据变化</p>
  </div>

  <div class="stack">
    {groups.map((g) => (
      <section class="box">
        <div class="box-header">
          <span class="row" style="gap:8px">
            {formLabel(g.form)}
            <span class="counter">{g.rows.length}</span>
          </span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>#</th><th>Agent</th><th class="num">综合分</th><th class="num">Star</th><th class="num">30d 增速</th><th class="num">安装量</th></tr>
            </thead>
            <tbody>
              {g.rows.map((r) => (
                <tr>
                  <td class="pos">{r.rank_in_form ?? '—'}</td>
                  <td>
                    <div class="agent-cell">
                      <AgentIcon
                        slug={r.slug}
                        name={r.name ?? r.slug}
                        icon={meta[r.slug]?.icon}
                        iconFallback={meta[r.slug]?.iconFallback}
                        size={24}
                      />
                      <span class="tags">
                        <a class="name" href={`/agent/${r.slug}/`}>{r.name ?? r.slug}</a>
                        <span class={`badge ${bucketBadge(r.oss_bucket)}`}>{bucketText(r.oss_bucket)}</span>
                      </span>
                    </div>
                  </td>
                  <td class="num"><strong>{r.score ?? '—'}</strong></td>
                  <td class="num">{fmt(r.metrics?.stars)}</td>
                  <td class="num">{fmtPct(r.growth_30d_pct)}</td>
                  <td class="num">{fmt(r.metrics?.installs)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </div>
</Base>
