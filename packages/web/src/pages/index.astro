---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import HomePicker, { type PickRow } from '../components/HomePicker';
import BarChart from '../components/charts/BarChart.astro';
import { loadLatestScores, loadAgentsMeta, fmt, fmtPct } from '../lib/data';
import { FORM_ORDER, formLabel } from '../lib/shared';

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const metaAll = loadAgentsMeta();

const meta: Record<string, { icon: string | null; iconFallback: string | null }> = {};
for (const r of rows) {
  const m = metaAll[r.slug];
  if (m) meta[r.slug] = { icon: m.icon, iconFallback: m.iconFallback };
}

const open = rows.filter((r) => r.oss_bucket !== 'closed');
const closed = rows.filter((r) => r.oss_bucket === 'closed');
const topOpen = [...open].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).slice(0, 5);
const topClosed = [...closed].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).slice(0, 5);

/** 首日没有增速数据：隐藏该列，避免整列都是「—」 */
const hasGrowth = rows.some((r) => r.growth_30d_pct != null);

/** 形态分布：条数 + 直达该形态的榜单 */
const formBars = FORM_ORDER.map((f) => {
  const list = rows.filter((r) => r.form === f);
  const openCount = list.filter((r) => r.oss_bucket !== 'closed').length;
  return {
    label: formLabel(f),
    value: list.length,
    href: `/top/${openCount > 0 ? 'open' : 'closed'}/${f}/month/`,
    tone: 'accent' as const,
  };
}).filter((b) => b.value > 0);

const pick: PickRow[] = rows.map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  vendor: metaAll[r.slug]?.vendor ?? null,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  stars: r.metrics?.stars ?? null,
}));
---

<Base pageTitle="AI Agent 排行榜">
  <div class="page-head">
    <h1>AI Agent 排行榜</h1>
    <p class="muted">
      数据截至 {date} · 跨生态归一化 · 开源/闭源双榜 · 日/周/月粒度 —— 先按形态缩小范围，再比指标。
    </p>
  </div>

  <section class="box" style="margin-bottom:16px">
    <div class="box-header">
      <span>选型入口</span>
      <span class="muted" style="font-size:12px;font-weight:400">搜索 / 按形态筛选，跨形态不排名</span>
    </div>
    <div class="box-body">
      <HomePicker client:load items={pick} meta={meta} />
    </div>
  </section>

  <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(340px,1fr))">
    <section class="box">
      <div class="box-header">
        <span class="row" style="gap:8px">
          开源榜
          <span class="badge b-open">OPEN</span>
          <span class="counter">{open.length}</span>
        </span>
        <a class="btn btn-sm" href="/top/open/all/month/">查看全部</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th><th>Agent</th><th class="num">综合分</th>
              {hasGrowth && <th class="num">30d 增速</th>}
            </tr>
          </thead>
          <tbody>
            {topOpen.map((r, i) => (
              <tr>
                <td class="pos">{i + 1}</td>
                <td>
                  <div class="agent-cell">
                    <AgentIcon
                      slug={r.slug}
                      name={r.name ?? r.slug}
                      icon={meta[r.slug]?.icon}
                      iconFallback={meta[r.slug]?.iconFallback}
                      size={24}
                    />
                    <a class="name" href={`/agent/${r.slug}/`}>{r.name ?? r.slug}</a>
                  </div>
                </td>
                <td class="num"><strong>{r.score ?? '—'}</strong></td>
                {hasGrowth && <td class="num">{fmtPct(r.growth_30d_pct)}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="box-body muted" style="border-top:1px solid var(--gh-border);font-size:12px">
        OSI 协议 · MIT/Apache/AGPL 等 · 覆盖 {new Set(open.map((r) => r.form)).size} 种形态
      </div>
    </section>

    <section class="box">
      <div class="box-header">
        <span class="row" style="gap:8px">
          闭源榜
          <span class="badge b-closed">CLOSED</span>
          <span class="counter">{closed.length}</span>
        </span>
        <a class="btn btn-sm" href="/top/closed/all/month/">查看全部</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th><th>Agent</th><th class="num">综合分</th>
              {hasGrowth && <th class="num">30d 增速</th>}
            </tr>
          </thead>
          <tbody>
            {topClosed.map((r, i) => (
              <tr>
                <td class="pos">{i + 1}</td>
                <td>
                  <div class="agent-cell">
                    <AgentIcon
                      slug={r.slug}
                      name={r.name ?? r.slug}
                      icon={meta[r.slug]?.icon}
                      iconFallback={meta[r.slug]?.iconFallback}
                      size={24}
                    />
                    <a class="name" href={`/agent/${r.slug}/`}>{r.name ?? r.slug}</a>
                  </div>
                </td>
                <td class="num"><strong>{r.score ?? '—'}</strong></td>
                {hasGrowth && <td class="num">{fmtPct(r.growth_30d_pct)}</td>}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="box-body muted" style="border-top:1px solid var(--gh-border);font-size:12px">
        专有 License · 数据缺失时按收录区展示（不排名）
      </div>
    </section>
  </div>

  <section class="section">
    <div class="section-title">
      <h2>收录分布</h2>
      <span class="muted" style="font-size:12px">按形态 · 共 {rows.length} 个，点名称进对应榜单</span>
    </div>
    <div class="box">
      <div class="box-body">
        <BarChart bars={formBars} unit=" 个" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>怎么看这份榜</h2>
    </div>
    <div class="grid" style="margin-top:0">
      <div class="card">
        <h2>按形态分组</h2>
        <div class="detail">CLI / IDE 插件 / IDE 应用 / 桌面 / 浏览器 / 框架 / 自主 —— 跨形态不比较。</div>
      </div>
      <div class="card">
        <h2>跨生态归一化</h2>
        <div class="detail">Star、npm/PyPI 下载、商店安装量统一压缩到组内分位数再加权。</div>
      </div>
      <div class="card">
        <h2>可审计</h2>
        <div class="detail">每日快照以 git 提交归档，算法权重、口径变更全部公开。</div>
      </div>
    </div>
  </section>

  {!data && <div class="warn">暂无数据：请先运行 <code>pnpm collect</code> 生成快照。</div>}
</Base>