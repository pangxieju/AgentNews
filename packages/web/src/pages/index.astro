---
import Base from '../layouts/Base.astro';
import AgentIcon from '../components/AgentIcon';
import HomePicker, { type PickRow } from '../components/HomePicker';
import BarChart from '../components/charts/BarChart.astro';
import { loadLatestScores, loadAgentsMeta, fmtPct } from '../lib/data';
import { FORM_ORDER, formLabel } from '../lib/shared';

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const metaAll = loadAgentsMeta();

const meta: Record<string, { icon: string | null; iconFallback: string | null }> = {};
for (const r of rows) {
  const m = metaAll[r.slug];
  if (m) meta[r.slug] = { icon: m.icon, iconFallback: m.iconFallback };
}

const open = rows.filter((r) => r.oss_bucket !== 'closed');
const closed = rows.filter((r) => r.oss_bucket === 'closed');
const topOpen = [...open].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).slice(0, 5);
const topClosed = [...closed].sort((a, b) => (b.score ?? 0) - (a.score ?? 0)).slice(0, 5);
const hasGrowth = rows.some((r) => r.growth_30d_pct != null);
const forms = new Set(rows.map((r) => r.form)).size;

const formBars = FORM_ORDER.map((f) => {
  const list = rows.filter((r) => r.form === f);
  const openCount = list.filter((r) => r.oss_bucket !== 'closed').length;
  return {
    label: formLabel(f),
    value: list.length,
    href: `/top/${openCount > 0 ? 'open' : 'closed'}/${f}/month/`,
    tone: 'accent' as const,
  };
}).filter((b) => b.value > 0);

const pick: PickRow[] = rows.map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  vendor: metaAll[r.slug]?.vendor ?? null,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  stars: r.metrics?.stars ?? null,
}));
---

<Base pageTitle="AI Agent 排行榜">
  <section class="hero">
    <div>
      <span class="eyebrow">AI Agent Index · Daily Snapshot</span>
      <h1 class="display">看见 AI Agent 的<em>真实热度</em>与走向</h1>
      <p class="lede">
        把 GitHub star、npm / PyPI 下载、商店安装量压缩到同一把尺子，再按形态分组排名。
        开源与闭源双榜，日 / 周 / 月三条时间线 —— 可比的才排名，不可比的就标注。
      </p>
    </div>
    <aside class="hero-rail">
      <div class="stat-rail">
        <div><span data-k>收录</span><b>{rows.length}</b></div>
        <div><span data-k>开源</span><b>{open.length}</b></div>
        <div><span data-k>闭源</span><b>{closed.length}</b></div>
        <div><span data-k>形态</span><b>{forms}</b></div>
        <div><span data-k>快照</span><b>{date}</b></div>
      </div>
    </aside>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>选型 / Find</h2>
      <span class="muted">搜索 · 形态 · 归属</span>
    </div>
    <HomePicker client:load items={pick} meta={meta} />
  </section>

  <section class="section">
    <div class="section-title">
      <h2>双榜 / Leaderboard</h2>
      <span class="muted">同形态内排名 · 跨形态不比较</span>
    </div>
    <div class="ledger-grid">
      <div class="ledger">
        <div class="ledger-head">
          <span class="ledger-title">开源榜 <span class="idx">Open · {open.length}</span></span>
          <a class="btn btn-sm" href="/top/open/all/month/">全部 →</a>
        </div>
        <table>
          <thead>
            <tr>
              <th class="pos">#</th><th>Agent</th><th class="num">综合分</th>
              {hasGrowth && <th class="num">30d</th>}
            </tr>
          </thead>
          <tbody>
            {topOpen.map((r, i) => (
              <tr>
                <td class="pos">{i + 1}</td>
                <td>
                  <div class="agent-cell">
                    <AgentIcon
                      slug={r.slug}
                      name={r.name ?? r.slug}
                      icon={meta[r.slug]?.icon}
                      iconFallback={meta[r.slug]?.iconFallback}
                      size={26}
                    />
                    <a class="name" href={`/agent/${r.slug}/`}>{r.name ?? r.slug}</a>
                  </div>
                </td>
                <td class="num"><strong>{r.score ?? '—'}</strong></td>
                {hasGrowth && <td class="num">{fmtPct(r.growth_30d_pct)}</td>}
              </tr>
            ))}
          </tbody>
        </table>
        <div class="ledger-foot">OSI 协议 · MIT / Apache / AGPL 等 · {new Set(open.map((r) => r.form)).size} 种形态</div>
      </div>

      <div class="ledger">
        <div class="ledger-head">
          <span class="ledger-title">闭源榜 <span class="idx">Closed · {closed.length}</span></span>
          <a class="btn btn-sm" href="/top/closed/all/month/">全部 →</a>
        </div>
        <table>
          <thead>
            <tr>
              <th class="pos">#</th><th>Agent</th><th class="num">综合分</th>
              {hasGrowth && <th class="num">30d</th>}
            </tr>
          </thead>
          <tbody>
            {topClosed.map((r, i) => (
              <tr>
                <td class="pos">{i + 1}</td>
                <td>
                  <div class="agent-cell">
                    <AgentIcon
                      slug={r.slug}
                      name={r.name ?? r.slug}
                      icon={meta[r.slug]?.icon}
                      iconFallback={meta[r.slug]?.iconFallback}
                      size={26}
                    />
                    <a class="name" href={`/agent/${r.slug}/`}>{r.name ?? r.slug}</a>
                  </div>
                </td>
                <td class="num"><strong>{r.score ?? '—'}</strong></td>
                {hasGrowth && <td class="num">{fmtPct(r.growth_30d_pct)}</td>}
              </tr>
            ))}
          </tbody>
        </table>
        <div class="ledger-foot">专有 License · 数据缺失时按收录区展示（不排名）</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-title">
      <h2>收录分布 / Coverage</h2>
      <span class="muted">按形态 · 点名称进入对应榜单</span>
    </div>
    <BarChart bars={formBars} unit=" 个" />
  </section>

  <section class="section">
    <div class="section-title">
      <h2>口径 / Method</h2>
      <span class="muted">综合分是观点，不是事实</span>
    </div>
    <div class="grid">
      <div class="card">
        <h2>按形态分组</h2>
        <div class="detail">CLI / IDE 插件 / IDE 应用 / 桌面 / 浏览器 / 框架 / 自主 —— 跨形态不比较。</div>
      </div>
      <div class="card">
        <h2>跨生态归一化</h2>
        <div class="detail">Star、npm / PyPI 下载、商店安装量统一压缩到组内分位数再加权。</div>
      </div>
      <div class="card">
        <h2>可审计</h2>
        <div class="detail">每日快照以 git 提交归档，算法权重、口径变更全部公开。</div>
      </div>
    </div>
  </section>

  {!data && <div class="warn" style="margin-top:24px">暂无数据：请先运行 <code>pnpm collect</code> 生成快照。</div>}
</Base>