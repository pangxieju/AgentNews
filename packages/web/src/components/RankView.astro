---
/**
 * 榜单容器（服务端壳）。数据在构建期内联进 HTML，交互交给 RankBoard island。
 */
import Base from '../layouts/Base.astro';
import RankBoard, { type RankRow, type IconMeta } from './RankBoard';
import { loadLatestScores, loadAgentsMeta } from '../lib/data';
import { isListed, rankUrl } from '../lib/shared';
import { type Lang, bucketText, formLabel, granLabel, pathFor, t } from '../i18n/dict';

interface Props {
  bucket: string;
  form: string;
  g: string;
  lang: Lang;
}

const { bucket, form, g, lang } = Astro.props;
const H = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const date = data?.date ?? '—';
const metaAll = loadAgentsMeta();
/** 只保留非误分类的条目（全部 9 种形态都进榜单） */
const rows = (data?.rows ?? []).filter(isListed);

/** 只把榜单需要的字段送进 island —— 减小 HTML 体积 */
const slim: RankRow[] = rows.map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  rank_in_form: r.rank_in_form,
  delta_1d: r.delta_1d,
  delta_7d: r.delta_7d,
  installs_delta_7d: r.installs_delta_7d ?? null,
  installs_delta_30d: r.installs_delta_30d ?? null,
  growth_30d_pct: r.growth_30d_pct,
  metrics: {
    stars: r.metrics?.stars ?? null,
    installs: r.metrics?.installs ?? null,
    activity: r.metrics?.activity ?? null,
    openrouter_tokens_month: r.metrics?.openrouter_tokens_month ?? null,
  },
  flags: r.flags ?? [],
  data_level: r.data_level,
  last_release: r.metrics?.last_release ? String(r.metrics.last_release).slice(0, 10) : null,
  license: metaAll[r.slug]?.license ?? null,
}));

const meta: Record<string, IconMeta> = {};
for (const r of rows) {
  const m = metaAll[r.slug];
  if (m) meta[r.slug] = { icon: m.icon, iconFallback: m.iconFallback };
}

const titleKey = bucket === 'open' ? 'rank.titleOpen' : 'rank.titleClosed';
const bucketLabel = bucketText(lang, bucket);
const SITE = Astro.site ?? new URL('https://agentnews-c5h.pages.dev');
/** /top/ 是 /top/open/all/month/ 的别名页：重复内容不进索引 */
const isAlias = /^(?:\/zh)?\/top\/?$/.test(Astro.url.pathname);

/* ── SEO / 结构化数据：榜单是主入口，每张榜必须有自己的描述与 ItemList ── */
const formText = form === 'all' ? (lang === 'en' ? 'all forms' : '全部形态') : formLabel(lang, form);
/** 当前榜单的条目范围：先按开/闭源与形态收窄，再做排名与描述 */
const boardRows = rows.filter(
  (r) =>
    (bucket === 'open' ? r.oss_bucket !== 'closed' : r.oss_bucket === 'closed') &&
    (form === 'all' || r.form === form),
);
const top = boardRows
  .filter((r) => r.score != null)
  .sort((a, b) => (b.score ?? 0) - (a.score ?? 0))
  .slice(0, 10);
const description = `${bucketLabel} · ${formText} · ${granLabel(lang, g)} — ${boardRows.filter((r) => r.score != null).length} ranked of ${boardRows.length} listed. Scores are in-form percentiles (${data?.version ?? '—'}); open and closed are separate namespaces. Snapshot ${date}.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${bucketLabel} · ${formText} · ${granLabel(lang, g)}`,
    numberOfItems: top.length,
    url: new URL(H(rankUrl(bucket, form, g)), SITE).href,
    itemListElement: top.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(H(`/agent/${r.slug}/`), SITE).href,
      name: r.name ?? r.slug,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'AgentNews', item: SITE.href },
      { '@type': 'ListItem', position: 2, name: bucketLabel, item: new URL(H(rankUrl(bucket, 'all', g)), SITE).href },
    ],
  },
];
---

<Base lang={lang} pageTitle={t(lang, titleKey)} description={description} jsonLd={jsonLd} noindex={isAlias}>
<div class="page-head">
  <div class="crumbs">
    <a href={H('/')}>AgentNews</a><span>/</span><span>{t(lang, 'rank.crumb')}</span>
  </div>
  <span class="eyebrow">{t(lang, bucket === 'open' ? 'rank.eyebrowOpen' : 'rank.eyebrowClosed', { date })}</span>
  <h1 id="rank-title">{t(lang, titleKey)}</h1>
  <p class="lede">
    {t(lang, 'rank.lede')} <a href={H('/about/')}>{t(lang, 'rank.method')}</a>
  </p>
</div>

<RankBoard client:load rows={slim} meta={meta} bucket={bucket} form={form} g={g} lang={lang} />

{rows.length === 0 && (
  <div class="warn" style="margin-top:16px">
    {lang === 'en' ? 'No data yet. Run ' : '暂无数据：请先运行 '}<code>pnpm collect</code>.
  </div>
)}

<noscript>
  <div class="warn" style="margin-top:16px">
    {t(lang, 'rank.noscript')}
    <a href={H(rankUrl(bucket, 'all', g))}>{bucketLabel} {lang === 'en' ? 'board' : '榜'}</a>
    {lang === 'en' ? ' or ' : ' 或 '}
    <a href={H('/data/')}>{t(lang, 'footer.data')}</a>.
  </div>
</noscript>
</Base>