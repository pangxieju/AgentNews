---
/**
 * 榜单容器（服务端壳）。
 * 数据在构建期内联进 HTML，交互交给 RankBoard island：
 * - 默认 `client:load` 时首屏已有 SSR 结果，hydrate 后接管筛选/排序
 * - 用 `client:visible` 会让首屏切换有一瞬原生跳转，这里选 load
 */
import RankBoard, { type RankRow, type IconMeta } from './RankBoard';
import { loadLatestScores, loadAgentsMeta } from '../lib/data';
import { rankUrl, formLabel, granLabel, defaultSortFor } from '../lib/shared';

interface Props {
  bucket: string;
  form: string;
  g: string;
}

const { bucket, form, g } = Astro.props;

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const metaAll = loadAgentsMeta();

/** 只把榜单需要的字段送进 island —— 减小 HTML 体积 */
const slim: RankRow[] = rows.map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  rank_in_form: r.rank_in_form,
  delta_1d: r.delta_1d,
  delta_7d: r.delta_7d,
  growth_30d_pct: r.growth_30d_pct,
  metrics: {
    stars: r.metrics?.stars ?? null,
    installs: r.metrics?.installs ?? null,
    activity: r.metrics?.activity ?? null,
  },
  flags: r.flags ?? [],
  data_level: r.data_level,
}));

const meta: Record<string, IconMeta> = {};
for (const r of rows) {
  const m = metaAll[r.slug];
  if (m) meta[r.slug] = { icon: m.icon, iconFallback: m.iconFallback };
}

const bucketLabel = bucket === 'open' ? '开源' : '闭源';
---

<div class="page-head">
  <div class="crumbs">
    <a href="/">AgentNews</a><span>/</span><span>Board</span>
  </div>
  <span class="eyebrow">{bucket === 'open' ? 'Open Source' : 'Closed Source'} · Snapshot {date}</span>
  <h1 id="rank-title">{bucketLabel}榜</h1>
  <p class="lede">
    同形态内比较，跨形态不排名。列头可排序，行尾 <b>+</b> 加入对比 —— <a href="/about/">口径说明</a>
  </p>
</div>

<RankBoard client:load rows={slim} meta={meta} bucket={bucket} form={form} g={g} />

{rows.length === 0 && <div class="warn" style="margin-top:16px">暂无数据：请先运行 <code>pnpm collect</code>。</div>}

<noscript>
  <div class="warn" style="margin-top:16px">
    当前浏览器禁用了 JavaScript，筛选与排序不可用。可直接访问
    <a href={rankUrl(bucket, 'all', g)}>{bucketLabel}榜全部</a> 或
    <a href="/archive/">历史归档</a>。
  </div>
</noscript>
