---
/**
 * 榜单容器（服务端壳）。数据在构建期内联进 HTML，交互交给 RankBoard island。
 */
import Base from '../layouts/Base.astro';
import RankBoard, { type RankRow, type IconMeta } from './RankBoard';
import { loadLatestScores, loadAgentsMeta } from '../lib/data';
import { rankUrl } from '../lib/shared';
import { type Lang, bucketText, pathFor, t } from '../i18n/dict';

interface Props {
  bucket: string;
  form: string;
  g: string;
  lang: Lang;
}

const { bucket, form, g, lang } = Astro.props;
const H = (p: string) => pathFor(lang, p);

const data = loadLatestScores();
const rows = data?.rows ?? [];
const date = data?.date ?? '—';
const metaAll = loadAgentsMeta();

/** 只把榜单需要的字段送进 island —— 减小 HTML 体积 */
const slim: RankRow[] = rows.map((r) => ({
  slug: r.slug,
  name: r.name ?? r.slug,
  form: r.form,
  oss_bucket: r.oss_bucket,
  score: r.score,
  rank_in_form: r.rank_in_form,
  delta_1d: r.delta_1d,
  delta_7d: r.delta_7d,
  growth_30d_pct: r.growth_30d_pct,
  metrics: {
    stars: r.metrics?.stars ?? null,
    installs: r.metrics?.installs ?? null,
    activity: r.metrics?.activity ?? null,
  },
  flags: r.flags ?? [],
  data_level: r.data_level,
}));

const meta: Record<string, IconMeta> = {};
for (const r of rows) {
  const m = metaAll[r.slug];
  if (m) meta[r.slug] = { icon: m.icon, iconFallback: m.iconFallback };
}

const titleKey = bucket === 'open' ? 'rank.titleOpen' : 'rank.titleClosed';
const bucketLabel = bucketText(lang, bucket);
---

<Base lang={lang} pageTitle={`${t(lang, titleKey)} · AgentNews`}>
<div class="page-head">
  <div class="crumbs">
    <a href={H('/')}>AgentNews</a><span>/</span><span>{t(lang, 'rank.crumb')}</span>
  </div>
  <span class="eyebrow">{t(lang, bucket === 'open' ? 'rank.eyebrowOpen' : 'rank.eyebrowClosed', { date })}</span>
  <h1 id="rank-title">{t(lang, titleKey)}</h1>
  <p class="lede">
    {t(lang, 'rank.lede')} <a href={H('/about/')}>{t(lang, 'rank.method')}</a>
  </p>
</div>

<RankBoard client:load rows={slim} meta={meta} bucket={bucket} form={form} g={g} lang={lang} />

{rows.length === 0 && (
  <div class="warn" style="margin-top:16px">
    {lang === 'en' ? 'No data yet. Run ' : '暂无数据：请先运行 '}<code>pnpm collect</code>.
  </div>
)}

<noscript>
  <div class="warn" style="margin-top:16px">
    {t(lang, 'rank.noscript')}
    <a href={H(rankUrl(bucket, 'all', g))}>{bucketLabel} {lang === 'en' ? 'board' : '榜'}</a>
    {lang === 'en' ? ' or ' : ' 或 '}
    <a href={H('/archive/')}>{t(lang, 'footer.archive')}</a>.
  </div>
</noscript>
</Base>