---
/**
 * Agent 图标：远程 logo + 首字母色块兜底。
 * - 远程图加载失败时整体降级为色块，不会出现碎图
 * - 色相由 slug 稳定哈希得出，同一 agent 永远同一颜色
 */
interface Props {
  slug: string;
  name?: string;
  icon?: string | null;
  iconFallback?: string | null;
  size?: number;
}

const { slug, name, icon, iconFallback, size = 32 } = Astro.props;
const label = (name ?? slug).trim();
const letter = [...label][0]?.toUpperCase() ?? '?';
const hue = [...slug].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
---

<span
  class="agent-icon"
  style={`--icon-size:${size}px;--icon-hue:${hue}`}
  title={label}
  aria-hidden="true"
>
  <span class="agent-icon-letter">{letter}</span>
  {icon && (
    <img
      src={icon}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
      data-fallback={iconFallback ?? ''}
      onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.dataset.fallback=''}else{this.remove()}"
    />
  )}
</span>
