{
  "name": "agentnews",
  "private": true,
  "packageManager": "pnpm@10.4.0",
  "scripts": {
    "collect": "pnpm --filter @agentnews/pipeline start",
    "validate": "pnpm --filter @agentnews/pipeline validate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @agentnews/web build",
    "discover": "pnpm --filter @agentnews/pipeline discover",
    "icons": "pnpm --filter @agentnews/pipeline icons",
    "icons:audit": "pnpm --filter @agentnews/pipeline icons:audit",
    "backfill": "pnpm --filter @agentnews/pipeline backfill"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
