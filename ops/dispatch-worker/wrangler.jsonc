{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentnews-dispatch",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // 每天 00:05 UTC = 北京 08:05，早上就能看到当天数据（原来 10:05 太晚）。
  // 不能更早：快照文件名与「今天是否已采过」的守卫都用 UTC 日期，
  // 排在 00:00Z 之前会被算成前一天，守卫会误判成「已采过」而不采集。
  // GitHub 自己的两个 cron（08:20 / 08:40）只是兜底。
  "triggers": {
    "crons": ["5 0 * * *"]
  },
  "vars": {
    "REPO": "pangxieju/AgentNews",
    "WORKFLOW": "daily.yml",
    "REF": "main"
  },
  "observability": {
    "enabled": true
  }
}
