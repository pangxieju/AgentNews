{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentnews-dispatch",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // 每天 UTC 17:00 = 北京时间次日 01:00 触发；采集→构建→部署一次跑完，02:00 前全部完成。
  // GitHub 自己的 01:30 cron（UTC 17:30）只是兜底。
  // 注意：快照与 deployed 标记现在一律用**北京时间**命名（run.ts 的 isoDate 已切 UTC+8），
  // 所以排在 UTC 17:00（北京时间 01:00）不会和前一天错位。
  "triggers": {
    "crons": ["0 17 * * *"]
  },
  "vars": {
    "REPO": "pangxieju/AgentNews",
    "WORKFLOW": "daily.yml",
    "REF": "main"
  },
  "observability": {
    "enabled": true
  }
}
